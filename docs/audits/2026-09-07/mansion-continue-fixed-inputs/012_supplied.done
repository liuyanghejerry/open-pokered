assert g.st()['screen']=='shop',g.st()
g.tap('a',8);g.step(30)
for item_index,quantity in [(1,10),(5,3),(4,4)]:
 for _ in range(item_index):g.tap('down',8)
 g.tap('a',8)
 for _ in range(quantity-1):g.tap('up',8)
 g.tap('a',8);g.tap('a',8);g.step(45)
g.tap('b',8);g.tap('b',8);g.cutscene();g.step(30)
snap('league-medicine-bought')
assert any(i['item']=='HyperPotion' and i['qty']==12 for i in g.d.cmd(cmd='get_bag')['data']),g.st()
g.nav_warp(3,7,'SaffronMart','SaffronCity',approach='down')
g.tap('start',8);g.tap('a',8)
for _ in range(2):g.tap('down',8)
g.tap('a',8);g.tap('a',8);g.tap('up',8);g.tap('a',8);g.cutscene();g.step(180);g.cutscene()
assert g.st()['map_name']=='ViridianCity',g.st()
g.tap('start',8);g.tap('a',8)
for _ in range(4):g.tap('down',8)
g.tap('a',8);g.tap('down',8);g.tap('down',8);g.tap('a',8)
for _ in range(4):g.tap('up',8)
g.tap('a',8);g.tap('b',8);g.tap('b',8);g.cutscene()
assert g.st()['party'][0]['species']=='Zapdos',g.st()
checkpoint('m93-league-supplied')
