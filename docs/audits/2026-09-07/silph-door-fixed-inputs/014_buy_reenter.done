assert g.st()['screen']=='shop',g.st()
g.tap('a',8);g.step(30)
# Hyper Potion index 1, quantity 3; Escape Rope index 3, quantity 1.
for item_index,quantity in [(1,3),(3,1)]:
 for _ in range(item_index):g.tap('down',8)
 g.tap('a',8)
 for _ in range(quantity-1):g.tap('up',8)
 g.tap('a',8);g.tap('a',8);g.step(45)
g.tap('b',8);g.tap('b',8);g.cutscene();g.step(30)
snap('saffron-bought-recovery')
assert any(i['item']=='HyperPotion' and i['qty']==3 for i in g.d.cmd(cmd='get_bag')['data']),g.st()
g.nav_warp(3,7,'SaffronMart','SaffronCity',approach='down')
checkpoint('m58-saffron-retry-supplied')
g.nav_warp(18,21,'SaffronCity','SilphCo1F');g.nav_warp(26,0,'SilphCo1F','SilphCo2F');g.nav_warp(26,0,'SilphCo2F','SilphCo3F')
g.nav_to(18,9,'SilphCo3F');g.face('left');g.tap('a',20);g.cutscene();g.step(40)
snap('silph-3f-reentry-door-blocked')
g.d.drive(['left']*24,frames=24);g.cutscene();g.step(40)
s=snap('silph-3f-reentry-door-still-blocked')
assert s['player_x']>=18,s
checkpoint('m58-silph-3f-return-blocked')
