g.cutscene();g.step(60)
checkpoint('m57-boardroom-before-fixed')
g.face('up');g.tap('a',20);g.cutscene();g.step(60)
snap('boardroom-unlocked-fixed')
assert g.d.cmd(cmd='get_flags')['data'].get('EVENT_SILPH_CO_11_UNLOCKED_DOOR'),g.st()
g.d.drive(['up']*8,frames=24);g.cutscene();g.step(60)
s=snap('giovanni-correct-party')
assert s['screen']=='battle',s
assert [(p['species'],p['level']) for p in s['battle_live']['enemy_party']]==[('Nidorino',37),('Kangaskhan',35),('Rhyhorn',37),('Nidoqueen',41)],s
assert g._await_phase('PlayerMenu',1000)
g.d.drive(['up','right'],frames=10);g.tap('a',4)
assert g._await_phase('PartySelect',120)
g.tap('down',8);g.tap('a',8);g.tap('a',8);g.step(30)
snap('giovanni-snorlax-switch')
g.battle_loop(prefer='fight');g.cutscene();g.step(60)
snap('giovanni-silph-result')
assert g.d.cmd(cmd='get_flags')['data'].get('EVENT_BEAT_SILPH_CO_GIOVANNI'),g.st()
checkpoint('m58-silph-giovanni')
