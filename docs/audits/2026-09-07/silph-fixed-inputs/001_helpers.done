def healing_battle(self,prefer='fight',max_iters=1000):
 fight=prefer=='fight';run_tries=0;seeded=set()
 for iteration in range(max_iters):
  state=self.st()
  if state['screen']!='battle':break
  phase=state['battle_phase']
  live=state.get('battle_live',{}).get('player',{})
  enemy=state.get('battle_live',{}).get('enemy',{})
  alive=next((i for i,p in enumerate(state.get('battle_live',{}).get('enemy_party',[])) if p['hp']>0),0)
  seedkey=(alive,enemy.get('species'))
  try_seed=live.get('species')=='Venusaur' and seedkey not in seeded
  if live.get('species')=='Snorlax':
   self.PREFERRED_MOVES=['Rest','Strength','IceBeam','Surf'] if live['hp']<live['max_hp']*.55 and live.get('status')=='None' else (['IceBeam','Surf','Strength'] if enemy.get('species') in ['Gastly','Haunter','Gengar','Fearow','Pidgeot','Pidgeotto','Spearow','Golbat'] else ['Strength','Surf','IceBeam'])
  else:self.PREFERRED_MOVES=['LeechSeed','MegaDrain','Cut'] if try_seed else ['MegaDrain','Cut']
  if not fight and 'Trainer' in phase:fight=True
  if phase=='PlayerMenu':
   live=state['battle_live']['player']
   counts={i['item']:i['qty'] for i in state['battle_inventory']}
   medicine='SuperPotion' if live['max_hp']-live['hp']>=35 and counts.get('SuperPotion',0) else 'Potion'
   qty=counts.get(medicine,0)
   cure=live.get('status') not in ['None',None] and not (live.get('species')=='Snorlax' and 'Sleep' in live.get('status','')) and counts.get('FullHeal',0)>0
   if cure:medicine='FullHeal';qty=counts[medicine]
   if fight and (live['hp']<live['max_hp']*.55 or cure) and qty:
    self.d.drive(['down','left'],frames=10);self.tap('a',4)
    assert self._await_phase('BagSelect',120)
    for _ in range(30):
     menu=self.st()['battle_bag'];target=next(i for i,v in enumerate(menu['items']) if v['item']==medicine)
     if menu['cursor']==target:break
     self.tap('down',4)
    self.tap('a',4);self.step(10)
    assert self.st()['battle_phase'].startswith('ItemTargetSelect'),self.st()
    if live['species']=='Snorlax':self.tap('down',8)
    self.tap('a',10);self.step(30)
    print(medicine,live['hp'],'/',live['max_hp'],'remaining before',qty,flush=True)
   elif fight:
    self.d.drive(['up','left'],frames=10);self.tap('a',4)
    if self._await_phase('MoveSelect',120):
     self._select_move()
     if try_seed:seeded.add(seedkey)
    self.step(30)
   else:
    self.d.drive(['down','right'],frames=10);self.tap('a',4);self.step(30)
    run_tries+=1
    if run_tries>3:fight=True
  elif phase=='MoveSelect':self._select_move();self.step(30)
  elif phase=='PlayerFaintSwitch':
   if live['species']=='Venusaur':self.tap('down',8)
   self.tap('a',10);self.step(30)
  elif phase=='ShiftPrompt':self.tap('b',8);self.step(30)
  else:self.tap('a',10)
 self.wait('not_battle',1800)
g.battle_loop=types.MethodType(healing_battle,g)

snap('koga-driver-ready')
