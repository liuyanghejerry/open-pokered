snap('saffron-gym-guard-cleared-fixed');assert not g.d.cmd(cmd='get_npcs')['data'][2]['visible'],g.st()
g.nav_warp(34,3,'SaffronCity','SaffronGym');checkpoint('m67-saffron-gym')
from navigation import bfs,warp_tiles,DELTA,walkable
def same_map_warp(sx,sy,dx,dy,name):
 s=g.st();blocked=g.live_npcs(name)|warp_tiles(name)
 options=[]
 for direction,(vx,vy) in DELTA.items():
  pos=(sx-vx,sy-vy)
  route=bfs(name,(s['player_x'],s['player_y']),pos,blocked)
  if route:options.append((len(route),pos,direction))
 assert options,(sx,sy,s)
 _,pos,direction=min(options)
 g.nav_to(*pos,name);g.d.drive([direction]*8,frames=16);g.step(90);g.cutscene()
 s=snap(f'gym-warp-{sx}-{sy}');assert (s['player_x'],s['player_y'])==(dx,dy),s
for edge in [(11,15,19,17),(15,15,19,3),(15,5,1,3),(1,5,11,11)]:same_map_warp(*edge,'SaffronGym')
g.nav_to(9,9,'SaffronGym');g.face('up');checkpoint('m68-sabrina-ready')
g.tap('a',20);g.cutscene();g.step(60);s=snap('sabrina-battle');assert s['screen']=='battle',s
g.battle_loop(prefer='fight');g.cutscene();g.step(60)
snap('sabrina-result');assert g.d.cmd(cmd='get_flags')['data'].get('EVENT_BEAT_SABRINA'),g.st()
checkpoint('m69-marsh-badge')
