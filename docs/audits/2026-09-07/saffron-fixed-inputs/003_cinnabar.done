def straight_to(x,y,map_name):
 for _ in range(160):
  s=g.st()
  assert s['map_name']==map_name,s
  if s['screen']=='battle':g.battle_loop(prefer='run');g.cutscene();continue
  if s['script_running'] or s['dialogue_state']:g.cutscene();continue
  if (s['player_x'],s['player_y'])==(x,y):return
  direction='right' if s['player_x']<x else 'left' if s['player_x']>x else 'down' if s['player_y']<y else 'up'
  g.d.drive([direction]*8,frames=16)
 raise NavError('straight navigation exhausted')
straight_to(7,17,'PalletTown');g.d.drive(['down']*16,frames=32);g.cutscene();g.step(40)
assert g.st()['map_name']=='Route21',g.st()
straight_to(7,15,'Route21');straight_to(2,15,'Route21');straight_to(2,89,'Route21')
g.d.drive(['down']*16,frames=32);g.cutscene();g.step(40)
assert g.st()['map_name']=='CinnabarIsland',g.st()
straight_to(2,4,'CinnabarIsland');straight_to(4,4,'CinnabarIsland')
checkpoint('m72-cinnabar-arrived')
g.heal_pokecenter((11,11),'CinnabarIsland','CinnabarPokecenter');g.cutscene();g.step(60)
checkpoint('m72-cinnabar-healed')
