assert g.d.cmd(cmd='get_flags')['data'].get('EVENT_BEAT_SILPH_CO_GIOVANNI'),g.st()
for _ in range(3):g.d.drive(['up']*8,frames=16)
g.cutscene();g.step(40);snap('boardroom-passed-through-stale-bars')
g.nav_to(7,6,'SilphCo11F');g.face('up');g.tap('a',20);g.cutscene();g.step(60)
snap('master-ball-received');assert any(i['item']=='MasterBall' for i in g.d.cmd(cmd='get_bag')['data']),g.st()
checkpoint('m59-master-ball')
g.tap('start',8);g.tap('down',8);g.tap('down',8);g.tap('a',8)
bag=g.d.cmd(cmd='get_bag')['data'];idx=next(i for i,v in enumerate(bag) if v['item']=='EscapeRope')
for _ in range(idx):g.tap('down',8)
g.tap('a',8);g.tap('a',8);g.cutscene();g.step(180);g.cutscene()
snap('silph-escape-rope');assert g.st()['map_name']=='SaffronCity',g.st()
checkpoint('m60-silph-liberated')
g.heal_pokecenter((9,29),'SaffronCity','SaffronPokecenter');g.cutscene();g.step(60)
checkpoint('m60-saffron-healed')
