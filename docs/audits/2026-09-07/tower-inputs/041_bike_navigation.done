base_drive=g.d.drive
def precise_drive(buttons,frames=None):
 buttons=list(buttons);s=g.st()
 if len(buttons)==8 and len(set(buttons))==1 and buttons[0] in ['up','down','left','right'] and frames==16:buttons=buttons[:4]
 if s['map_name']=='Route17' and s['screen']=='overworld' and frames is not None and frames>len(buttons):buttons+=['b']*(frames-len(buttons))
 return base_drive(buttons,frames)
g.d.drive=precise_drive
g.nav_to(8,0,'Route18');g.d.drive(['up']*8,frames=16)
assert g.st()['map_name']=='Route17',g.st()
snap('cycling-road-south-entry')
g.nav_to(8,0,'Route17');g.d.drive(['up']*8,frames=16);g.step(40)
assert g.st()['map_name']=='Route16',g.st()
checkpoint('m48-cycling-north')
