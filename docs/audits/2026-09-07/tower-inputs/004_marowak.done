g.nav_to(14,10,'PokemonTower6F');g.step(120);g.cutscene()
if g.st()['screen']=='battle':g.battle_loop(prefer='fight');g.cutscene()
g.nav_to(10,16,'PokemonTower6F');g.cutscene();g.step(60);g.cutscene();snap('marowak-ghost-battle')
assert g.st()['screen']=='battle',g.st()
g.battle_loop(prefer='fight');g.cutscene();g.step(60);snap('marowak-ghost-calmed')
assert g.d.cmd(cmd='get_flags')['data'].get('EVENT_BEAT_GHOST_MAROWAK')
g.nav_warp(9,16,'PokemonTower6F','PokemonTower7F');snap('tower-7f-entry')
checkpoint('m34-ghost-calmed')
