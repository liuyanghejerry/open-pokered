g.nav_warp(5,27,'FuchsiaCity','FuchsiaGym')
g.nav_to(4,11,'FuchsiaGym');g.cutscene();g.step(60)
if g.st()['screen']=='battle':g.battle_loop(prefer='fight');g.cutscene()
snap('koga-before-talk')
g.face('up');g.tap('a',20);g.cutscene();g.step(60)
snap('koga-battle-entered');assert g.st()['screen']=='battle',g.st()
g.battle_loop(prefer='fight');g.cutscene();g.step(60)
snap('koga-result');assert g.d.cmd(cmd='get_flags')['data'].get('EVENT_BEAT_KOGA'),g.st()
g.nav_warp(4,17,'FuchsiaGym','FuchsiaCity',approach='down')
g.heal_pokecenter((19,27),'FuchsiaCity','FuchsiaPokecenter')
checkpoint('m45-soul-badge')
