g.nav_to(34,10,'Route16');g.face('up');g.tap('start',12);g.tap('up',8);g.tap('a',12);g.tap('a',12);g.tap('a',12);g.cutscene();g.step(40)
snap('route16-cut-tree')
g.d.drive(['up']*16,frames=24);g.step(30);g.nav_to(34,8,'Route16')
g.nav_to(25,5,'Route16');g.d.drive(['left']*16,frames=24);g.step(40)
assert g.st()['map_name']=='Route16Gate1F',g.st()
g.nav_warp(0,3,'Route16Gate1F','Route16')
g.nav_warp(7,5,'Route16','Route16FlyHouse')
g.nav_to(2,4,'Route16FlyHouse');g.face('up');g.tap('a',20);g.cutscene();g.step(40)
snap('hm02-received');assert any(i['item']=='Hm02' for i in g.d.cmd(cmd='get_bag')['data']),g.st()
g.nav_warp(3,7,'Route16FlyHouse','Route16',approach='down')
checkpoint('m50-fly-hm')
