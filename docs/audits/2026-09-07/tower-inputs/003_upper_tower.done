g.nav_warp(3,9,'PokemonTower2F','PokemonTower3F');snap('tower-3f-entry')
g.nav_warp(18,9,'PokemonTower3F','PokemonTower4F');snap('tower-4f-entry')
g.nav_warp(3,9,'PokemonTower4F','PokemonTower5F');snap('tower-5f-entry')
g.nav_to(11,9,'PokemonTower5F');g.cutscene();g.step(60);snap('purified-zone-result')
