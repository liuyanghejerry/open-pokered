g.nav_warp(29,10,'SafariZoneCenter','SafariZoneEast')
snap('safari-east-entry')
g.nav_warp(0,4,'SafariZoneEast','SafariZoneNorth')
snap('safari-north-entry')
g.nav_warp(2,35,'SafariZoneNorth','SafariZoneWest',approach='down')
snap('safari-west-entry')
g.nav_warp(3,3,'SafariZoneWest','SafariZoneSecretHouse')
g.nav_to(3,4,'SafariZoneSecretHouse');g.face('up');g.tap('a',20);g.cutscene();g.step(40)
snap('safari-hm03-received')
assert any(i['item']=='Hm03' for i in g.d.cmd(cmd='get_bag')['data']),g.st()
