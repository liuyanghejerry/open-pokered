g.nav_warp(5,13,'FuchsiaCity','FuchsiaMart')
g.nav_to(2,3,'FuchsiaMart');g.face('up');g.tap('a',20);g.cutscene();g.step(30)
snap('fuchsia-shop-open');assert g.st()['screen']=='shop',g.st()
g.tap('a',12)
for idx,qty in [(2,20),(3,3),(4,5)]:
 for _ in range(idx):g.tap('down',8)
 g.tap('a',12)
 for _ in range(qty-1):g.tap('up',8)
 g.tap('a',12);g.tap('a',12);g.step(45)
 snap('fuchsia-purchase-'+str(idx))
g.tap('b',12);g.tap('b',12);g.cutscene();g.step(40)
assert g.st()['screen']=='overworld',g.st()
g.nav_warp(3,7,'FuchsiaMart','FuchsiaCity',approach='down')
checkpoint('m44-koga-supplies')
