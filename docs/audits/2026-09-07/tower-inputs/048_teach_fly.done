g.tap('start',12);g.tap('down',8);g.tap('a',12)
assert g.st()['screen']=='bag',g.st()
bag=g.d.cmd(cmd='get_bag')['data'];idx=next(i for i,v in enumerate(bag) if v['item']=='Hm02')
for _ in range(idx):g.tap('down',8)
g.tap('a',12);g.tap('a',12);g.tap('down',8);g.tap('down',8);g.tap('a',12);g.cutscene();g.step(40)
snap('doduo-fly-learned');assert 'Fly' in g.st()['party'][2]['moves'],g.st()
g.tap('start',12);g.tap('up',8);g.tap('a',12);g.tap('down',8);g.tap('down',8);g.tap('a',12);g.tap('a',12)
snap('fly-destination-menu')
for _ in range(8):g.tap('up',8)
snap('fly-saffron-selected')
