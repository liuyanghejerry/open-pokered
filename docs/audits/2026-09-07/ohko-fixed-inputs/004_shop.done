g.nav_warp(25,11,'SaffronCity','SaffronMart');g.nav_to(2,5,'SaffronMart');g.face('left');g.tap('a',12);g.cutscene()
assert g.st()['screen']=='shop',g.st()
g.tap('a',8);g.tap('down',8);g.tap('a',8)
for _ in range(6):g.tap('up',8)
g.tap('a',8);g.tap('a',8);g.step(45);snap('retry-hyper-potions-bought')
g.tap('b',8);g.tap('b',8);g.cutscene();g.step(60)
assert any(i['item']=='HyperPotion' and i['qty']==7 for i in g.d.cmd(cmd='get_bag')['data']),g.st()
g.nav_warp(3,7,'SaffronMart','SaffronCity',approach='down');g.cutscene()
checkpoint('m142-retry-hyper-potions')
