    "runner_source": "import sys,socket\nfrom pathlib import Path\nsys.path.insert(0,'/home/jerry/develop/open-pokered/scripts')\nimport playthrough as pt\nfrom debug_drive import DebugClient\npt.BIN=Path('/tmp/pokered-13-17')\noriginal_init=pt.Game.__init__\ndef init(self,*args,**kwargs):\n kwargs.setdefault('seed',0);kwargs.setdefault('speed',0)\n original_init(self,*args,**kwargs)\npt.Game.__init__=init\nimport json\n# Disable delayed ACK after flushing each request, so a response's trailing\n# newline does not wait for the server's Nagle timer.\ndef cmd(self,**kw):\n line=json.dumps(kw)+'\\n'\n for attempt in range(2):\n  try:\n   self.f.write(line);self.f.flush()\n   self.sock.setsockopt(socket.IPPROTO_TCP,socket.TCP_QUICKACK,1)\n   response=self.f.readline()\n   if not response:raise OSError('connection closed by peer')\n   return json.loads(response)\n  except OSError:\n   if attempt:raise\n   self._reconnect()\nDebugClient.cmd=cmd\ndef drive(self,buttons,frames=None):\n buttons=list(buttons)\n count=len(buttons) if frames is None else frames\n assert count>=len(buttons),(count,len(buttons))\n # Reproduce the legacy driven-only queue drain followed by its neutral step burst.\n total=len(buttons)+count\n result=self.cmd(cmd='press_timeline',buttons=buttons+[None]*count,advance=True)\n assert result['ok'],result\n assert result['data']['advanced'] and result['data']['frames']==total,result\n return result\nDebugClient.drive=drive\npt.main()\n",
