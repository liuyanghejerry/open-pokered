{
  "name": "Pokémon Red (dotzuki-engine)",
  "dataRoot": "crates/pokered-data",
  "gfxRoot": "gfx",
  "activities": [
    {
      "id": "story",
      "type": "story",
      "label": "Story",
      "icon": "book",
      "enabled": true,
      "config": {
        "storiesDir": "story",
        "scenesDir": "maps",
        "locales": ["en", "zh"],
        "flagSource": {
          "scan": { "dir": "maps", "fns": ["getFlag", "setFlag"], "recursive": true },
          "table": null
        },
        "ai": {
          "dslGuide": "docs/DSL_TRANSLATION_GUIDE.md",
          "apiTypes": "scripts/types/game.d.ts",
          "exampleScenes": [
            "crates/pokered-data/maps/OaksLab/script.scene",
            "crates/pokered-data/maps/Route10/script.scene"
          ]
        },
        "scene": {
          "ext": ".scene",
          "validateCmd": "target/debug/scene_apply {scene}"
        },
        "sprite": {
          "dir": "sprites",
          "size": "1024x1024"
        }
      }
    },
    {
      "id": "scenes",
      "type": "script",
      "label": "Scenes",
      "icon": "code",
      "enabled": true,
      "config": { "scriptsDir": "maps", "extension": ".scene" }
    },
    {
      "id": "maps",
      "type": "map",
      "label": "Maps",
      "icon": "map",
      "enabled": true,
      "config": { "mapsDir": "maps", "tileSize": 8, "blockSize": 4, "screen": { "width": 160, "height": 144 } }
    },
    {
      "id": "data",
      "type": "data",
      "label": "Game Data",
      "icon": "database",
      "enabled": true,
      "config": {
        "tables": [
          { "id": "pokemon", "label": "Pokémon", "dir": "pokemon", "idField": "species" },
          { "id": "moves", "label": "Moves", "dir": "moves", "idField": "id" },
          { "id": "trainers", "label": "Trainers", "dir": "trainers", "idField": "class" },
          { "id": "items", "label": "Items", "dir": "data/items", "idField": "id" }
        ]
      }
    },
    {
      "id": "settings",
      "type": "settings",
      "label": "Config",
      "icon": "settings",
      "enabled": true,
      "config": {}
    },
    {
      "id": "characters",
      "type": "character-sprite",
      "label": "Sprites",
      "icon": "👤",
      "enabled": true,
      "config": {}
    }
  ]
}
