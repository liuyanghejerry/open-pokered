        },
        {
          "line1": "collection!",
          "line2": ""
        },
        {
          "line1": "The more you have,",
          "line2": "the easier it is"
        },
        {
          "line1": "to fight!",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "TRAINER TIPS",
          "line2": ""
        },
        {
          "line1": "The battle moves",
          "line2": "of POKeMON are"
        },
        {
          "line1": "limited by their",
          "line2": "POWER POINTs, PP."
        },
        {
          "line1": "To replenish PP,",
          "line2": "rest your tired"
        },
        {
          "line1": "POKeMON at a",
          "line2": "POKeMON CENTER!"
        }
