  "text": {
    "npc": {
      "1": [
        {
          "line1": "Those POKe BALLs",
          "line2": "at your waist!"
        },
        {
          "line1": "You have POKeMON!",
          "line2": ""
        },
        {
          "line1": "It's great that",
          "line2": "you can carry and"
        },
        {
          "line1": "use POKeMON any",
          "line2": "time, anywhere!"
        }
      ],
      "2": [
        {
          "line1": "This POKeMON GYM",
          "line2": "is always closed."
        },
        {
          "line1": "I wonder who the",
          "line2": "LEADER is?"
        }
      ],
      "2_GymLeaderReturned": [
        {
          "line1": "VIRIDIAN GYM's",
          "line2": "LEADER returned!"
        }
      ],
      "3": [
        {
          "line1": "You want to know",
          "line2": "about the 2 kinds"
        },
        {
          "line1": "of caterpillar",
          "line2": "POKeMON?"
        }
      ],
      "3_Yes": [
        {
          "line1": "CATERPIE has no",
          "line2": "poison, but"
        },
        {
          "line1": "WEEDLE does.",
          "line2": ""
        },
        {
          "line1": "Watch out for its",
          "line2": "POISON STING!"
        }
      ],
      "3_No": [
        {
          "line1": "Oh, OK then!",
          "line2": ""
        }
      ],
      "4_NoPokedex": [
        {
          "line1": "Oh Grandpa! Don't",
          "line2": "be so mean!"
        },
        {
          "line1": "He hasn't had his",
          "line2": "coffee yet."
        }
      ],
      "4_HasPokedex": [
        {
          "line1": "When I go shop in",
          "line2": "PEWTER CITY, I"
        },
        {
          "line1": "have to take the",
          "line2": "winding trail in"
        },
        {
          "line1": "VIRIDIAN FOREST.",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "You can't go",
          "line2": "through here!"
        },
        {
          "line1": "This is private",
          "line2": "property!"
        }
      ],
      "6": [
        {
          "line1": "Yawn!",
          "line2": "I must have dozed"
        },
        {
          "line1": "off in the sun.",
          "line2": ""
        },
        {
          "line1": "I had this dream",
          "line2": "about a DROWZEE"
        },
        {
          "line1": "eating my dream.",
          "line2": "What's this?"
        },
        {
          "line1": "Where did this TM",
          "line2": "come from?"
        },
        {
          "line1": "This is spooky!",
          "line2": "Here, you can"
        },
        {
          "line1": "have this TM.",
          "line2": ""
        }
      ],
      "6_ReceivedTM42": [
        {
          "line1": "<PLAYER> received",
          "line2": "TM42!"
        }
      ],
      "6_TM42Explanation": [
        {
          "line1": "TM42 contains",
          "line2": "DREAM EATER..."
        },
        {
          "line1": "...Snore...",
          "line2": ""
        }
      ],
      "6_NoRoom": [
        {
          "line1": "You have too much",
          "line2": "stuff already."
        }
      ],
      "7_HadCoffeeNo": [
        {
          "line1": "Ahh, I've had my",
          "line2": "coffee now and I"
        },
        {
          "line1": "feel great!",
          "line2": ""
        },
        {
          "line1": "Sure you can go",
          "line2": "through!"
        },
        {
          "line1": "Are you in a",
          "line2": "hurry?"
        }
      ],
      "7_HadCoffeeYes": [
        {
          "line1": "Time is money...",
          "line2": "Go along then."
        }
      ],
      "7_HadCoffeeNoCatchTutorial": [
        {
          "line1": "I see you're using",
          "line2": "a POKeDEX."
        },
        {
          "line1": "When you catch a",
          "line2": "POKeMON, POKeDEX"
        },
        {
          "line1": "is automatically",
          "line2": "updated."
        },
        {
          "line1": "What? Don't you",
          "line2": "know how to catch"
        },
        {
          "line1": "POKeMON?",
          "line2": ""
        },
        {
          "line1": "I'll show you",
          "line2": "how to then."
        }
      ],
      "script_WeakenTarget": [
        {
          "line1": "First, you need",
          "line2": "to weaken the"
        },
        {
          "line1": "target POKeMON.",
          "line2": ""
        }
      ],
      "script_GymLocked": [
        {
          "line1": "The GYM's doors",
          "line2": "are locked..."
        }
      ]
    },
    "sign": {
      "1": [
        {
          "line1": "VIRIDIAN CITY",
