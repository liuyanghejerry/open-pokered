  "text": {
    "npc": {
      "1": [
        {
          "line1": "Hi! I work at a",
          "line2": "POKeMON MART."
        },
        {
          "line1": "It's a convenient",
          "line2": "shop, so please"
        },
        {
          "line1": "visit us in",
          "line2": "VIRIDIAN CITY."
        },
        {
          "line1": "I know, I'll give",
          "line2": "you a sample!"
        },
        {
          "line1": "Here you go!",
          "line2": ""
        }
      ],
      "1_GotPotion": [
        {
          "line1": "<PLAYER> got",
          "line2": "a POTION!"
        }
      ],
      "1_AlsoGotPokeballs": [
        {
          "line1": "We also carry",
          "line2": "POKe BALLs for"
        },
        {
          "line1": "catching POKeMON!",
          "line2": ""
        }
      ],
      "1_NoRoom": [
        {
          "line1": "You have too much",
          "line2": "stuff with you!"
        }
      ],
      "2": [
        {
          "line1": "See those ledges",
          "line2": "along the road?"
        },
        {
          "line1": "It's a bit scary,",
          "line2": "but you can jump"
        },
        {
          "line1": "from them.",
          "line2": ""
        },
        {
          "line1": "You can get back",
          "line2": "to PALLET TOWN"
        },
        {
          "line1": "quicker that way.",
          "line2": ""
        }
      ]
    },
