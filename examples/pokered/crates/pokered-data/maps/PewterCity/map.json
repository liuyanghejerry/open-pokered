  "text": {
    "npc": {
      "1": [
        {
          "line1": "It's rumored that",
          "line2": "CLEFAIRYs came"
        },
        {
          "line1": "from the moon!",
          "line2": ""
        },
        {
          "line1": "They appeared ",
          "line2": "after MOON STONE"
        },
        {
          "line1": "fell on MT.MOON.",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "There aren't many",
          "line2": "serious #MON"
        },
        {
          "line1": "trainers here!",
          "line2": ""
        },
        {
          "line1": "They're all like",
          "line2": "BUG CATCHERs,"
        },
        {
          "line1": "but PEWTER GYM's",
          "line2": "BROCK is totally"
        },
        {
          "line1": "into it!",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "Did you check out",
          "line2": "the MUSEUM?"
        }
      ],
      "3_Yes": [
        {
          "line1": "Weren't those",
          "line2": "fossils from MT."
        },
        {
          "line1": "MOON amazing?",
          "line2": ""
        }
      ],
      "3_No": [
        {
          "line1": "Really?",
          "line2": "You absolutely"
        },
        {
          "line1": "have to go!",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "Psssst!",
          "line2": "Do you know what"
        },
        {
          "line1": "I'm doing?",
          "line2": ""
        }
      ],
      "4_Yes": [
        {
          "line1": "That's right!",
          "line2": "It's hard work!"
        }
      ],
      "4_No": [
        {
          "line1": "I'm spraying REPEL",
          "line2": "to keep #MON"
        },
        {
          "line1": "out of my garden!",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "You're a trainer",
          "line2": "right? BROCK's"
        },
        {
          "line1": "looking for new",
          "line2": "challengers!"
        },
        {
          "line1": "Follow me!",
          "line2": ""
        }
      ],
      "script_SuperNerd1MuseumArrival": [
        {
          "line1": "It's right here!",
          "line2": "You have to pay"
        },
        {
          "line1": "to get in, but",
          "line2": "it's worth it!"
        },
        {
          "line1": "See you around!",
          "line2": ""
        }
      ],
      "script_YoungsterGymArrival": [
        {
          "line1": "If you have the",
          "line2": "right stuff, go"
        },
        {
          "line1": "take on BROCK!",
          "line2": ""
        }
      ]
    },
    "sign": {
      "1": [
        {
          "line1": "TRAINER TIPS",
          "line2": ""
        },
        {
          "line1": "Any #MON that",
          "line2": "takes part in"
        },
        {
          "line1": "battle, however",
          "line2": "short, earns EXP!"
        }
      ],
      "2": [
        {
          "line1": "NOTICE!",
          "line2": ""
        },
        {
          "line1": "Thieves have been",
          "line2": "stealing #MON"
        },
        {
          "line1": "fossils at MT.",
          "line2": "MOON! Please call"
        },
        {
          "line1": "PEWTER POLICE",
          "line2": "with any info!"
        }
      ],
      "3": [
        {
          "line1": "All your item",
          "line2": "needs fulfilled!"
        },
        {
          "line1": "#MON MART",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "Heal Your #MON!",
          "line2": "#MON CENTER"
        }
      ],
      "5": [
        {
          "line1": "PEWTER MUSEUM",
          "line2": "OF SCIENCE"
        }
      ],
      "6": [
        {
          "line1": "PEWTER CITY",
          "line2": "#MON GYM"
        },
        {
          "line1": "LEADER: BROCK",
          "line2": ""
        },
        {
          "line1": "The Rock Solid",
          "line2": "#MON Trainer!"
        }
      ],
