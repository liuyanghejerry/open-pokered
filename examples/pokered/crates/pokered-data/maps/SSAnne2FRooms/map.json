  "text": {
    "npc": {
      "1": [
        {
          "line1": "Competing against",
          "line2": "the young keeps"
        },
        {
          "line1": "me youthful.",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "Good",
          "line2": "fight! Ah, I feel"
        },
        {
          "line1": "young again!",
          "line2": ""
        }
      ],
      "1_AfterBattle": [
        {
          "line1": "15 years ago, I",
          "line2": "would have won!"
        }
      ],
      "2": [
        {
          "line1": "Check out what I",
          "line2": "fished up!"
        }
      ],
      "2_Defeated": [
        {
          "line1": "I'm",
          "line2": "all out!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "Party?",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "The cruise ship's",
          "line2": "party should be"
        },
        {
          "line1": "over by now.",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "Which do you like,",
          "line2": "a strong or a"
        },
        {
          "line1": "rare #MON?",
          "line2": ""
        }
      ],
      "3_Defeated": [
        {
          "line1": "I must",
          "line2": "salute you!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "I prefer strong",
          "line2": "and rare #MON."
        }
      ],
      "4": [
        {
          "line1": "I never saw you",
          "line2": "at the party."
        }
      ],
      "4_Defeated": [
        {
          "line1": "Take",
          "line2": "it easy!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "Oh, I adore your",
          "line2": "strong #MON!"
        }
      ],
      "5": [
        {
          "line1": "In all my travels",
          "line2": "I've never seen"
        },
        {
          "line1": "any #MON sleep",
          "line2": "like this one!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "It was something",
          "line2": "like this!"
        }
      ],
      "7": [
        {
          "line1": "Have you gone to",
          "line2": "the SAFARI ZONE"
        },
        {
          "line1": "in FUCHSIA CITY?",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "It had many rare",
          "line2": "kinds of #MON!!"
        }
      ],
      "8": [
        {
          "line1": "#MON can CUT",
          "line2": "down small bushes."
        }
      ],
      "10": [
        {
          "line1": "Ah yes, I have",
          "line2": "seen some #MON"
        },
        {
          "line1": "ferry people",
          "line2": "across the water!"
        }
      ],
      "11": [
        {
          "line1": "Me and my Daddy",
          "line2": "think the SAFARI"
        },
        {
          "line1": "ZONE is awesome!",
          "line2": ""
        }
      ],
      "12": [
        {
          "line1": "The CAPTAIN looked",
          "line2": "really sick and"
        },
        {
          "line1": "pale!",
          "line2": ""
        }
      ],
      "13": [
        {
          "line1": "I hear many people",
          "line2": "get seasick!"
        }
      ]
    }
  },
