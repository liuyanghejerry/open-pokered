  "text": {
    "npc": {
      "1": [
        {
          "line1": "We're careful",
          "line2": "about pollution!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "We've heard GRIMER",
          "line2": "multiplies in"
        },
        {
          "line1": "toxic sludge!",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "Did you see S.S.",
          "line2": "ANNE moored in"
        },
        {
          "line1": "the harbor?",
          "line2": ""
        }
      ],
      "2_ShipDeparted": [
        {
          "line1": "So, S.S.ANNE has",
          "line2": "departed!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "She'll be back in",
          "line2": "about a year."
        }
      ],
      "3": [
        {
          "line1": "Welcome to S.S.",
          "line2": "ANNE!"
        }
      ],
      "3_ShipDeparted": [
        {
          "line1": "The ship set sail.",
          "line2": ""
        }
      ],
      "3_TicketCheck": [
        {
          "line1": "Welcome to S.S.",
          "line2": "ANNE!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Excuse me, do you",
          "line2": "have a ticket?"
        }
      ],
      "3_HasTicket": [
        {
          "line1": "<PLAYER> flashed",
          "line2": "the S.S.TICKET!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Great! Welcome to",
          "line2": "S.S.ANNE!"
        }
      ],
      "3_NoTicket": [
        {
          "line1": "<PLAYER> doesn't",
          "line2": "have the needed"
        },
        {
          "line1": "S.S.TICKET.",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Sorry!",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "You need a ticket",
          "line2": "to get aboard."
        }
