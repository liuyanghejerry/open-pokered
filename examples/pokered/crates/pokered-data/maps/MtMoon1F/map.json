  "text": {
    "npc": {
      "1": [
        {
          "line1": "WHOA! You shocked",
          "line2": "me! Oh, you're"
        },
        {
          "line1": "just a kid!",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "Wow!",
          "line2": "Shocked again!"
        }
      ],
      "1_AfterBattle": [
        {
          "line1": "Kids like you",
          "line2": "shouldn't be"
        },
        {
          "line1": "here!",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "Did you come to",
          "line2": "explore too?"
        }
      ],
      "2_Defeated": [
        {
          "line1": "Losing",
          "line2": "stinks!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "I came down here",
          "line2": "to show off to"
        },
        {
          "line1": "girls.",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "Wow! It's way",
          "line2": "bigger in here"
        },
        {
          "line1": "than I thought!",
          "line2": ""
        }
      ],
      "3_Defeated": [
        {
          "line1": "Oh!",
          "line2": "I lost it!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "How do you get",
          "line2": "out of here?"
        }
      ],
      "4": [
        {
          "line1": "What! Don't sneak",
          "line2": "up on me!"
        }
      ],
      "4_Defeated": [
        {
          "line1": "My",
          "line2": "#MON won't do!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "I have to find",
          "line2": "stronger #MON."
        }
      ],
      "5": [
        {
          "line1": "What? I'm waiting",
          "line2": "for my friends to"
        },
        {
          "line1": "find me here.",
          "line2": ""
        }
      ],
      "5_Defeated": [
        {
          "line1": "I lost?",
          "line2": ""
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "I heard there are",
          "line2": "some very rare"
        },
        {
          "line1": "fossils here.",
          "line2": ""
        }
      ],
      "6": [
        {
          "line1": "Suspicious men",
          "line2": "are in the cave."
        },
        {
          "line1": "What about you?",
          "line2": ""
        }
      ],
      "6_Defeated": [
        {
          "line1": "You",
          "line2": "got me!"
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "I saw them! I'm",
          "line2": "sure they're from"
        },
        {
          "line1": "TEAM ROCKET!",
          "line2": ""
        }
      ],
      "7": [
        {
          "line1": "Go through this",
          "line2": "cave to get to"
        },
        {
          "line1": "CERULEAN CITY!",
          "line2": ""
        }
      ],
      "7_Defeated": [
        {
          "line1": "I",
          "line2": "lost."
        }
      ],
      "7_AfterBattle": [
        {
          "line1": "ZUBAT is tough!",
          "line2": "But, it can be"
        },
        {
          "line1": "useful if you",
          "line2": "catch one."
        }
      ]
    },
    "sign": {
      "1": [
        {
          "line1": "Beware! ZUBAT is",
          "line2": "a blood sucker!"
        }
      ]
    }
  },
