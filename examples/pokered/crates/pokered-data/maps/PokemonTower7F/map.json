  "text": {
    "npc": {
      "1": [
        {
          "line1": "MR.FUJI: Heh? You",
          "line2": "came to save me?"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Thank you. But, I",
          "line2": "came here of my"
        },
        {
          "line1": "own free will.",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "I came to calm",
          "line2": "the soul of"
        },
        {
          "line1": "CUBONE's mother.",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "I think MAROWAK's",
          "line2": "spirit has gone"
        },
        {
          "line1": "to the afterlife.",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "I must thank you",
          "line2": "for your kind"
        },
        {
          "line1": "concern!",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Follow me to my",
          "line2": "home, #MON"
        },
        {
          "line1": "HOUSE at the foot",
          "line2": "of this tower."
        }
      ],
      "2": [
        {
          "line1": "What do you want?",
          "line2": "Why are you here?"
        }
      ],
      "2_Defeated": [
        {
          "line1": "I give up!",
          "line2": ""
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "I'm not going to",
          "line2": "forget this!"
        }
      ],
      "3": [
        {
          "line1": "This old guy came",
          "line2": "and complained"
        },
        {
          "line1": "about us harming",
          "line2": "useless #MON!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "We're talking it",
          "line2": "over as adults!"
        }
      ],
      "3_Defeated": [
        {
          "line1": "Please!",
          "line2": "No more!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "#MON are only",
          "line2": "good for making"
        },
        {
          "line1": "money!",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Stay out of our",
          "line2": "business!"
        }
      ],
      "4": [
        {
          "line1": "You're not saving",
          "line2": "anyone, kid!"
        }
      ],
      "4_Defeated": [
        {
          "line1": "Don't",
          "line2": "fight us ROCKETs!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "You're not getting",
          "line2": "away with this!"
        }
      ]
    }
  },
