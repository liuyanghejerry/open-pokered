  "text": {
    "npc": {
      "1": [
        {
          "line1": "Hey, stop!",
          "line2": ""
        },
        {
          "line1": "I found these",
          "line2": "fossils! They're"
        },
        {
          "line1": "both mine!",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "OK!",
          "line2": "I'll share!"
        }
      ],
      "1_EachTakeOne": [
        {
          "line1": "We'll each take",
          "line2": "one!"
        },
        {
          "line1": "No being greedy!",
          "line2": ""
        }
      ],
      "1_GotFossil": [
        {
          "line1": "Far away, on",
          "line2": "CINNABAR ISLAND,"
        },
        {
          "line1": "there's a #MON",
          "line2": "LAB."
        },
        {
          "line1": "They do research",
          "line2": "on regenerating"
        },
        {
          "line1": "fossils.",
          "line2": ""
        }
      ],
      "script_SuperNerdTakesOtherFossil": [
        {
          "line1": "All right. Then",
          "line2": "this is mine!"
        }
      ],
      "2": [
        {
          "line1": "TEAM ROCKET will",
          "line2": "find the fossils,"
        },
        {
          "line1": "revive and sell",
          "line2": "them for cash!"
        }
      ],
      "2_Defeated": [
        {
          "line1": "Urgh!",
          "line2": "Now I'm mad!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "You made me mad!",
          "line2": "TEAM ROCKET will"
        },
        {
          "line1": "blacklist you!",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "We, TEAM ROCKET,",
          "line2": "are #MON"
        },
        {
          "line1": "gangsters!",
          "line2": ""
        }
      ],
      "3_Defeated": [
        {
          "line1": "I blew",
          "line2": "it!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "Darn it all! My",
          "line2": "associates won't"
        },
        {
          "line1": "stand for this!",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "We're pulling a",
          "line2": "big job here!"
        },
        {
          "line1": "Get lost, kid!",
          "line2": ""
        }
      ],
      "4_Defeated": [
        {
          "line1": "So, you",
          "line2": "are good."
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "If you find a",
          "line2": "fossil, give it"
        },
        {
          "line1": "to me and scram!",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "Little kids",
          "line2": "should leave"
        },
        {
          "line1": "grown-ups alone!",
          "line2": ""
        }
      ],
      "5_Defeated": [
        {
          "line1": "I'm",
          "line2": "steamed!"
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "#MON lived",
          "line2": "here long before"
        },
        {
          "line1": "people came.",
          "line2": ""
        }
      ],
      "6": [
        {
          "line1": "You want the",
          "line2": "DOME FOSSIL?"
        }
      ],
      "6_Received": [
        {
          "line1": "<PLAYER> got the",
          "line2": "DOME FOSSIL!"
        }
      ],
      "6_NoRoom": [
        {
          "line1": "Look, you've got",
          "line2": "no room for this."
        }
      ],
      "7": [
        {
          "line1": "You want the",
