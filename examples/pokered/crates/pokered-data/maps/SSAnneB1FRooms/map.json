  "text": {
    "npc": {
      "1": [
        {
          "line1": "You know what they",
          "line2": "say about sailors"
        },
        {
          "line1": "and fighting!",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "Right!",
          "line2": "Good fight, mate!"
        }
      ],
      "1_AfterBattle": [
        {
          "line1": "Haha! Want to be",
          "line2": "a sailor, mate?"
        }
      ],
      "2": [
        {
          "line1": "My sailor's pride",
          "line2": "is at stake!"
        }
      ],
      "2_Defeated": [
        {
          "line1": "Your",
          "line2": "spirit sank me!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "Did you see the",
          "line2": "FISHING GURU in"
        },
        {
          "line1": "VERMILION CITY?",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "Us sailors have",
          "line2": "#MON too!"
        }
      ],
      "3_Defeated": [
        {
          "line1": "OK,",
          "line2": "you're not bad."
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "We caught all our",
          "line2": "#MON while"
        },
        {
          "line1": "out at sea!",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "I like feisty",
          "line2": "kids like you!"
        }
      ],
      "4_Defeated": [
        {
          "line1": "Argh!",
          "line2": "Lost it!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "Sea #MON live",
          "line2": "in deep water."
        },
        {
          "line1": "You'll need a ROD!",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "Matey, you're",
          "line2": "walking the plank"
        },
        {
          "line1": "if you lose!",
          "line2": ""
        }
      ],
      "5_Defeated": [
        {
          "line1": "Argh!",
          "line2": "Beaten by a kid!"
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "Jellyfish some-",
          "line2": "times drift into"
        },
        {
          "line1": "the ship.",
          "line2": ""
        }
      ],
      "6": [
        {
          "line1": "Hello stranger!",
          "line2": "Stop and chat!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "All my #MON",
          "line2": "are from the sea!"
        }
      ],
      "6_Defeated": [
        {
          "line1": "Darn!",
          "line2": "I let that one"
        },
        {
          "line1": "get away!",
          "line2": ""
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "I was going to",
          "line2": "make you my"
        },
        {
          "line1": "assistant too!",
          "line2": ""
        }
      ],
      "7": [
        {
          "line1": "My buddy, MACHOKE,",
          "line2": "is super strong!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "He has enough",
          "line2": "STRENGTH to move"
        },
        {
          "line1": "big rocks!",
          "line2": ""
        }
      ],
      "8": [
        {
          "line1": "MACHOKE: Gwoh!",
          "line2": "Goggoh!"
        }
      ]
    }
