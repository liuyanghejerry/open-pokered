// Route21 — translated from the original disassembly (scripts/Route21.asm,
// text/Route21.asm) to the real Game DSL API surface. Route21 is a water/grass
// route with 9 sight-engaged trainers (4 Fishers + 5 Swimmers). All are
// runtime-driven sight battles, so each .scene handler is DIALOGUE ONLY:
// beaten -> after-battle text, otherwise -> the pre-battle taunt. No warps,
// signs, or on-enter cutscene exist in the original.

game_scene Route21 {
  // ── Fisher (npc 1) — TrainerHeader0 / EVENT_BEAT_ROUTE_21_TRAINER_0 ──────
  @storyline("talkFisher1") {
    @trigger(map = "Route21", npc = 1)
    @if (getFlag("EVENT_BEAT_ROUTE_21_TRAINER_0")) {
      @speaker("") { @t("I can't catch anything good!", "我抓不到什么好东西！") }
    } @else {
      @speaker("") { @t("You want to know if the fish\nare biting?", "你想知道鱼上钩了没有吗？") }
    }
  }

  // ── Fisher (npc 2) — TrainerHeader1 / EVENT_BEAT_ROUTE_21_TRAINER_1 ──────
  @storyline("talkFisher2") {
    @trigger(map = "Route21", npc = 2)
    @if (getFlag("EVENT_BEAT_ROUTE_21_TRAINER_1")) {
      @speaker("") { @t("I seem to only catch\nMAGIKARP!", "我好像只会钓到鲤鱼王！") }
    } @else {
      @speaker("") { @t("I got a big haul! Wanna go\nfor it?", "我收获可大了！要不要来一场？") }
    }
  }

  // ── Swimmer (npc 3) — TrainerHeader2 / EVENT_BEAT_ROUTE_21_TRAINER_2 ─────
  @storyline("talkSwimmer1") {
    @trigger(map = "Route21", npc = 3)
    @if (getFlag("EVENT_BEAT_ROUTE_21_TRAINER_2")) {
      @speaker("") { @t("I like the mountains too!", "我也喜欢高山！") }
    } @else {
      @speaker("") { @t("The sea cleanses my body and\nsoul!", "大海能洗涤我的身心！") }
    }
  }

  // ── Swimmer (npc 4) — TrainerHeader3 / EVENT_BEAT_ROUTE_21_TRAINER_3 ─────
  @storyline("talkSwimmer2") {
    @trigger(map = "Route21", npc = 4)
    @if (getFlag("EVENT_BEAT_ROUTE_21_TRAINER_3")) {
      @speaker("") { @t("I look like what? A studded\ninner tube? Get lost!", "我像什么？带钉子的救生圈？快\n走开！") }
    } @else {
      @speaker("") { @t("What's wrong with me\nswimming?", "我在游泳有什么问题吗？") }
    }
  }

  // ── Swimmer (npc 5) — TrainerHeader4 / EVENT_BEAT_ROUTE_21_TRAINER_4 ─────
  @storyline("talkSwimmer3") {
    @trigger(map = "Route21", npc = 5)
    @if (getFlag("EVENT_BEAT_ROUTE_21_TRAINER_4")) {
      @speaker("") { @t("Where'd you catch your\nPOKeMON?", "你的宝可梦是在哪里捉到的？") }
    } @else {
      @speaker("") { @t("I caught all my POKeMON at\nsea!", "我的宝可梦全是在海里捉的！") }
    }
  }

  // ── Swimmer (npc 6) — TrainerHeader5 / EVENT_BEAT_ROUTE_21_TRAINER_5 ─────
  @storyline("talkSwimmer4") {
    @trigger(map = "Route21", npc = 6)
    @if (getFlag("EVENT_BEAT_ROUTE_21_TRAINER_5")) {
      @speaker("") { @t("I'm beat! But, I still have\nthe bike race and marathon\nleft!", "我累坏了！但我还要参加自行车\n赛和马拉松！") }
    } @else {
      @speaker("") { @t("Right now, I'm in a\ntriathlon meet!", "我现在正参加铁人三项赛呢！") }
    }
  }

  // ── Swimmer (npc 7) — TrainerHeader6 / EVENT_BEAT_ROUTE_21_TRAINER_6 ─────
  @storyline("talkSwimmer5") {
    @trigger(map = "Route21", npc = 7)
    @if (getFlag("EVENT_BEAT_ROUTE_21_TRAINER_6")) {
      @speaker("") { @t("I'm sunburnt to a crisp!", "我都被晒成黑炭了！") }
    } @else {
      @speaker("") { @t("Ahh! Feel the sun and the\nwind!", "啊！感受阳光和清风！") }
    }
  }

  // ── Fisher (npc 8) — TrainerHeader7 / EVENT_BEAT_ROUTE_21_TRAINER_7 ──────
  @storyline("talkFisher3") {
    @trigger(map = "Route21", npc = 8)
    @if (getFlag("EVENT_BEAT_ROUTE_21_TRAINER_7")) {
      @speaker("") { @t("I was just angry that I\ncouldn't catch anything.", "我刚才只是在气自己什么都钓不\n到。") }
    } @else {
      @speaker("") { @t("Hey, don't scare away the\nfish!", "喂，别把鱼吓跑了！") }
    }
  }

  // ── Fisher (npc 9) — TrainerHeader8 / EVENT_BEAT_ROUTE_21_TRAINER_8 ──────
  @storyline("talkFisher4") {
    @trigger(map = "Route21", npc = 9)
    @if (getFlag("EVENT_BEAT_ROUTE_21_TRAINER_8")) {
      @speaker("") { @t("Oh wait! I got a bite! Yeah!", "啊等等！有鱼上钩了！耶！") }
    } @else {
      @speaker("") { @t("Keep me company 'til I get a\nhit!", "在我钓到鱼之前陪我聊聊天吧！") }
    }
  }
}
