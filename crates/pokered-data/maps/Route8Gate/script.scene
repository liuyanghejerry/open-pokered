// Route8Gate — translated from the original disassembly (scripts/Route8Gate.asm,
// text/SaffronGates.asm) to the real Game DSL API surface. This is a Saffron-City
// gate guard: the road to Saffron is blocked until the player hands over a drink
// (FRESH_WATER / SODA_POP / LEMONADE). The block is driven by an on-enter coord
// cutscene at the gate row, plus the guard's talk handler.
//
// EVENT_GAVE_SAFFRON_GUARDS_DRINK mirrors the original BIT_GAVE_SAFFRON_GUARDS_DRINK
// status bit (shared across all Saffron gates).

game_scene Route8Gate {
  // ── Guard (npc 1) — talk handler ───────────────────────────────────────
  @storyline("talkGuard") {
    @trigger(map = "Route8Gate", npc = 1)
    @if (getFlag("EVENT_GAVE_SAFFRON_GUARDS_DRINK")) {
      // Already bribed: SaffronGateGuardThanksForTheDrinkText.
      @speaker("") { @t("Hi, thanks for the cool\ndrinks!", "嗨，谢谢你的冰爽饮料！") }
    } @else {
      // Road still closed: SaffronGateGuardGeeImThirstyText.
      @speaker("") {
        @t("I'm on guard duty. Gee, I'm\nthirsty, though!\n\nOh wait there, the road's\nclosed.", "我在执勤。哎呀，我好渴啊！\n\n啊，等等，这条路禁止通行。")
      }
    }
  }

  // ── Gate-blocking cutscene at the Saffron exit row (coords 2,3 / 2,4) ───
  // Original: Route8GateDefaultScript fires when the player steps onto the
  // gate tiles while EVENT_GAVE_SAFFRON_GUARDS_DRINK is unset. If the player is
  // carrying a guard drink it is taken and the road opens; otherwise the guard
  // turns the player back (scripted PAD_RIGHT shove).
  @storyline("gateBlock") {
    @trigger(map = "Route8Gate", name = "gateBlock1")
    @if (!getFlag("EVENT_GAVE_SAFFRON_GUARDS_DRINK")) {
      @if (hasItem("FRESH_WATER")) {
        takeItem("FRESH_WATER", 1)
        setFlag("EVENT_GAVE_SAFFRON_GUARDS_DRINK")
        // SaffronGateGuardGiveDrinkText (ImParched -> get-item jingle -> GoOnThrough).
        @speaker("") {
          @t("Whoa, boy! I'm parched! ...\nHuh? I can have this drink?\nGee, thanks!", "哇，小伙子！我渴坏了！……\n嗯？这个饮料可以给我？哦，谢\n谢！")
        }
        playSound("SFX_GET_KEY_ITEM")
        @speaker("") {
          @t("... Glug glug... ... Gulp...\nIf you want to go to SAFFRON\nCITY... ... You can go on\nthrough. I'll share this\nwith the other guards!", "……咕嘟咕嘟…………咕噜……\n如果你想去金黄市…………那就\n过去吧。我会和其他守卫一起享\n用的！")
        }
      } @else {
        @if (hasItem("SODA_POP")) {
          takeItem("SODA_POP", 1)
          setFlag("EVENT_GAVE_SAFFRON_GUARDS_DRINK")
          @speaker("") {
            @t("Whoa, boy! I'm parched! ...\nHuh? I can have this drink?\nGee, thanks!", "哇，小伙子！我渴坏了！……\n嗯？这个饮料可以给我？哦，谢\n谢！")
          }
          playSound("SFX_GET_KEY_ITEM")
          @speaker("") {
            @t("... Glug glug... ... Gulp...\nIf you want to go to SAFFRON\nCITY... ... You can go on\nthrough. I'll share this\nwith the other guards!", "……咕嘟咕嘟…………咕噜……\n如果你想去金黄市…………那就\n过去吧。我会和其他守卫一起享\n用的！")
          }
        } @else {
          @if (hasItem("LEMONADE")) {
            takeItem("LEMONADE", 1)
            setFlag("EVENT_GAVE_SAFFRON_GUARDS_DRINK")
            @speaker("") {
              @t("Whoa, boy! I'm parched! ...\nHuh? I can have this drink?\nGee, thanks!", "哇，小伙子！我渴坏了！……\n嗯？这个饮料可以给我？哦，谢\n谢！")
            }
            playSound("SFX_GET_KEY_ITEM")
            @speaker("") {
              @t("... Glug glug... ... Gulp...\nIf you want to go to SAFFRON\nCITY... ... You can go on\nthrough. I'll share this\nwith the other guards!", "……咕嘟咕嘟…………咕噜……\n如果你想去金黄市…………那就\n过去吧。我会和其他守卫一起享\n用的！")
            }
          } @else {
            // No drink: thirsty message, then turn the player back.
            @speaker("") {
              @t("I'm on guard duty. Gee, I'm\nthirsty, though!\n\nOh wait there, the road's\nclosed.", "我在执勤。哎呀，我好渴啊！\n\n啊，等等，这条路禁止通行。")
            }
            // Original shoves the player one tile right (PAD_RIGHT x1) out of
            // the gate: from trigger tiles (2,3)/(2,4) the player ends at
            // (3,3)/(3,4). A relative step right matches both trigger tiles.
            movePlayerRelative([[1, 0]])
          }
        }
      }
    }
  }
}
