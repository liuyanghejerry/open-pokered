  "text": {
    "npc": {
      "1": [
        {
          "line1": "You have #MON",
          "line2": "with you!"
        },
        {
          "line1": "You're mine!",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "You",
          "line2": "deceived me!"
        }
      ],
      "1_AfterBattle": [
        {
          "line1": "You need light to",
          "line2": "get through that"
        },
        {
          "line1": "dark tunnel ahead.",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "Who's that walking",
          "line2": "with those good"
        },
        {
          "line1": "looking #MON?",
          "line2": ""
        }
      ],
      "2_Defeated": [
        {
          "line1": "Out",
          "line2": "like a light!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "Keep walking!",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "I'm taking ROCK",
          "line2": "TUNNEL to go to"
        },
        {
          "line1": "LAVENDER...",
          "line2": ""
        }
      ],
      "3_Defeated": [
        {
          "line1": "Can't",
          "line2": "measure up!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "Are you off to",
          "line2": "ROCK TUNNEL too?"
        }
      ],
      "4": [
        {
          "line1": "Don't you dare",
          "line2": "condescend me!"
        }
      ],
      "4_Defeated": [
        {
          "line1": "No!",
          "line2": "You're too much!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "You're obviously",
          "line2": "talented! Good"
        },
        {
          "line1": "luck to you!",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "Bwahaha!",
          "line2": "Great! I was"
        },
        {
          "line1": "bored, eh!",
          "line2": ""
        }
      ],
      "5_Defeated": [
        {
          "line1": "Keep it",
          "line2": "coming, eh!"
        },
        {
          "line1": "Oh wait. I'm out",
          "line2": "of #MON!"
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "You sure had guts",
          "line2": "standing up to me"
        },
        {
          "line1": "there, eh?",
          "line2": ""
        }
      ],
      "6": [
        {
          "line1": "Hahaha!",
          "line2": "Aren't you a"
        },
        {
          "line1": "little toughie!",
          "line2": ""
        }
      ],
      "6_Defeated": [
        {
          "line1": "What's",
          "line2": "that?"
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "Hahaha! Kids",
          "line2": "should be tough!"
        }
      ],
      "7": [
        {
          "line1": "I got up early",
          "line2": "every day to"
        },
        {
          "line1": "raise my #MON",
          "line2": "from cocoons!"
        }
      ],
      "7_Defeated": [
        {
          "line1": "WHAT?",
          "line2": ""
        },
        {
          "line1": "What a total",
          "line2": "waste of time!"
        }
      ],
      "7_AfterBattle": [
        {
          "line1": "I have to collect",
          "line2": "more than bugs to"
        },
        {
          "line1": "get stronger...",
          "line2": ""
        }
      ],
      "8": [
        {
          "line1": "Hahahaha!",
          "line2": "Come on, dude!"
        }
      ],
      "8_Defeated": [
        {
          "line1": "Hahahaha!",
          "line2": "You beat me fair!"
        }
      ],
      "8_AfterBattle": [
        {
          "line1": "Hahahaha!",
          "line2": "Us hearty guys"
        },
        {
          "line1": "always laugh!",
          "line2": ""
        }
      ],
      "9": [
        {
          "line1": "Go, my super bug",
          "line2": "#MON!"
        }
      ],
      "9_Defeated": [
        {
          "line1": "My",
          "line2": "bugs..."
        }
      ],
      "9_AfterBattle": [
        {
          "line1": "If you don't like",
          "line2": "bug #MON, you"
        },
        {
          "line1": "bug me!",
          "line2": ""
        }
      ]
