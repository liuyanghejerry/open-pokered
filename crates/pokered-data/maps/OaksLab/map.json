          "line2": "toughen it up!"
        },
        {
          "line1": "<PLAYER>! Gramps!",
          "line2": "Smell you later!"
        }
      ],
      "script_RivalIPickedTheWrongPokemon": [
        {
          "line1": "WHAT?",
          "line2": "Unbelievable!"
        },
        {
          "line1": "I picked the",
          "line2": "wrong POKeMON!"
        }
      ],
      "script_RivalAmIGreatOrWhat": [
