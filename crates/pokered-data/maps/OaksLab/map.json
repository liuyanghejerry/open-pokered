        {
          "line1": "OAK: Oh right! I",
          "line2": "have a request"
        },
        {
          "line1": "of you two.",
          "line2": ""
        }
      ],
      "script_OakMyInventionPokedex": [
        {
          "line1": "On the desk there",
          "line2": "is my invention,"
        },
        {
          "line1": "POKeDEX!",
          "line2": ""
        },
        {
          "line1": "It automatically",
          "line2": "records data on"
        },
        {
          "line1": "POKeMON you've",
          "line2": "seen or caught!"
        },
        {
          "line1": "It's a hi-tech",
          "line2": "encyclopedia!"
        }
      ],
      "script_OakGotPokedex": [
        {
          "line1": "OAK: <PLAYER> and",
          "line2": "<RIVAL>! Take"
        },
        {
          "line1": "these with you!",
          "line2": ""
        },
        {
          "line1": "<PLAYER> got",
          "line2": "POKeDEX from OAK!"
        }
      ],
      "script_OakThatWasMyDream": [
        {
          "line1": "To make a complete",
          "line2": "guide on all the"
        },
        {
          "line1": "POKeMON in the",
          "line2": "world..."
        },
        {
          "line1": "That was my dream!",
          "line2": ""
        },
        {
          "line1": "But, I'm too old!",
          "line2": "I can't do it!"
        },
        {
          "line1": "So, I want you two",
          "line2": "to fulfill my"
        },
        {
          "line1": "dream for me!",
          "line2": ""
        },
        {
          "line1": "Get moving, you",
          "line2": "two!"
        },
        {
          "line1": "This is a great",
          "line2": "undertaking in"
        },
        {
          "line1": "POKeMON history!",
          "line2": ""
        }
      ],
      "script_RivalLeaveItAllToMe": [
        {
          "line1": "<RIVAL>: Alright",
          "line2": "Gramps! Leave it"
        },
        {
          "line1": "all to me!",
          "line2": ""
        },
        {
          "line1": "<PLAYER>, I hate to",
          "line2": "say it, but I"
        },
        {
          "line1": "don't need you!",
          "line2": ""
        },
        {
          "line1": "I know! I'll",
          "line2": "borrow a TOWN MAP"
        },
        {
          "line1": "from my sis!",
          "line2": ""
        },
        {
          "line1": "I'll tell her not",
          "line2": "to lend you one,"
        },
        {
          "line1": "<PLAYER>! Hahaha!",
          "line2": ""
        }
      ]
