      ],
      "7": [
        {
          "line1": "It's encyclopedia-",
          "line2": "like, but the"
        },
        {
          "line1": "pages are blank!",
          "line2": ""
        }
      ],
      "8": [
        {
          "line1": "?",
          "line2": ""
        }
      ],
      "9": [
        {
          "line1": "PROF.OAK is the",
          "line2": "authority on"
        },
        {
          "line1": "POKeMON!",
          "line2": ""
        },
        {
          "line1": "Many POKeMON",
          "line2": "trainers hold him"
        },
        {
          "line1": "in high regard!",
          "line2": ""
        }
      ],
      "10": [
        {
          "line1": "I study POKeMON as",
          "line2": "PROF.OAK's AIDE."
        }
      ],
      "11": [
        {
          "line1": "I study POKeMON as",
          "line2": "PROF.OAK's AIDE."
        }
      ],
      "script_RivalFedUpWithWaiting": [
        {
          "line1": "<RIVAL>: Gramps!",
          "line2": "I'm fed up with"
        },
        {
          "line1": "waiting!",
          "line2": ""
        }
      ],
      "script_OakChooseMon": [
        {
          "line1": "OAK: <RIVAL>?",
          "line2": "Let me think..."
        },
        {
          "line1": "Oh, that's right,",
          "line2": "I told you to"
        },
        {
          "line1": "come! Just wait!",
          "line2": ""
        },
        {
          "line1": "Here, <PLAYER>!",
          "line2": ""
        },
        {
          "line1": "There are 3",
          "line2": "POKeMON here!"
        },
        {
          "line1": "Haha!",
          "line2": ""
        },
        {
          "line1": "They are inside",
          "line2": "the POKe BALLs."
        },
        {
          "line1": "When I was young,",
          "line2": "I was a serious"
        },
        {
          "line1": "POKeMON trainer!",
          "line2": ""
        },
        {
          "line1": "In my old age, I",
          "line2": "have only 3 left,"
        },
        {
          "line1": "but you can have",
          "line2": "one! Choose!"
        }
      ],
      "script_RivalWhatAboutMe": [
        {
          "line1": "<RIVAL>: Hey!",
          "line2": "Gramps! What"
        },
        {
          "line1": "about me?",
          "line2": ""
        }
      ],
      "script_OakBePatient": [
