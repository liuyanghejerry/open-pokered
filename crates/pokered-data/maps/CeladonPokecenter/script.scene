// Refactored from CeladonPokecenter/script.js to dotzuki-engine-dsl.
//
// This is a representative manual refactor of a Pokecenter map. The
// auto-converter correctly handles the surrounding structure
// (NPC talk handlers, route table) but cannot safely rewrite the
// imperative `var choice = await game.showChoice([...])` + `if
// (choice == N) { ... }` pattern into the declarative
// `@choice { @option(...) { ... } }` form. The refactor below shows
// the target shape — every Pokecenter map should follow this template.

game_scene CeladonPokecenter {
  @storyline("talkNurse") {
    @trigger(map = "CeladonPokecenter", npc = 1)
    // DisplayPokemonCenterDialogue_: inner PROMPT, optional paused DONE, HEAL/CANCEL.
    answer = pokecenterNurseOffer(getPokecenterUsed(), @t("Welcome to our POKeMON\nCENTER!", "欢迎光临宝可梦中心！"), @t("We heal your POKeMON back to\nperfect health!", "我们会把你的宝可梦恢复到最佳\n状态！"), @t("Shall we heal your POKeMON?", "要为你治疗宝可梦吗？"), @t("HEAL", "治疗"), @t("CANCEL", "取消"))
    @if (answer == 0) {
      printFieldText(@t("OK. We'll need your\nPOKeMON.", "OK，请把你的宝可梦交给我。"), true)
      faceNpc("1", "left")
      delay(3)
      heal()
      animateHealingMachine()
      printFieldText(@t("Thank you!\nYour POKeMON are\nfighting fit!", "感谢您的耐心等待。\n\n你的宝可梦已完全治愈！"), true, "prompt")
      setNpcFrame("1", 1)
      delay(20)
    }
    pokecenterFarewell(@t("We hope to see you again!", "欢迎下次再来！"))
    faceNpc("1", "down")
  }

  @storyline("talkLinkReceptionist") {
    @trigger(map = "CeladonPokecenter", npc = 4)
    @speaker("") {
      @t("Welcome to the\nCable Club!", "欢迎来到联机俱乐部！")
    }
    linkStart()
  }

  @storyline("talkGentleman") {
    @trigger(map = "CeladonPokecenter", npc = 2)
    @speaker("") {
      @t("POKE FLUTE awakens POKEMON\nwith a sound that only they\ncan hear!", "宝可梦之笛的笛声能让宝可梦苏\n醒，那声音只有它们能听见！")
    }
  }

  @storyline("talkBeauty") {
    @trigger(map = "CeladonPokecenter", npc = 3)
    @speaker("") {
      @t("I rode uphill on CYCLING\nROAD from FUCHSIA!", "我骑着自行车从浅红市一路骑上\n坡！")
    }
  }

  // ── Pokémon Center PC (sign 1 at 13,3) ───────────────────────────────
  // engine/menus/pc.asm ActivatePC: BILL's PC / item PC / PROF.OAK's PC.
  @storyline("pcStorage") {
    @trigger(map = "CeladonPokecenter", sign = 1)
    openPC()
  }


  // ── Bench guy (sign 2 at (0,4)) — PrintBenchGuyText ────────────────────
  // data/events/bench_guys.asm + hidden_events.asm: A on the (0,4) bench
  // tile while facing it; BenchGuyTextPointers requires SPRITE_FACING_LEFT,
  // so gate on the player's facing (getPlayerFacing() -> down/up/left/right).
  @storyline("benchGuy") {
    @trigger(map = "CeladonPokecenter", sign = 2)
    @if (getPlayerFacing() == "left") {
      @speaker("") {
        @t("If I had a BIKE,
I would go to
CYCLING ROAD!", "要是我有自行车，\n就去自行车道！")
      }
    }
  }
}
