// SilphCo11F — translated from the original disassembly (scripts/SilphCo11F.asm,
// text/SilphCo11F.asm) to the real Game DSL API surface.
//
// Content types:
//  - Silph President (npc 1): talk-driven key-item gate. First talk gives the
//    MASTER BALL (EVENT_GOT_MASTER_BALL); later talks give the description. The
//    original tries GiveItem and falls back to a "no room" line if the bag is
//    full.
//  - Secretary / Beauty (npc 2): dialogue only (thank-you).
//  - Giovanni (npc 3): coord interception, dialogue, three downward steps,
//    facing adjustment and boss battle; direct interaction also starts battle.
//  - Rocket guards (npc 4, 5): sight-engaged trainers; handlers are dialogue
//    only (the runtime drives the battle).

game_scene SilphCo11F {
  // ── Card-Key gate door (SilphCo11FGateCallbackScript) ────────────────────
  // Original: on load the callback writes the LOCKED wall block $20 (32) at
  // block (X=3, Y=6) unless EVENT_SILPH_CO_11_UNLOCKED_DOOR is already set;
  // using the CARD KEY on the door opens it (block $03).
  @load {
    @if (getFlag("EVENT_SILPH_CO_11_UNLOCKED_DOOR")) {
      replaceTileBlock(3, 6, 3)
    } @else {
      replaceTileBlock(3, 6, 32)
    }
  }

  // The four door tiles also have OnInteract bindings in overworld setup.
  // A from the corridor reaches this handler while the door is still solid.
  // PrintCardKeyText uses open block 3 for this floor's SilphCo tileset.
  @storyline("cardKeyDoor") {
    @trigger(map = "SilphCo11F", name = "cardKeyDoor1", coords = [[6, 12]])
    @if (!getFlag("EVENT_SILPH_CO_11_UNLOCKED_DOOR")) {
      @if (hasItem("CARD_KEY")) {
        @speaker("") { @t("Bingo!", "猜中了！") }
        @speaker("") { @t("The CARD KEY opened the\ndoor!", "磁卡钥匙打开了门！") }
        setFlag("EVENT_SILPH_CO_11_UNLOCKED_DOOR")
        replaceTileBlock(3, 6, 3)
        playSound("SFX_GO_INSIDE")
      } @else {
        @speaker("") { @t("Darn! It needs a CARD KEY!", "可恶！需要磁卡钥匙！") }
      }
    }
  }

  // ── On-step Giovanni interception (coords (6,13)/(7,12)) ────────────────
  // Original SilphCo11FDefaultScript: text, DOWN x3, reciprocal facing,
  // Delay3, battle. Defeated Giovanni no longer intercepts either tile.
  @storyline("giovanniStep") {
    @trigger(map = "SilphCo11F", name = "giovanniStep1", coords = [[6, 13], [7, 12]])
    @if (!getFlag("EVENT_BEAT_SILPH_CO_GIOVANNI")) {
      @speaker("") {
        @t("Ah <PLAYER>! So we meet\nagain!\n\nThe PRESIDENT and I are\ndiscussing a vital business\nproposition.\n\nKeep your nose out of\ngrown-up matters...\n\nOr, experience a world of\npain!", "啊，<PLAYER>！我们又见面了！\n\n我和社长正在商讨一个重要的商\n业提案。\n\n大人的事情小孩子不要插手……\n\n否则的话，让你尝尝苦头！")
      }
      moveNpc("SILPH_CO_11F_OBJ_3", [[6, 10], [6, 11], [6, 12]])
      @if (getPlayerY() == 13) {
        facePlayer("up")
        faceNpc("3", "down")
      } @else {
        facePlayer("left")
        faceNpc("3", "right")
      }
      delay(3)
      result = startBattle("OPP_GIOVANNI2")
      @if (result == "win") {
        @speaker("") {
          @t("Arrgh!! I lost again!?", "啊！！我又输了！？")
        }
        @speaker("") {
          @t("Blast it all! You ruined our\nplans for SILPH!\n\nBut, TEAM ROCKET will never\nfall!\n\n<PLAYER>! Never forget that\nall POKeMON exist for TEAM\nROCKET!\n\nI must go, but I shall\nreturn!", "可恶！你毁了我们西尔佛的计\n划！\n\n但是，火箭队永远打不倒！\n\n<PLAYER>！永远不要忘记，所有\n宝可梦都归火箭队所有！\n\n我该走了，还会再回来！")
        }
        setFlag("EVENT_BEAT_SILPH_CO_GIOVANNI")
        hideObjectByName("SILPH_CO_11F_OBJ_3")
        hideObjectByName("SILPH_CO_11F_OBJ_4")
        hideObjectByName("SILPH_CO_11F_OBJ_5")
        // SilphCo11FTeamRocketLeavesScript: the occupation ends — every
        // Saffron City rocket clears and the liberated citizens return
        // (cross-map toggle bits, applied on SaffronCity entry).
        hideObjectByName("SAFFRON_CITY_OBJ_1")
        hideObjectByName("SAFFRON_CITY_OBJ_2")
        hideObjectByName("SAFFRON_CITY_OBJ_3")
        hideObjectByName("SAFFRON_CITY_OBJ_4")
        hideObjectByName("SAFFRON_CITY_OBJ_5")
        hideObjectByName("SAFFRON_CITY_OBJ_6")
        hideObjectByName("SAFFRON_CITY_OBJ_7")
        hideObjectByName("SAFFRON_CITY_OBJ_14")
        hideObjectByName("SAFFRON_CITY_OBJ_15")
        showObjectByName("SAFFRON_CITY_OBJ_8")
        showObjectByName("SAFFRON_CITY_OBJ_9")
        showObjectByName("SAFFRON_CITY_OBJ_10")
        showObjectByName("SAFFRON_CITY_OBJ_11")
        showObjectByName("SAFFRON_CITY_OBJ_12")
        showObjectByName("SAFFRON_CITY_OBJ_13")
      }
    }
  }

  // ── Silph President (npc 1) — gives the MASTER BALL ─────────────────────
  @storyline("talkSilphPresident") {
    @trigger(map = "SilphCo11F", npc = 1)
    @if (getFlag("EVENT_GOT_MASTER_BALL")) {
      printFieldText(t("PRESIDENT: You can't buy\nthat anywhere!", "社长：这个东西哪里都买不到！"))
      printFieldParagraph(t("It's our secret prototype\nMASTER BALL!", "这是我们秘密开发的试作型大师\n球！"))
      printFieldParagraph(t("It will catch any POKeMON\nwithout fail!", "无论什么宝可梦都能抓住！"))
      printFieldParagraph(t("You should be quiet about\nusing it, though.", "不过这件事你可要保密不要声\n张！"))
    } @else {
      printFieldText(t("PRESIDENT: Thank you for\nsaving SILPH!", "社长：谢谢你拯救了西尔佛公\n司！"))
      printFieldParagraph(t("I will never forget you\nsaved us in our moment of\nperil!", "我永远不会忘记你在我们危难时\n刻救了我们！"))
      printFieldParagraph(t("I have to thank you in some\nway!", "我必须要好好谢你！"))
      printFieldParagraph(t("Because I am rich, I can\ngive you anything!", "因为我很有钱，想要什么都给\n你！"))
      printFieldParagraph(t("Here, maybe this will do!", "来，这个送给你！"))
      waitFieldPrompt()
      given = giveItem("MASTER_BALL", 1)
      @if (given) {
        printItemFieldText(t("<PLAYER> got a MASTER BALL!", "<PLAYER>获得了大师球！"), "SFX_GET_KEY_ITEM")
        setFlag("EVENT_GOT_MASTER_BALL")
      } @else {
        printFieldText(t("You have no room for this.", "你没有空间放这个了！"))
      }
    }
    finishFieldText()
  }

  // ── Secretary / Beauty (npc 2) — dialogue only ──────────────────────────
  @storyline("talkBeauty") {
    @trigger(map = "SilphCo11F", npc = 2)
    @speaker("") {
      @t("SECRETARY: Thank you for\nrescuing all of us!\n\nWe admire your courage.", "秘书：谢谢你救了我们所有人！\n\n我们很敬佩你的勇气！")
    }
  }

  // ── Giovanni (npc 3) — scripted boss battle ─────────────────────────────
  @storyline("talkGiovanni") {
    @trigger(map = "SilphCo11F", npc = 3, toggle = "SILPH_CO_11F_OBJ_3")
    @if (getFlag("EVENT_BEAT_SILPH_CO_GIOVANNI")) {
      @speaker("") {
        @t("Arrgh!! I lost again!?", "啊！！我又输了！？")
      }
    } @else {
      @speaker("") {
        @t("Ah <PLAYER>! So we meet\nagain!\n\nThe PRESIDENT and I are\ndiscussing a vital business\nproposition.\n\nKeep your nose out of\ngrown-up matters...\n\nOr, experience a world of\npain!", "啊，<PLAYER>！我们又见面了！\n\n我和社长正在商讨一个重要的商\n业提案。\n\n大人的事情小孩子不要插手……\n\n否则的话，让你尝尝苦头！")
      }
      result = startBattle("OPP_GIOVANNI2")
      @if (result == "win") {
        @speaker("") {
          @t("Arrgh!! I lost again!?", "啊！！我又输了！？")
        }
        @speaker("") {
          @t("Blast it all! You ruined our\nplans for SILPH!\n\nBut, TEAM ROCKET will never\nfall!\n\n<PLAYER>! Never forget that\nall POKeMON exist for TEAM\nROCKET!\n\nI must go, but I shall\nreturn!", "可恶！你毁了我们西尔佛的计\n划！\n\n但是，火箭队永远打不倒！\n\n<PLAYER>！永远不要忘记，所有\n宝可梦都归火箭队所有！\n\n我该走了，还会再回来！")
        }
        setFlag("EVENT_BEAT_SILPH_CO_GIOVANNI")
        // TEAM ROCKET leaves SILPH. The original hides dozens of Rocket grunts
        // across every Silph floor (cross-map ShowObject/HideObject on the
        // SAFFRON/SILPH toggle tables); the DSL surface can only touch this
        // map's objects, so we hide Giovanni and the two guards here. The
        // EVENT flag is what gates the other floors' grunts on re-entry.
        hideObjectByName("SILPH_CO_11F_OBJ_3")
        hideObjectByName("SILPH_CO_11F_OBJ_4")
        hideObjectByName("SILPH_CO_11F_OBJ_5")
        // SilphCo11FTeamRocketLeavesScript: the Saffron City occupation ends.
        hideObjectByName("SAFFRON_CITY_OBJ_1")
        hideObjectByName("SAFFRON_CITY_OBJ_2")
        hideObjectByName("SAFFRON_CITY_OBJ_3")
        hideObjectByName("SAFFRON_CITY_OBJ_4")
        hideObjectByName("SAFFRON_CITY_OBJ_5")
        hideObjectByName("SAFFRON_CITY_OBJ_6")
        hideObjectByName("SAFFRON_CITY_OBJ_7")
        hideObjectByName("SAFFRON_CITY_OBJ_14")
        hideObjectByName("SAFFRON_CITY_OBJ_15")
        showObjectByName("SAFFRON_CITY_OBJ_8")
        showObjectByName("SAFFRON_CITY_OBJ_9")
        showObjectByName("SAFFRON_CITY_OBJ_10")
        showObjectByName("SAFFRON_CITY_OBJ_11")
        showObjectByName("SAFFRON_CITY_OBJ_12")
        showObjectByName("SAFFRON_CITY_OBJ_13")
      }
    }
  }

  // ── Rocket guard (npc 4) — sight-engaged; dialogue only ─────────────────
  @storyline("talkRocket") {
    @trigger(map = "SilphCo11F", npc = 4, toggle = "SILPH_CO_11F_OBJ_4")
    @if (getFlag("EVENT_BEAT_SILPH_CO_11F_TRAINER_0")) {
      @speaker("") {
        @t("So, you want to see my BOSS?", "你想去见我们老大吗？")
      }
    } @else {
      @speaker("") {
        @t("Stop right there! Don't you\nmove!", "站住！不许动！")
      }
    }
  }

  // ── Rocket guard (npc 5) — sight-engaged; dialogue only ─────────────────
  @storyline("talkRocket1") {
    @trigger(map = "SilphCo11F", npc = 5, toggle = "SILPH_CO_11F_OBJ_5")
    @if (getFlag("EVENT_BEAT_SILPH_CO_11F_TRAINER_1")) {
      @speaker("") {
        @t("Watch your step, my BOSS\nlikes his POKeMON tough!", "小心点，我们老大喜欢强悍的宝\n可梦！")
      }
    } @else {
      @speaker("") {
        @t("Halt! Do you have an\nappointment with my BOSS?", "站住！你与我们老大有预约吗？")
      }
    }
  }

  // ── PC (sign 1 at 10,12) — OpenPokemonCenterPC ──
  @storyline("pcSign1") {
    @trigger(map = "SilphCo11F", sign = 1)
    openPC()
  }
}
