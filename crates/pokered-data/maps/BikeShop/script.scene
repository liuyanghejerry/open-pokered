// BikeShop — translated from the original disassembly (scripts/BikeShop.asm,
// text/BikeShop.asm) to the real Game DSL API surface. Item-gate / NPC-dialogue
// map: the clerk swaps a BIKE_VOUCHER for a BICYCLE; the ¥1,000,000 "buy" path
// is unaffordable by design, so it always falls through to "can't afford".

game_scene BikeShop {
  // ── Clerk (npc 1) — voucher exchange + unaffordable sale ────────────────
  @storyline("talkBikeShopClerk") {
    @trigger(map = "BikeShop", npc = 1)
    @if (getFlag("EVENT_GOT_BICYCLE")) {
      printFieldText(t("How do you like your new\nBICYCLE?", "你觉得新买的自行车怎么样？"))
      printFieldParagraph(t("You can take it on CYCLING\nROAD and in caves!", "你可以骑着它去自行车道和洞窟\n里！"))
    } @else {
      @if (hasItem("BIKE_VOUCHER")) {
        printFieldText(t("Oh, that's...", "哦，这是……"))
        printFieldParagraph(t("A BIKE VOUCHER!", "自行车兑换券！"))
        printFieldParagraph(t("OK! Here you go!", "好！给你！"))
        waitFieldPrompt()
        given = giveItem("BICYCLE", 1)
        @if (given) {
          takeItem("BIKE_VOUCHER", 1)
          setFlag("EVENT_GOT_BICYCLE")
          printItemFieldText(@t("<PLAYER> exchanged the BIKE\nVOUCHER for a BICYCLE.", "<PLAYER>用自行车兑换券换到了\n一辆自行车。"), "SFX_GET_KEY_ITEM")
        } @else {
          printFieldText(t("You better make room for\nthis!", "你最好腾出地方来！"))
        }
      } @else {
        printFieldText(t("Hi! Welcome to our BIKE\nSHOP.", "你好！欢迎来到自行车店。"))
        printFieldParagraph(t("Have we got just the BIKE\nfor you!", "我们正好有适合你的自行车！"))
        waitFieldPrompt()
        setFieldTextDelayDisabled(true)
        selected = chooseInstantFieldMenu([t("BICYCLE ¥1000000", "自行车 ¥1000000"), t("CANCEL", "取消")], t("It's a cool BIKE! Do you\nwant it?", "这自行车很酷吧！你想要吗？"))
        // B bypasses the original res BIT_NO_TEXT_DELAY. A clears it for
        // both the unaffordable purchase and the CANCEL row.
        @if (selected >= 0) {
          setFieldTextDelayDisabled(false)
        }
        @if (selected == 0) {
          printFieldText(t("Sorry! You can't afford it!", "抱歉！你买不起它！"))
          waitFieldPrompt()
        }
        printFieldText(t("Come back again some time!", "欢迎下次再来！"))
      }
    }
    finishFieldText()
  }

  // ── Middle-aged woman (npc 2) — plain dialogue ──────────────────────────
  @storyline("talkMiddleAgedWoman") {
    @trigger(map = "BikeShop", npc = 2)
    @speaker("") {
      @t("A plain city BIKE is good\nenough for me!\n\nYou can't put a shopping\nbasket on an MTB!", "普通的城市自行车对我来说就足\n够了！\n\n山地车上可装不了购物篮！")
    }
  }

  // ── Youngster (npc 3) — branches on having the bicycle ──────────────────
  @storyline("talkYoungster") {
    @trigger(map = "BikeShop", npc = 3)
    @if (getFlag("EVENT_GOT_BICYCLE")) {
      @speaker("") {
        @t("Wow. Your BIKE is really\ncool!", "哇！你的自行车真酷！")
      }
    } @else {
      @speaker("") {
        @t("These BIKEs are cool, but\nthey're way expensive!", "这些自行车很酷，但是太贵了！")
      }
    }
  }
}
