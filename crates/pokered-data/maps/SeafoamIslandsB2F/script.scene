// SeafoamIslandsB2F — translated from the original disassembly
// (scripts/SeafoamIslandsB2F.asm; dialogue is the shared BoulderText).
// Two STRENGTH boulders (npc 1 & 2) that can be pushed into the holes at
// (19,6)/(22,6) to drop them to B3F (engine-side check in tick_boulder_push
// sets EVENT_SEAFOAM3_BOULDER{n}_DOWN_HOLE). The player can also fall through
// the holes to B3F via the coord warps below (DungeonWarpData: (18,7)/(19,7)).
//
// The boulders start hidden (orig TOGGLE_SEAFOAM_ISLANDS_B2F_BOULDER_{1,2}
// initial OFF in data/maps/toggleable_objects.asm): each appears only when the
// matching B1F boulder has landed (EVENT_SEAFOAM2_BOULDER{n}_DOWN_HOLE → orig
// ShowObject of TOGGLE_..._B2F_BOULDER_{n} in scripts/SeafoamIslandsB1F.asm),
// and re-hides once pushed through this floor's own hole.

game_scene SeafoamIslandsB2F {
  @load {
    // Show a boulder that fell through from B1F (starts defaultHidden).
    @if (getFlag("EVENT_SEAFOAM2_BOULDER1_DOWN_HOLE")) {
      showObjectByName("SEAFOAM_ISLANDS_B2F_OBJ_1")
    }
    @if (getFlag("EVENT_SEAFOAM2_BOULDER2_DOWN_HOLE")) {
      showObjectByName("SEAFOAM_ISLANDS_B2F_OBJ_2")
    }
    // Keep a boulder hidden once it has been pushed through this floor's hole.
    @if (getFlag("EVENT_SEAFOAM3_BOULDER1_DOWN_HOLE")) {
      hideObjectByName("SEAFOAM_ISLANDS_B2F_OBJ_1")
    }
    @if (getFlag("EVENT_SEAFOAM3_BOULDER2_DOWN_HOLE")) {
      hideObjectByName("SEAFOAM_ISLANDS_B2F_OBJ_2")
    }
  }

  // ── Falling through the holes to B3F ───────────────────────────────────
  @storyline("coordHole1") {
    @trigger(map = "SeafoamIslandsB2F", name = "hole1", coords = [[19, 6]])
    warpTo("SeafoamIslandsB3F", 18, 7)
  }
  @storyline("coordHole2") {
    @trigger(map = "SeafoamIslandsB2F", name = "hole2", coords = [[22, 6]])
    warpTo("SeafoamIslandsB3F", 19, 7)
  }

  // ── Boulder 1 (npc 1) — STRENGTH-pushable ───────────────────────────────
  @storyline("talkBoulder1") {
    @trigger(map = "SeafoamIslandsB2F", npc = 1, toggle = "SEAFOAM_ISLANDS_B2F_OBJ_1", hidden = true)
    @speaker("") {
      @t("This requires STRENGTH to\nmove!", "这需要怪力才能移动！")
    }
  }

  // ── Boulder 2 (npc 2) — STRENGTH-pushable ───────────────────────────────
  @storyline("talkBoulder2") {
    @trigger(map = "SeafoamIslandsB2F", npc = 2, toggle = "SEAFOAM_ISLANDS_B2F_OBJ_2", hidden = true)
    @speaker("") {
      @t("This requires STRENGTH to\nmove!", "这需要怪力才能移动！")
    }
  }
}
