// CeladonMartElevator — translated from the original disassembly
// (scripts/CeladonMartElevator.asm; the floor menu uses the shared
// engine/events/elevator.asm "Which floor do you want?" prompt) to the real
// Game DSL API surface. The only interactive object is the elevator panel
// (sign 1): it opens the floor menu for the 5 Celadon Mart floors. There is no
// LIFT_KEY gate here — the menu is always available.
//
// The floor menu runs through `game.elevatorMenu(floors)` (resolves to the
// chosen 0-based index; -1 on cancel). The warp targets follow the
// CeladonMartElevatorWarpMaps table (floor -> warp number on that floor),
// resolved through each floor's `map.json` warp list (0-based indices — the
// same convention the engine's `elevator_data` uses). Every floor's elevator
// is at the top-left (1,1):
//   1F -> warp 5 (1, 1)
//   2F -> warp 2 (1, 1)
//   3F -> warp 2 (1, 1)
//   4F -> warp 2 (1, 1)
//   5F -> warp 2 (1, 1)
// The on-enter ShakeElevator animation (CeladonMartElevatorShakeScript) is
// handled by the engine: choosing a floor in `elevatorMenu` shakes the screen
// for 200 frames once the floor warp completes (SFX_COLLISION rumble +
// SFX_SAFARI_ZONE_PA ding), with the player standing at the elevator.
// CeladonMartElevatorStoreWarpEntriesScript (recording where the player
// entered from so the elevator can return them) is handled by the warp system
// here; the per-floor warpTo targets above encode the destinations directly.

game_scene CeladonMartElevator {
  // ── Elevator panel (sign 1) ──────────────────────────────────────────────
  @storyline("elevatorPanel") {
    @trigger(map = "CeladonMartElevator", sign = 1)
    @speaker("") { @t("Which floor do you want? ", "你想去哪一层？") }
    floor = elevatorMenu(["1F", "2F", "3F", "4F", "5F"])
    @if (floor == 0) {
      warpTo("CeladonMart1F", 1, 1)
    }
    @if (floor == 1) {
      warpTo("CeladonMart2F", 1, 1)
    }
    @if (floor == 2) {
      warpTo("CeladonMart3F", 1, 1)
    }
    @if (floor == 3) {
      warpTo("CeladonMart4F", 1, 1)
    }
    @if (floor == 4) {
      warpTo("CeladonMart5F", 1, 1)
    }
  }
}
