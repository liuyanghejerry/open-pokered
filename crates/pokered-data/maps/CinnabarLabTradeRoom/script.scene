// CinnabarLabTradeRoom — translated from the original disassembly
// (scripts/CinnabarLabTradeRoom.asm, text/CinnabarLabTradeRoom.asm,
// engine/events/in_game_trades.asm, data/events/trades.asm).
//
// This is an in-game trade room. The SuperNerd is a flavor NPC. The Gramps
// offers TRADE_FOR_DORIS (give RAICHU, receive ELECTRODE nicknamed DORIS,
// dialogset EVOLUTION) and the Beauty offers TRADE_FOR_CRINKLES (give VENONAT,
// receive TANGELA nicknamed CRINKLES, dialogset HAPPY).
//
// Both trades are fully implemented via tradePokemon(): it verifies the player
// carries the required species, removes it from the party, and adds the
// received POKeMON (DORIS the ELECTRODE / CRINKLES the TANGELA) with the trade
// animation; the wrong-mon path returns false. See talkGramps / talkBeauty
// below.

game_scene CinnabarLabTradeRoom {
  // ── SuperNerd (npc 1) — flavor dialogue ─────────────────────────────────
  @storyline("talkSuperNerd") {
    @trigger(map = "CinnabarLabTradeRoom", npc = 1)
    @speaker("") {
      @t("I found this very strange\nfossil in MT.MOON!\n\nI think it's a rare,\nprehistoric POKeMON!", "我在月见山发现了非常奇怪的化\n石！\n\n我觉得它是稀有的史前宝可梦！")
    }
  }

  // ── Gramps (npc 2) — TRADE_FOR_DORIS: RAICHU -> ELECTRODE (DORIS) ────────
  @storyline("talkGramps") {
    @trigger(map = "CinnabarLabTradeRoom", npc = 2)
    @if (getFlag("EVENT_TRADED_FOR_DORIS")) {
      // AfterTrade2Text (dialogset EVOLUTION)
      @speaker("") {
        @t("The RAICHU you traded to me\n\nwent and evolved!", "你换给我的雷丘\n\n进化了！")
      }
    } @else {
      // WannaTrade2Text (dialogset EVOLUTION)
      @speaker("") {
        @t("Hello there! Do you want to\ntrade\n\nyour RAICHU for ELECTRODE?", "你好！你愿意交换宝可梦吗\n\n把你的雷丘换我的雷电球？")
      }
      @choice {
        @option(@t("YES", "是")) {
          // ConnectCableText -> real in-game trade (removes RAICHU, adds
          // ELECTRODE nicknamed DORIS). tradePokemon returns false if the
          // player doesn't actually carry RAICHU -> wrong-mon (dialogset EVOLUTION).
          @speaker("") { @t("Okay, connect the cable like\nso!", "好，像这样连接线缆！") }
          traded = tradePokemon("RAICHU", "ELECTRODE", "DORIS")
          @if (traded) {
            setFlag("EVENT_TRADED_FOR_DORIS")
            @speaker("") { @t("<PLAYER> traded RAICHU for\nELECTRODE!", "<PLAYER>把雷丘换成了雷电球！") }
            @speaker("") { @t("Thanks!", "谢谢！") }
          } @else {
            @speaker("") { @t("...This is no RAICHU.\n\nIf you get one, trade it\nwith me!", "……这不是雷丘。\n\n如果你弄到一只，来跟我换吧！") }
          }
        }
        @option(@t("NO", "否")) {
          // NoTrade2Text
          @speaker("") { @t("Well, if you don't want\nto...", "好吧，如果你不想的话……") }
        }
      }
    }
  }

  // ── Beauty (npc 3) — TRADE_FOR_CRINKLES: VENONAT -> TANGELA (CRINKLES) ───
  @storyline("talkBeauty") {
    @trigger(map = "CinnabarLabTradeRoom", npc = 3)
    @if (getFlag("EVENT_TRADED_FOR_CRINKLES")) {
      // AfterTrade3Text (dialogset HAPPY)
      @speaker("") {
        @t("How is my old TANGELA?\n\nMy VENONAT is doing great!", "我的老蔓藤怪还好吗？\n\n我的毛球过得很棒！")
      }
    } @else {
      // WannaTrade3Text (dialogset HAPPY)
      @speaker("") {
        @t("Hi! Do you have VENONAT?\n\nWant to trade it for\nTANGELA?", "嗨！你有毛球吗？\n\n想把它换成蔓藤怪吗？")
      }
      @choice {
        @option(@t("YES", "是")) {
          // ConnectCableText -> real in-game trade (removes VENONAT, adds
          // TANGELA nicknamed CRINKLES). tradePokemon returns false if the
          // player doesn't actually carry VENONAT -> wrong-mon (dialogset HAPPY).
          @speaker("") { @t("Okay, connect the cable like\nso!", "好，像这样连接线缆！") }
          traded = tradePokemon("VENONAT", "TANGELA", "CRINKLES")
          @if (traded) {
            setFlag("EVENT_TRADED_FOR_CRINKLES")
            @speaker("") { @t("<PLAYER> traded VENONAT for\nTANGELA!", "<PLAYER>把毛球换成了蔓藤怪！") }
            @speaker("") { @t("Thanks pal!", "谢啦，朋友！") }
          } @else {
            @speaker("") { @t("Hmmm? This isn't VENONAT.\n\nThink of me when you get\none.", "嗯？这不是毛球。\n\n等你弄到一只，要记得我哦。") }
          }
        }
        @option(@t("NO", "否")) {
          // NoTrade3Text
          @speaker("") { @t("That's too bad.", "那太可惜了。") }
        }
      }
    }
  }
}
