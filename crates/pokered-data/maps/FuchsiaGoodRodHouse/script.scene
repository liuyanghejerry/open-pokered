// FuchsiaGoodRodHouse: original gift status precedes all receipt paragraphs.
game_scene FuchsiaGoodRodHouse {
  @storyline("talkFishingGuru") {
    @trigger(map = "FuchsiaGoodRodHouse", npc = 1)
    @if (getFlag("EVENT_GOT_GOOD_ROD")) {
      printFieldTextParts([
        t("Hello there, <PLAYER>!", "你好呀， <PLAYER>！"),
        t("How are the fish biting?", "鱼钓得怎么样？")
      ], false)
    } @else {
      answer = askFieldYesNo(t("I'm the FISHING GURU's older\nbrother!\n\nI simply Looove fishing!\n\nDo you like to fish?", "我啊，是那个垂钓大师的哥哥！\n\n我超喜欢钓鱼！\n\n你喜欢钓鱼吗？"), t("YES", "是"), t("NO", "否"))
      @if (answer == 0) {
        given = giveItem("GOOD_ROD", 1)
        @if (given) {
          setFlag("EVENT_GOT_GOOD_ROD")
          printItemFieldTextParts([
            t("Grand! I like your style!", "很好！我喜欢你的风格！"),
            t("Take this and fish, young\none!", "拿上这个，去钓鱼吧，少年！"),
            t("<PLAYER> received a GOOD\nROD!", "<PLAYER>得到了一根好钓竿！")
          ], "SFX_GET_ITEM_1", false)
        } @else {
          printFieldTextParts([
            t("Oh no!", "哎呀！"),
            t("You have no room for my\ngift!", "你没有地方放我的礼物！")
          ], false)
        }
      } @else {
        printFieldTextParts([
          t("Oh... That's so\ndisappointing...", "哦……真让人失望……")
        ], false)
      }
    }
    acknowledgeFieldText()
  }
}
