// FuchsiaGoodRodHouse — translated from the original disassembly
// (scripts/FuchsiaGoodRodHouse.asm, text/FuchsiaGoodRodHouse.asm) to the real
// Game DSL API surface. Single-NPC item-gate house: the FISHING GURU's older
// brother gives the GOOD ROD once (gated on EVENT_GOT_GOOD_ROD) after a YES/NO
// prompt, then greets the player on later visits.
//

game_scene FuchsiaGoodRodHouse {
  // ── FISHING GURU's older brother (npc 1) — gives the GOOD ROD ───────────
  @storyline("talkFishingGuru") {
    @trigger(map = "FuchsiaGoodRodHouse", npc = 1)
    @if (getFlag("EVENT_GOT_GOOD_ROD")) {
      // Already gave the rod (.HowAreTheFishText).
      printFieldText(@t("Hello there, <PLAYER>!", "你好呀， <PLAYER>！"))
      printFieldParagraph(@t("How are the fish biting?", "鱼钓得怎么样？"))
      finishFieldText()
    } @else {
      // .Text → YesNoChoice.
      // Original inner PrintText returns on DONE before YesNoChoice.
      printFieldText(@t("I'm the FISHING GURU's older\nbrother!", "我啊，是那个垂钓大师的哥哥！"))
      printFieldParagraph(@t("I simply Looove fishing!", "我超喜欢钓鱼！"))
      printFieldParagraph(@t("Do you like to fish?", "你喜欢钓鱼吗？"))
      @choice {
        @option(@t("YES", "是")) {
          // .ReceivedGoodRodText + GiveItem GOOD_ROD.
          given = giveItem("GOOD_ROD", 1)
          @if (given) {
            setFlag("EVENT_GOT_GOOD_ROD")
            printFieldText(@t("Grand! I like your style!", "很好！我喜欢你的风格！"))
            printFieldParagraph(@t("Take this and fish, young\none!", "拿上这个，去钓鱼吧，少年！"))
            printFieldParagraph(@t("<PLAYER> received a GOOD\nROD!", "<PLAYER>得到了一根好钓竿！"), "SFX_GET_ITEM_1")
            finishFieldText()
          } @else {
            printFieldText(@t("Oh no!", "哎呀！"))
            printFieldParagraph(@t("You have no room for my\ngift!", "你没有地方放我的礼物！"))
            finishFieldText()
          }
        }
        @option(@t("NO", "否")) {
          // .ThatsSoDisappointingText.
          printFieldText(@t("Oh... That's so\ndisappointing...", "哦……真让人失望……"))
          finishFieldText()
        }
      }
    }
  }
}
