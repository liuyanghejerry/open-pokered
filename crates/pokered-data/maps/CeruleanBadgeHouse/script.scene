// CeruleanBadgeHouse — translated from the original disassembly
// (scripts/CeruleanBadgeHouse.asm, text/CeruleanBadgeHouse.asm) to the real
// Game DSL API surface.
//
// The Middle-Aged Man describes the secret of each #MON BADGE you own. The
// original builds a SPECIALLISTMENU populated with the badges the player owns,
// looping prints the matching description until the player cancels. The prompt
// asks about all 8 BADGEs, but the repeatable menu only offers owned badges.

game_scene CeruleanBadgeHouse {
  // ── Middle-Aged Man (npc 1) — the BADGE secrets guide ──────────────────
  @storyline("talkMiddleAgedMan") {
    @trigger(map = "CeruleanBadgeHouse", npc = 1)

    @speaker("") {
      @t("POKeMON BADGEs are owned\nonly by skilled trainers.\n\nI see you have at least one.\n\nThose BADGEs have amazing\nsecrets!", "宝可梦徽章只有厉害的训练家才\n拥有。\n\n你好像已经有一枚了吧。\n\n那些徽章藏着惊人的秘密！")
    }
    @speaker("") {
      @t("Now then...\n\nWhich of the 8 BADGEs should\nI describe?", "那么……\n\n8枚徽章中你想让我介绍哪一\n枚？")
    }
    badgeMenu([
      @t("BOULDERBADGE", "灰色徽章"),
      @t("CASCADEBADGE", "蓝色徽章"),
      @t("THUNDERBADGE", "橙色徽章"),
      @t("RAINBOWBADGE", "彩虹徽章"),
      @t("SOULBADGE", "灵魂徽章"),
      @t("MARSHBADGE", "粉色徽章"),
      @t("VOLCANOBADGE", "深红徽章"),
      @t("EARTHBADGE", "绿色徽章"),
      @t("CANCEL", "取消")
    ], [
      @t("The ATTACK of all POKeMON\nincreases a little bit.\n\nIt also lets you use FLASH\nany time you desire.", "所有宝可梦的攻击都会稍微提\n升。\n\n还能让你随时使用闪光！"),
      @t("POKeMON up to L30 will obey\nyou.\n\nAny higher, they become\nunruly!\n\nIt also lets you use CUT\noutside of battle.", "30级以下的宝可梦会服从你。\n\n再高的等级，它们会变得不听\n话！\n\n还能在战斗之外使用居合斩。"),
      @t("The SPEED of all POKeMON\nincreases a little bit.\n\nIt also lets you use FLY\noutside of battle.", "所有宝可梦的速度都会稍微提\n升。\n\n还能在战斗之外使用飞翔。"),
      @t("POKeMON up to L50 will obey\nyou.\n\nAny higher, they become\nunruly!\n\nIt also lets you use\nSTRENGTH out- side of\nbattle.", "50级以下的宝可梦会服从你。\n\n再高的等级，它们会变得不听\n话！\n\n还能在战斗之外使用怪力。"),
      @t("The DEFENSE of all POKeMON\nincreases a little bit.\n\nIt also lets you use SURF\noutside of battle.", "所有宝可梦的防御都会稍微提\n升。\n\n还能在战斗之外使用冲浪。"),
      @t("POKeMON up to L70 will obey\nyou.\n\nAny higher, they become\nunruly!", "70级以下的宝可梦会服从你。\n\n再高的等级，它们会变得不听\n话！"),
      @t("Your POKeMON's SPECIAL\nabilities increase a bit.", "你的宝可梦的特殊能力会略微提\n升。"),
      @t("All POKeMON will obey you!", "所有宝可梦都会服从你！")
    ], [
      hasBadge("BOULDERBADGE"),
      hasBadge("CASCADEBADGE"),
      hasBadge("THUNDERBADGE"),
      hasBadge("RAINBOWBADGE"),
      hasBadge("SOULBADGE"),
      hasBadge("MARSHBADGE"),
      hasBadge("VOLCANOBADGE"),
      hasBadge("EARTHBADGE")
    ])
    @speaker("") {
      @t("Come visit me any time you\nwish.", "欢迎随时来找我。")
    }
  }
}
