      }
      @if (getFlag("EVENT_BEAT_BLAINE")) {
        playSound("SFX_GET_ITEM_1")
        @speaker("") { @t("Oh! That is the\nVOLCANOBADGE!", "哦！那是深红徽章！") }
        @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
        setFlag("EVENT_PASSED_VOLCANOBADGE_CHECK")
      } @else {
        playSound("SFX_DENIED")
        @speaker("") {
          @t("You don't have the\nVOLCANOBADGE yet!\n\nYou have to have it to get\nto POKeMON LEAGUE!", "你还没有深红徽章！\n\n没有它就无法前往宝可梦联盟！")
