    } @else {
      @speaker("") {
        @t("You can pass here only if\nyou have the SOULBADGE!", "只有持有灵魂徽章才能从这里通\n过！")
      }
      @if (getFlag("EVENT_BEAT_KOGA")) {
        playSound("SFX_GET_ITEM_1")
        @speaker("") { @t("Oh! That is the SOULBADGE!", "哦！那是灵魂徽章！") }
        @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
        setFlag("EVENT_PASSED_SOULBADGE_CHECK")
      } @else {
        playSound("SFX_DENIED")
        @speaker("") {
          @t("You don't have the SOULBADGE\nyet!\n\nYou have to have it to get\nto POKeMON LEAGUE!", "你还没有灵魂徽章！\n\n没有它就无法前往宝可梦联盟！")
        }
        // Original Route23MovePlayerDownScript: one-step PAD_DOWN push-back.
        movePlayerRelative(["down"])
      }
    }
  }

  // ── Checkpoint 5: Guard (npc 5) — RAINBOWBADGE ───────────────────────────
  @storyline("talkGuard3") {
    @trigger(map = "Route23", npc = 5)
    @if (getFlag("EVENT_PASSED_RAINBOWBADGE_CHECK")) {
      @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
    } @else {
      @speaker("") {
        @t("You can pass here only if\nyou have the RAINBOWBADGE!", "只有持有彩虹徽章才能从这里通\n过！")
      }
      @if (getFlag("EVENT_BEAT_ERIKA")) {
        playSound("SFX_GET_ITEM_1")
        @speaker("") { @t("Oh! That is the\nRAINBOWBADGE!", "哦！那是彩虹徽章！") }
        @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
        setFlag("EVENT_PASSED_RAINBOWBADGE_CHECK")
      } @else {
        playSound("SFX_DENIED")
        @speaker("") {
          @t("You don't have the\nRAINBOWBADGE yet!\n\nYou have to have it to get\nto POKeMON LEAGUE!", "你还没有彩虹徽章！\n\n没有它就无法前往宝可梦联盟！")
        }
        // Original Route23MovePlayerDownScript: one-step PAD_DOWN push-back.
        movePlayerRelative(["down"])
      }
    }
  }

