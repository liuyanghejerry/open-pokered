  @storyline("talkGuard4") {
    @trigger(map = "Route23", npc = 6)
    @if (getFlag("EVENT_PASSED_THUNDERBADGE_CHECK")) {
      @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
    } @else {
      @speaker("") {
        @t("You can pass here only if\nyou have the THUNDERBADGE!", "只有持有橙色徽章才能从这里通\n过！")
      }
      @if (getFlag("EVENT_BEAT_LT_SURGE")) {
        playSound("SFX_GET_ITEM_1")
        @speaker("") { @t("Oh! That is the\nTHUNDERBADGE!", "哦！那是橙色徽章！") }
        @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
        setFlag("EVENT_PASSED_THUNDERBADGE_CHECK")
      } @else {
        playSound("SFX_DENIED")
        @speaker("") {
          @t("You don't have the\nTHUNDERBADGE yet!\n\nYou have to have it to get\nto POKeMON LEAGUE!", "你还没有橙色徽章！\n\n没有它就无法前往宝可梦联盟！")
        }
        // Original Route23MovePlayerDownScript: one-step PAD_DOWN push-back.
        movePlayerRelative(["down"])
      }
    }
  }

  // ── Checkpoint 7: Guard (npc 7) — CASCADEBADGE ───────────────────────────
  @storyline("talkGuard5") {
    @trigger(map = "Route23", npc = 7)
    @if (getFlag("EVENT_PASSED_CASCADEBADGE_CHECK")) {
      @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
    } @else {
      @speaker("") {
        @t("You can pass here only if\nyou have the CASCADEBADGE!", "只有持有蓝色徽章才能从这里通\n过！")
      }
      @if (getFlag("EVENT_BEAT_MISTY")) {
        playSound("SFX_GET_ITEM_1")
        @speaker("") { @t("Oh! That is the\nCASCADEBADGE!", "哦！那是蓝色徽章！") }
        @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
        setFlag("EVENT_PASSED_CASCADEBADGE_CHECK")
