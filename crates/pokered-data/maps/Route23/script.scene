// Route23 — translated from the original disassembly (scripts/Route23.asm,
// text/Route23.asm) to the real Game DSL API surface.
//
// Route23 is the Victory Road Gate route: a one-way climb to the POKeMON LEAGUE
// guarded by seven badge checkpoints (5 Guards + 2 Swimmers). Each checkpoint
// demands a specific badge — in descending League order from south to north:
//   npc1 EARTHBADGE, npc2 VOLCANOBADGE, npc3 MARSHBADGE, npc4 SOULBADGE,
//   npc5 RAINBOWBADGE, npc6 THUNDERBADGE, npc7 CASCADEBADGE.
//
// There is no badge-query API, so "has badge X" is approximated by the
// gym-beaten event flag the corresponding gym scene already sets
// (e.g. CASCADEBADGE <- EVENT_BEAT_MISTY). Passing a checkpoint sets the
// original EVENT_PASSED_*_CHECK flag. The original's forced push-back on a
// failed check is a fixed single-step DOWN push, reproduced with
// movePlayerRelative (DENIED sound + refusal text included).

game_scene Route23 {
  // ── Checkpoint 1: Guard (npc 1) — EARTHBADGE ─────────────────────────────
  @storyline("talkGuard1") {
    @trigger(map = "Route23", npc = 1)
    @if (getFlag("EVENT_PASSED_EARTHBADGE_CHECK")) {
      @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
    } @else {
      @speaker("") {
        @t("You can pass here only if\nyou have the EARTHBADGE!", "只有持有绿色徽章才能从这里通\n过！")
      }
      @if (getFlag("EVENT_BEAT_VIRIDIAN_GYM_GIOVANNI")) {
        playSound("SFX_GET_ITEM_1")
        @speaker("") { @t("Oh! That is the EARTHBADGE!", "哦！那是绿色徽章！") }
        @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
        setFlag("EVENT_PASSED_EARTHBADGE_CHECK")
      } @else {
        playSound("SFX_DENIED")
        @speaker("") {
          @t("You don't have the\nEARTHBADGE yet!\n\nYou have to have it to get\nto POKeMON LEAGUE!", "你还没有绿色徽章！\n\n没有它就无法前往宝可梦联盟！")
        }
        // Original Route23MovePlayerDownScript: one-step PAD_DOWN push-back.
        movePlayerRelative(["down"])
      }
    }
  }

  // ── Checkpoint 2: Guard (npc 2) — VOLCANOBADGE ───────────────────────────
  @storyline("talkGuard2") {
    @trigger(map = "Route23", npc = 2)
    @if (getFlag("EVENT_PASSED_VOLCANOBADGE_CHECK")) {
      @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
    } @else {
      @speaker("") {
        @t("You can pass here only if\nyou have the VOLCANOBADGE!", "只有持有深红徽章才能从这里通\n过！")
      }
      @if (getFlag("EVENT_BEAT_BLAINE")) {
        playSound("SFX_GET_ITEM_1")
        @speaker("") { @t("Oh! That is the\nVOLCANOBADGE!", "哦！那是深红徽章！") }
        @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
        setFlag("EVENT_PASSED_VOLCANOBADGE_CHECK")
      } @else {
        playSound("SFX_DENIED")
        @speaker("") {
          @t("You don't have the\nVOLCANOBADGE yet!\n\nYou have to have it to get\nto POKeMON LEAGUE!", "你还没有深红徽章！\n\n没有它就无法前往宝可梦联盟！")
        }
        // Original Route23MovePlayerDownScript: one-step PAD_DOWN push-back.
        movePlayerRelative(["down"])
      }
    }
  }

  // ── Checkpoint 3: Swimmer (npc 3) — MARSHBADGE ───────────────────────────
  @storyline("talkSwimmer1") {
    @trigger(map = "Route23", npc = 3)
    @if (getFlag("EVENT_PASSED_MARSHBADGE_CHECK")) {
      @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
    } @else {
      @speaker("") {
        @t("You can pass here only if\nyou have the MARSHBADGE!", "只有持有粉色徽章才能从这里通\n过！")
      }
      @if (getFlag("EVENT_BEAT_SABRINA")) {
        playSound("SFX_GET_ITEM_1")
        @speaker("") { @t("Oh! That is the MARSHBADGE!", "哦！那是粉色徽章！") }
        @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
        setFlag("EVENT_PASSED_MARSHBADGE_CHECK")
      } @else {
        playSound("SFX_DENIED")
        @speaker("") {
          @t("You don't have the\nMARSHBADGE yet!\n\nYou have to have it to get\nto POKeMON LEAGUE!", "你还没有粉色徽章！\n\n没有它就无法前往宝可梦联盟！")
        }
        // Original Route23MovePlayerDownScript: one-step PAD_DOWN push-back.
        movePlayerRelative(["down"])
      }
    }
  }

  // ── Checkpoint 4: Swimmer (npc 4) — SOULBADGE ────────────────────────────
  @storyline("talkSwimmer2") {
    @trigger(map = "Route23", npc = 4)
    @if (getFlag("EVENT_PASSED_SOULBADGE_CHECK")) {
