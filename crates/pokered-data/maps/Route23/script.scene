  // ── Victory Road Gate sign (sign 1) ──────────────────────────────────────
  @storyline("sign1") {
    @trigger(map = "Route23", sign = 1)
    @speaker("") { @t("VICTORY ROAD GATE - POKeMON\nLEAGUE", "冠军之路大门 - 宝可梦联盟") }
  }

  // ── On-step badge row checks (coord events) ─────────────────────────────
  // Original Route23DefaultScript: while a checkpoint's EVENT_PASSED_*_CHECK is
  // unset, stepping onto that guard's map row runs the same badge check as the
  // talk handler — the guards stand BESIDE the corridor, so without this row
  // check the player can simply walk past them. The trigger tiles enumerate
  // every reachable (walkable / surfable) tile of each guard row, matching the
  // original's whole-row check; row 35 additionally stops at x<14 like the
  // original (the x>=14 plateau is past the checkpoint). Badge ownership is
  // queried directly with hasBadge (wObtainedBadges), exactly like the
  // original's wObtainedBadges bit test.
  @storyline("guardRowEarth") {
    @trigger(map = "Route23", name = "guardRowEarth1", coords = [[0, 35], [1, 35], [2, 35], [3, 35], [4, 35], [5, 35], [6, 35], [7, 35]])
    @if (!getFlag("EVENT_PASSED_EARTHBADGE_CHECK")) {
      @if (hasBadge("EARTHBADGE")) {
        playSound("SFX_GET_ITEM_1")
        @speaker("") { @t("Oh! That is the EARTHBADGE!", "哦！那是绿色徽章！") }
        @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
        setFlag("EVENT_PASSED_EARTHBADGE_CHECK")
      } @else {
        playSound("SFX_DENIED")
        @speaker("") {
          @t("You don't have the\nEARTHBADGE yet!\n\nYou have to have it to get\nto POKeMON LEAGUE!", "你还没有绿色徽章！\n\n没有它就无法前往宝可梦联盟！")
        }
        // Original Route23MovePlayerDownScript: one-step PAD_DOWN push-back.
        movePlayerRelative(["down"])
      }
    }
  }

