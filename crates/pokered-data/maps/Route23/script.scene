// Route23 — translated from the original disassembly (scripts/Route23.asm,
// text/Route23.asm) to the real Game DSL API surface.
//
// Route23 is the Victory Road Gate route: a one-way climb to the POKeMON LEAGUE
// guarded by seven badge checkpoints (5 Guards + 2 Swimmers). Each checkpoint
// demands a specific badge — in descending League order from south to north:
//   npc1 EARTHBADGE, npc2 VOLCANOBADGE, npc3 MARSHBADGE, npc4 SOULBADGE,
//   npc5 RAINBOWBADGE, npc6 THUNDERBADGE, npc7 CASCADEBADGE.
//
// There is a badge-query API now (hasBadge); the talk handlers below predate it
// and approximate "has badge X" with the gym-beaten event flag the corresponding
// gym scene already sets (e.g. CASCADEBADGE <- EVENT_BEAT_MISTY). The on-step
// row checks (guardRow* storylines, added after the sign) use hasBadge directly.
// Passing a checkpoint sets the original EVENT_PASSED_*_CHECK flag. The
// original's forced push-back on a failed check is a fixed single-step DOWN
// push, reproduced with movePlayerRelative (DENIED sound + refusal text
// included).

game_scene Route23 {
  // ── Checkpoint 1: Guard (npc 1) — EARTHBADGE ─────────────────────────────
  @storyline("talkGuard1") {
    @trigger(map = "Route23", npc = 1)
    @if (getFlag("EVENT_PASSED_EARTHBADGE_CHECK")) {
      @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
    } @else {
      @speaker("") {
        @t("You can pass here only if\nyou have the EARTHBADGE!", "只有持有绿色徽章才能从这里通\n过！")
      }
      @if (getFlag("EVENT_BEAT_VIRIDIAN_GYM_GIOVANNI")) {
        playSound("SFX_GET_ITEM_1")
        @speaker("") { @t("Oh! That is the EARTHBADGE!", "哦！那是绿色徽章！") }
        @speaker("") { @t("OK then! Please, go right\nahead!", "那好！请吧，尽管往前走吧！") }
        setFlag("EVENT_PASSED_EARTHBADGE_CHECK")
      } @else {
        playSound("SFX_DENIED")
        @speaker("") {
          @t("You don't have the\nEARTHBADGE yet!\n\nYou have to have it to get\nto POKeMON LEAGUE!", "你还没有绿色徽章！\n\n没有它就无法前往宝可梦联盟！")
        }
        // Original Route23MovePlayerDownScript: one-step PAD_DOWN push-back.
        movePlayerRelative(["down"])
      }
    }
  }

