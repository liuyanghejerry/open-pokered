// VermilionOldRodHouse: original gift status precedes all receipt paragraphs.
game_scene VermilionOldRodHouse {
  @storyline("talkFishingGuru") {
    @trigger(map = "VermilionOldRodHouse", npc = 1)
    @if (getFlag("EVENT_GOT_OLD_ROD")) {
      printFieldTextParts([
        t("Hello there, <PLAYER>!", "你好啊， <PLAYER>！"),
        t("How are the fish biting?", "鱼上钩的情况怎么样？")
      ], false)
    } @else {
      answer = askFieldYesNo(t("I'm the FISHING GURU!\n\nI simply Looove fishing!\n\nDo you like to fish?", "我就是垂钓大师！\n\n我超喜欢钓鱼！\n\n你喜欢钓鱼吗？"), t("YES", "是"), t("NO", "否"))
      @if (answer == 0) {
        given = giveItem("OLD_ROD", 1)
        @if (given) {
          setFlag("EVENT_GOT_OLD_ROD")
          printItemFieldTextParts([
            t("Grand! I like your style!", "太棒了！我喜欢你的风格！"),
            t("Take this and fish, young\none!", "拿上这个去钓鱼吧，年轻人！"),
            t("<PLAYER> received an OLD\nROD!", "<PLAYER>获得了破旧钓竿！")
          ], "SFX_GET_ITEM_1", false)
          continueFieldTextParts([
            t("Fishing is a way of life!", "钓鱼是一种生活方式！"),
            t("From the seas to rivers, go\nout and land the big one,\nyoung one!", "从大海到河流，出去钓上一条大\n家伙吧，年轻人！")
          ], false)
        } @else {
          printFieldTextParts([
            t("Oh no!", "哎呀！"),
            t("You have no room for my\ngift!", "你没有空间装下我的礼物了！")
          ], false)
        }
      } @else {
        printFieldTextParts([
          t("Oh... That's so\ndisappointing...", "哦……真令人失望……")
        ], false)
      }
    }
    acknowledgeFieldText()
  }
}
