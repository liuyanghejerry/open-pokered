// Refactored from PewterPokecenter/script.js to dotzuki-engine-dsl.
// Nurse continuation follows engine/events/pokecenter.asm.

game_scene PewterPokecenter {
  @storyline("talkNurse") {
    @trigger(map = "PewterPokecenter", npc = 1)
    // DisplayPokemonCenterDialogue_: inner PROMPT, optional paused DONE, HEAL/CANCEL.
    answer = pokecenterNurseOffer(getPokecenterUsed(), @t("Welcome to our POKeMON\nCENTER!", "欢迎来到宝可梦中心！"), @t("We heal your POKeMON back to\nperfect health!", "我们会让你的宝可梦恢复最佳状\n态！"), @t("Shall we heal your POKeMON?", "要为你治疗宝可梦吗？"), @t("HEAL", "治疗"), @t("CANCEL", "取消"))
    @if (answer == 0) {
      printFieldText(@t("OK. We'll need your\nPOKeMON.", "好的，请把宝可梦交给我。"), true)
      faceNpc("1", "left")
      delay(3)
      heal()
      animateHealingMachine()
      printFieldText(@t("Thank you!\nYour POKeMON are\nfighting fit!", "谢谢你的等待。\n\n你的宝可梦已完全恢复了！"), true, "prompt")
      setNpcFrame("1", 1)
      delay(20)
    }
    pokecenterFarewell(@t("We hope to see you again!", "期待你再次光临！"))
    faceNpc("1", "down")
  }

  @storyline("talkGentleman") {
    @trigger(map = "PewterPokecenter", npc = 2)
    @speaker("") { @t("What!?\n\nTEAM ROCKET is at MT.MOON?\nHuh? I'm on the phone!\n\nScram!", "什么！？\n\n火箭队竟然在月见山？嗯？我在\n打电话！\n\n快走开！") }
  }

  @storyline("talkFairy") {
    @trigger(map = "PewterPokecenter", npc = 3)
    jigglypuffSong(@t("JIGGLYPUFF: Puu pupuu!", "胖丁：噗噗噗！"), "3")
  }

  @storyline("talkLinkReceptionist") {
    @trigger(map = "PewterPokecenter", npc = 4)
    @speaker("") { @t("Welcome to the\nCable Club!", "欢迎来到通信俱乐部！") }
    linkStart()
  }

  // ── Pokémon Center PC (sign 1 at 13,3) ───────────────────────────────
  // engine/menus/pc.asm ActivatePC: BILL's PC / item PC / PROF.OAK's PC.
  @storyline("pcStorage") {
    @trigger(map = "PewterPokecenter", sign = 1)
    openPC()
  }


  // ── Bench guy (sign 2 at (0,4)) — PrintBenchGuyText ────────────────────
  // data/events/bench_guys.asm + hidden_events.asm: A on the (0,4) bench
  // tile while facing it; BenchGuyTextPointers requires SPRITE_FACING_LEFT,
  // so gate on the player's facing (getPlayerFacing() -> down/up/left/right).
  @storyline("benchGuy") {
    @trigger(map = "PewterPokecenter", sign = 2)
    @if (getPlayerFacing() == "left") {
      @speaker("") {
        @t("Yawn!

When JIGGLYPUFF
sings, #MON
get drowsy...

...Me too...
Snore...", "哈欠！\n\n胖丁一唱歌，\n宝可梦就犯困了……\n\n我也是……\n呼噜……")
      }
    }
  }
}
