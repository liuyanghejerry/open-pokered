// Route18Gate1F — translated from the original disassembly
// (scripts/Route18Gate1F.asm, text/Route18Gate1F.asm) to the real Game DSL API.
// This is the Cycling Road north gate: an item-gate (BICYCLE) guard. The guard's
// dialogue branches on whether the player owns a BICYCLE, and an on-approach coord
// script stops a bike-less player and turns them back (forced movement via
// movePlayerRelative + coordEvents).

game_scene Route18Gate1F {
  // ── Guard (npc 1) — item gate on BICYCLE ───────────────────────────────
  @storyline("talkGuard") {
    @trigger(map = "Route18Gate1F", npc = 1)
    @if (hasItem("BICYCLE")) {
      @speaker("") { @t("CYCLING ROAD is all uphill\nfrom here.", "自行车道从这里开始全是上坡\n路。") }
    } @else {
      @speaker("") { @t("You need a BICYCLE for\nCYCLING ROAD!", "去自行车道需要自行车！") }
    }
  }

  // ── Approach-the-counter coord script (DefaultScript) ──────────────────
  // Original Route18Gate1FDefaultScript: if the player has no BICYCLE and steps
  // onto the tiles leading to the Cycling Road exit ((4,3)-(4,6)), the guard
  // calls "Excuse me!" and the player is forced back via simulated joypad
  // input: PAD_UP x (coordIndex-1) — 3 ups from (4,6), 2 from (4,5), 1 from
  // (4,4), none from (4,3) — landing on (4,3) next to the counter. Then
  // Route18Gate1FGuardScript shows the guard's no-bike line and forces a single
  // PAD_RIGHT step out of the corridor (see Route18Gate1FPlayerMovingUpScript /
  // _GuardScript / _PlayerMovingRightScript).
  @storyline("guardExcuseMe") {
    @trigger(map = "Route18Gate1F", name = "guardExcuseMe1")
    @if (!hasItem("BICYCLE")) {
      @speaker("") { @t("Excuse me!", "喂，等一下！") }
      // Walk UP to (4,3) beside the counter: (4,6) -> 3 ups, (4,5) -> 2 ups,
      // (4,4) -> 1 up, (4,3) -> already there.
      @if (getPlayerY() == 6) {
        movePlayerRelative([[0, -1], [0, -1], [0, -1]])
      } @else @if (getPlayerY() == 5) {
        movePlayerRelative([[0, -1], [0, -1]])
      } @else @if (getPlayerY() == 4) {
        movePlayerRelative([[0, -1]])
      }
      // Guard's follow-up text (TEXT_ROUTE18GATE1F_GUARD, no-bike branch),
      // then one RIGHT step out of the corridor.
      @speaker("") { @t("You need a BICYCLE for\nCYCLING ROAD!", "去自行车道需要自行车！") }
      movePlayerRelative([[1, 0]])
    }
  }
}
