// Route22Gate — translated from the original disassembly
// (scripts/Route22Gate.asm, text/Route22Gate.asm) to the real Game DSL API.
// This is the checkpoint gate north of Viridian, on the way to the POKeMON
// LEAGUE (Route 22 -> Route 23). The guard blocks passage unless the player
// has the BOULDERBADGE. SCRIPT_ROUTE22GATE_NOOP mirrors the original saved
// wRoute22GateCurScript = 2: once admitted, crossing the line is silent even
// on later visits, while talking to the guard still checks the badge.

game_scene Route22Gate {
  // ── Guard (npc 1) — badge gate on the BOULDERBADGE ─────────────────────
  // Talking to the guard runs the same check the gate threshold does.
  @storyline("talkGuard") {
    @trigger(map = "Route22Gate", npc = 1)
    @if (hasBadge("BOULDERBADGE")) {
      showItemDialogue(@t("Oh! That is the\nBOULDERBADGE! Go right\nahead!", "哦！那是灰色徽章！请过去吧！"))
      setFlag("SCRIPT_ROUTE22GATE_NOOP")
    } @else {
      @speaker("") {
        @t("Only truly skilled trainers\nare allowed through.\n\nYou don't have the\nBOULDERBADGE yet!", "只有真正高强的训练家才能通过\n这里。\n\n你还没有灰色徽章！")
      }
      waitSound()
      playSound("SFX_DENIED")
      waitSound()
      @speaker("") {
        @t("The rules are rules. I can't\nlet you pass.", "规矩就是规矩，我不能让你过\n去。")
      }
      resetFlag("SCRIPT_ROUTE22GATE_NOOP")
      movePlayerRelative([[0, 1]])
      route22GuardReturn()
    }
  }

  // ── Gate threshold (Route22GateDefaultScript) ──────────────────────────
  // Stepping onto the counter tiles (x=4..5, y=2) makes the guard call out.
  // Both entry lanes run the guard's check until the first admission.
  @storyline("gateThreshold") {
    @trigger(map = "Route22Gate", name = "gateThreshold1")
    @if (!getFlag("SCRIPT_ROUTE22GATE_NOOP")) {
      @if (hasBadge("BOULDERBADGE")) {
        showItemDialogue(@t("Oh! That is the\nBOULDERBADGE! Go right\nahead!", "哦！那是灰色徽章！请过去吧！"))
        setFlag("SCRIPT_ROUTE22GATE_NOOP")
      } @else {
        @speaker("") {
          @t("Only truly skilled trainers\nare allowed through.\n\nYou don't have the\nBOULDERBADGE yet!", "只有真正高强的训练家才能通过\n这里。\n\n你还没有灰色徽章！")
        }
        waitSound()
        playSound("SFX_DENIED")
        waitSound()
        @speaker("") {
          @t("The rules are rules. I can't\nlet you pass.", "规矩就是规矩，我不能让你过\n去。")
        }
        // Original simulates DOWN x1 from either trigger tile.
        movePlayerRelative([[0, 1]])
        route22GuardReturn()
      }
    }
  }
}
