  "text": {
    "npc": {
      "1": [
        {
          "line1": "Whew... I better",
          "line2": "take a rest..."
        },
        {
          "line1": "Groan...",
          "line2": ""
        },
        {
          "line1": "That tunnel from",
          "line2": "CERULEAN takes a"
        },
        {
          "line1": "lot out of you!",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "Hey! I met you in",
          "line2": "VIRIDIAN FOREST!"
        }
      ],
      "2_Defeated": [
        {
          "line1": "You",
          "line2": "beat me again!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "There are other",
          "line2": "kinds of #MON"
        },
        {
          "line1": "than those found",
          "line2": "in the forest!"
        }
      ],
      "3": [
        {
          "line1": "Hi! I like shorts!",
          "line2": "They're comfy and"
        },
        {
          "line1": "easy to wear!",
          "line2": ""
        }
      ],
      "3_Defeated": [
        {
          "line1": "I don't",
          "line2": "believe it!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "Are you storing",
          "line2": "your #MON on"
        },
        {
          "line1": "PC? Each BOX can",
          "line2": "hold 20 #MON!"
        }
      ],
      "4": [
        {
          "line1": "You looked at me,",
          "line2": "didn't you?"
        }
      ],
      "4_Defeated": [
        {
          "line1": "You're",
          "line2": "mean!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "Quit staring if",
          "line2": "you don't want to"
        },
        {
          "line1": "fight!",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "Are you a trainer?",
          "line2": "Let's fight!"
        }
      ],
      "5_Defeated": [
        {
          "line1": "If I",
          "line2": "had new #MON I"
        },
        {
          "line1": "would've won!",
          "line2": ""
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "If a #MON BOX",
          "line2": "on the PC gets"
        },
        {
          "line1": "full, just switch",
          "line2": "to another BOX!"
        }
      ],
      "6": [
        {
          "line1": "That look you",
          "line2": "gave me, it's so"
        },
        {
          "line1": "intriguing!",
          "line2": ""
        }
      ],
      "6_Defeated": [
        {
          "line1": "Be nice!",
          "line2": ""
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "Avoid fights by",
          "line2": "not letting"
        },
        {
          "line1": "people see you!",
          "line2": ""
        }
      ],
      "7": [
        {
          "line1": "Hey! You're not",
          "line2": "wearing shorts!"
        }
      ],
      "7_Defeated": [
        {
          "line1": "Lost!",
          "line2": "Lost! Lost!"
        }
      ],
      "7_AfterBattle": [
        {
          "line1": "I always wear",
          "line2": "shorts, even in"
        },
        {
          "line1": "winter!",
          "line2": ""
        }
      ],
      "8": [
        {
          "line1": "You can fight my",
          "line2": "new #MON!"
        }
      ],
      "8_Defeated": [
        {
          "line1": "Done",
          "line2": "like dinner!"
        }
      ],
      "8_AfterBattle": [
        {
          "line1": "Trained #MON",
          "line2": "are stronger than"
        },
        {
          "line1": "the wild ones!",
          "line2": ""
        }
      ],
      "9": [
        {
          "line1": "Eek! Did you",
          "line2": "touch me?"
        }
      ],
      "9_Defeated": [
        {
          "line1": "That's it?",
          "line2": ""
        }
      ],
      "9_AfterBattle": [
        {
          "line1": "ROUTE 4 is at the",
          "line2": "foot of MT.MOON."
        }
      ]
    },
