  "text": {
    "npc": {
      "1": [
        {
          "line1": "Whew! I'm trying",
          "line2": "to memorize all"
        },
        {
          "line1": "my notes.",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "Okay!",
          "line2": ""
        },
        {
          "line1": "Be sure to read",
          "line2": "the blackboard"
        },
        {
          "line1": "carefully!",
          "line2": ""
        }
      ]
    },
    "sign": {
      "1": [
        {
          "line1": "Looked at the notebook!",
          "line2": ""
        },
        {
          "line1": "First page...",
          "line2": ""
        },
        {
          "line1": "# BALLs are used to catch POKeMON.",
          "line2": "Up to 6 POKeMON can be carried."
        },
        {
          "line1": "People who raise and make POKeMON fight are called POKeMON trainers.",
          "line2": ""
        },
        {
          "line1": "Second page...",
          "line2": ""
        },
        {
          "line1": "A healthy POKeMON may be hard to catch, so weaken it first!",
          "line2": "Poison, burns and other damage are effective!"
        },
        {
          "line1": "Third page...",
          "line2": ""
        },
        {
          "line1": "POKeMON trainers seek others to engage in POKeMON fights.",
          "line2": "Battles are constantly fought at POKeMON GYMs."
        },
        {
          "line1": "Fourth page...",
          "line2": ""
        },
        {
          "line1": "The goal for POKeMON trainers is to beat the top 8 POKeMON GYM LEADERs.",
          "line2": "Do so to earn the right to face..."
        },
        {
          "line1": "The ELITE FOUR of POKeMON LEAGUE!",
          "line2": ""
        },
        {
          "line1": "GIRL: Hey! Don't look at my notes!",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "",
          "line2": ""
        }
      ]
    }
