// Refactored from CeruleanPokecenter/script.js to dotzuki-engine-dsl.
// Nurse continuation follows engine/events/pokecenter.asm.

game_scene CeruleanPokecenter {
  @storyline("talkNurse") {
    @trigger(map = "CeruleanPokecenter", npc = 1)
    // DisplayPokemonCenterDialogue_: inner PROMPT, optional paused DONE, HEAL/CANCEL.
    answer = pokecenterNurseOffer(getPokecenterUsed(), @t("Welcome to our POKeMON\nCENTER!", "欢迎光临宝可梦中心！"), @t("We heal your POKeMON back to\nperfect health!", "我们会把你的宝可梦恢复到最佳\n状态！"), @t("Shall we heal your POKeMON?", "要为你治疗宝可梦吗？"), @t("HEAL", "治疗"), @t("CANCEL", "取消"))
    @if (answer == 0) {
      printFieldText(@t("OK. We'll need your\nPOKeMON.", "OK，请把你的宝可梦交给我。"), true)
      faceNpc("1", "left")
      delay(3)
      heal()
      animateHealingMachine()
      printFieldText(@t("Thank you!\nYour POKeMON are\nfighting fit!", "感谢您的耐心等待。\n\n你的宝可梦已完全治愈！"), true, "prompt")
      setNpcFrame("1", 1)
      delay(20)
    }
    pokecenterFarewell(@t("We hope to see you again!", "欢迎下次再来！"))
    faceNpc("1", "down")
  }

  @storyline("talkSuperNerd") {
    @trigger(map = "CeruleanPokecenter", npc = 2)
    @speaker("") { @t("That BILL!\n\nI heard that he'll do\nwhatever it takes to get\nrare POKEMON!", "那个正辉！\n\n我听说他为了得到稀有的宝可梦\n什么都干得出来！") }
  }

  @storyline("talkGentleman") {
    @trigger(map = "CeruleanPokecenter", npc = 3)
    @speaker("") { @t("Have you heard about BILL?\n\nEveryone calls him a\nPOKEMANIAC!\n\nI think people are just\njealous of BILL, though.\n\nWho wouldn't want to boast\nabout their POKEMON?", "你听说过正辉吗？\n\n大家都叫他宝可梦狂！\n\n不过我觉得人们只是嫉妒正辉罢\n了。\n\n谁不想炫耀自己的宝可梦呢？") }
  }

  @storyline("talkLinkReceptionist") {
    @trigger(map = "CeruleanPokecenter", npc = 4)
    @speaker("") { @t("Welcome to the\nCable Club!", "欢迎来到联机俱乐部！") }
    linkStart()
  }

  // ── Pokémon Center PC (sign 1 at 13,3) ───────────────────────────────
  // engine/menus/pc.asm ActivatePC: BILL's PC / item PC / PROF.OAK's PC.
  @storyline("pcStorage") {
    @trigger(map = "CeruleanPokecenter", sign = 1)
    openPC()
  }


  // ── Bench guy (sign 2 at (0,4)) — PrintBenchGuyText ────────────────────
  // data/events/bench_guys.asm + hidden_events.asm: A on the (0,4) bench
  // tile while facing it; BenchGuyTextPointers requires SPRITE_FACING_LEFT,
  // so gate on the player's facing (getPlayerFacing() -> down/up/left/right).
  @storyline("benchGuy") {
    @trigger(map = "CeruleanPokecenter", sign = 2)
    @if (getPlayerFacing() == "left") {
      @speaker("") {
        @t("BILL has lots of
#MON!

He collects rare
ones too!", "正辉有很多\n宝可梦！\n\n他还专门收集\n稀有的呢！")
      }
    }
  }
}
