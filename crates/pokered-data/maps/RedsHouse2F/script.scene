// RedsHouse2F — translated from the original disassembly
// (scripts/RedsHouse2F.asm, text/RedsHouse2F.asm, data/maps/objects/RedsHouse2F.asm).
// RedsHouse2FDefaultScript faces UP once, then stores SCRIPT_REDSHOUSE2F_NOOP
// in its original saved script byte. Later entries leave the arrival facing alone.

game_scene RedsHouse2F {
  @load {
    @if (!getFlag("SCRIPT_REDSHOUSE2F_NOOP")) {
      facePlayer("up")
      setFlag("SCRIPT_REDSHOUSE2F_NOOP")
    }
  }

  // ── Red's bedroom PC (sign 1 at 0,1) ─────────────────────────────────
  // hidden_events.asm OpenRedsPC → players_pc.asm PlayerPC (item storage).
  @storyline("bedroomPC") {
    @trigger(map = "RedsHouse2F", sign = 1)
    openItemPC()
  }
}
