  "text": {
    "npc": {
      "1": [
        {
          "line1": "<RIVAL>: Yo!",
          "line2": "<PLAYER>!"
        },
        {
          "line1": "You're still",
          "line2": "struggling along"
        },
        {
          "line1": "back here?",
          "line2": ""
        },
        {
          "line1": "I'm doing great!",
          "line2": "I caught a bunch"
        },
        {
          "line1": "of strong and",
          "line2": "smart #MON!"
        },
        {
          "line1": "Here, let me see",
          "line2": "what you caught,"
        },
        {
          "line1": "<PLAYER>!",
          "line2": ""
        }
      ],
      "1_AfterBeat": [
        {
          "line1": "<RIVAL>: Hey,",
          "line2": "guess what?"
        },
        {
          "line1": "I went to BILL's",
          "line2": "and got him to"
        },
        {
          "line1": "show me his rare",
          "line2": "#MON!"
        },
        {
          "line1": "That added a lot",
          "line2": "of pages to my"
        },
        {
          "line1": "#DEX!",
          "line2": ""
        },
        {
          "line1": "After all, BILL's",
          "line2": "world famous as a"
        },
        {
          "line1": "#MANIAC!",
          "line2": ""
        },
        {
          "line1": "He invented the",
          "line2": "#MON Storage"
        },
        {
          "line1": "System on PC!",
          "line2": ""
        },
        {
          "line1": "Since you're using",
          "line2": "his system, go"
        },
        {
          "line1": "thank him!",
          "line2": ""
        },
        {
          "line1": "Well, I better",
          "line2": "get rolling!"
        },
        {
          "line1": "Smell ya later!",
          "line2": ""
        }
      ],
      "script_RivalDefeated": [
        {
          "line1": "Hey!",
          "line2": "Take it easy!"
        },
        {
          "line1": "You won already!",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "Hey! Stay out!",
          "line2": "It's not your"
        },
        {
          "line1": "yard! Huh? Me?",
          "line2": ""
        },
        {
          "line1": "I'm an innocent",
          "line2": "bystander! Don't"
        },
        {
          "line1": "you believe me?",
          "line2": ""
        }
      ],
      "2_Defeated": [
        {
          "line1": "Stop!",
          "line2": "I give up! I'll"
        },
        {
          "line1": "leave quietly!",
          "line2": ""
        }
      ],
      "2_ReturnTM": [
        {
          "line1": "OK! I'll return",
          "line2": "the TM I stole!"
        }
      ],
      "2_ReceivedTM28": [
        {
          "line1": "<PLAYER> recovered",
          "line2": "TM28!"
        }
      ],
      "2_NoRoom": [
        {
          "line1": "Make room for",
          "line2": "this!"
        },
        {
          "line1": "I can't run until",
          "line2": "I give it to you!"
        }
      ],
      "2_IBetterGetMoving": [
        {
          "line1": "I better get",
          "line2": "moving! Bye!"
        }
      ],
      "3": [
        {
          "line1": "You're a trainer",
          "line2": "too? Collecting,"
        },
        {
          "line1": "fighting, it's a",
          "line2": "tough life."
        }
      ],
      "4": [
        {
          "line1": "That bush in",
          "line2": "front of the shop"
        },
        {
          "line1": "is in the way.",
          "line2": ""
        },
        {
          "line1": "There might be a",
          "line2": "way around."
        }
      ],
      "5": [
        {
          "line1": "You're making an",
          "line2": "encyclopedia on"
        },
        {
          "line1": "#MON? That",
          "line2": "sounds amusing."
        }
      ],
      "6": [
        {
          "line1": "The people here",
          "line2": "were robbed."
        },
        {
          "line1": "It's obvious that",
          "line2": "TEAM ROCKET is"
        },
        {
          "line1": "behind this most",
          "line2": "heinous crime!"
        },
        {
          "line1": "Even our POLICE",
          "line2": "force has trouble"
        },
        {
          "line1": "with the ROCKETs!",
          "line2": ""
        }
      ],
      "7": [
        {
          "line1": "OK! SLOWBRO!",
          "line2": "Use SONICBOOM!"
        },
        {
          "line1": "Come on, SLOWBRO",
          "line2": "pay attention!"
        }
      ],
      "7_Variant2": [
        {
          "line1": "SLOWBRO punch!",
          "line2": "No! You blew it"
        },
        {
          "line1": "again!",
          "line2": ""
        }
      ],
      "7_Variant3": [
        {
          "line1": "SLOWBRO, WITHDRAW!",
          "line2": "No! That's wrong!"
        },
        {
          "line1": "It's so hard to",
          "line2": "control #MON!"
        },
        {
          "line1": "Your #MON's",
          "line2": "obedience depends"
        },
        {
          "line1": "on your abilities",
          "line2": "as a trainer!"
        }
      ],
      "8": [
        {
          "line1": "SLOWBRO took a",
          "line2": "snooze..."
        }
      ],
      "8_Variant2": [
        {
          "line1": "SLOWBRO is",
          "line2": "loafing around..."
        }
      ],
      "8_Variant3": [
        {
          "line1": "SLOWBRO turned",
          "line2": "away..."
        }
      ],
      "8_Variant4": [
        {
          "line1": "SLOWBRO",
          "line2": "ignored orders..."
        }
      ],
      "9": [
        {
          "line1": "I want a bright",
          "line2": "red BICYCLE!"
        },
        {
          "line1": "I'll keep it at",
          "line2": "home, so it won't"
        },
        {
          "line1": "get dirty!",
          "line2": ""
        }
      ],
      "10": [
        {
          "line1": "This is CERULEAN",
          "line2": "CAVE! Horribly"
        },
        {
          "line1": "strong #MON",
          "line2": "live in there!"
        },
        {
          "line1": "The #MON LEAGUE",
          "line2": "champion is the"
        },
        {
          "line1": "only person who",
          "line2": "is allowed in!"
        }
      ],
      "11": [
        {
          "line1": "The people here",
          "line2": "were robbed."
        },
        {
          "line1": "It's obvious that",
          "line2": "TEAM ROCKET is"
        },
        {
          "line1": "behind this most",
          "line2": "heinous crime!"
        },
        {
          "line1": "Even our POLICE",
          "line2": "force has trouble"
        },
        {
          "line1": "with the ROCKETs!",
          "line2": ""
        }
      ]
    },
    "sign": {
      "1": [
        {
          "line1": "CERULEAN CITY",
          "line2": "A Mysterious,"
        },
        {
          "line1": "Blue Aura",
          "line2": "Surrounds It"
        }
      ],
      "2": [
        {
          "line1": "TRAINER TIPS",
          "line2": ""
        },
        {
          "line1": "Pressing B Button",
          "line2": "during evolution"
        },
        {
          "line1": "cancels the whole",
          "line2": "process."
        }
      ],
      "3": [
        {
          "line1": "Grass and caves",
          "line2": "handled easily!"
        },
        {
          "line1": "BIKE SHOP",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "Heal Your #MON!",
          "line2": "#MON CENTER"
        }
      ],
      "5": [
        {
          "line1": "All your item",
          "line2": "needs fulfilled!"
        },
        {
          "line1": "#MON MART",
          "line2": ""
        }
      ],
      "6": [
        {
          "line1": "CERULEAN CITY",
          "line2": "#MON GYM"
        },
        {
          "line1": "LEADER: MISTY",
          "line2": ""
        },
        {
          "line1": "The Tomboyish",
          "line2": "Mermaid!"
        }
      ]
    }
