// Route12SuperRodHouse — translated from the original disassembly
// (scripts/Route12SuperRodHouse.asm, text/Route12SuperRodHouse.asm) to the real
// Game DSL API surface. Single-NPC item-gate map: the FISHING GURU's brother
// gives the SUPER ROD via a Yes/No choice. The original gates on the
// GOT_SUPER_ROD status bit; possession is insufficient after PC storage.

game_scene Route12SuperRodHouse {
  // ── FISHING GURU's brother (npc 1) — gives the SUPER ROD ────────────────
  @storyline("talkFishingGuru") {
    @trigger(map = "Route12SuperRodHouse", npc = 1)
    @if (getFlag("EVENT_GOT_SUPER_ROD")) {
      // Already got the rod — fishing advice.
      printFieldText(@t("Hello there, <PLAYER>!", "你好呀， <PLAYER>！"))
      printFieldParagraph(@t("Use the SUPER ROD in any\nwater! You can catch\ndifferent kinds of POKeMON.", "在任何水面用厉害钓竿！能钓到\n不同种类的宝可梦。"))
      printFieldParagraph(@t("Try fishing wherever you\ncan!", "试着在任何地方钓鱼吧！"))
      finishFieldText()
    } @else {
      // Original inner PrintText returns on DONE before YesNoChoice.
      printFieldText(@t("I'm the FISHING GURU's\nbrother!", "我是垂钓大师的哥哥！"))
      printFieldParagraph(@t("I simply Looove fishing!", "我超喜欢钓鱼！"))
      printFieldParagraph(@t("Do you like to fish?", "你喜欢钓鱼吗？"))
      @choice {
        @option(@t("YES", "是")) {
          given = giveItem("SUPER_ROD", 1)
          @if (given) {
            setFlag("EVENT_GOT_SUPER_ROD")
            printFieldText(@t("Grand! I like your style!", "很好！我喜欢你的风格！"))
            printFieldParagraph(@t("Take this and fish, young\none!", "拿上这个，去钓鱼吧，少年！"))
            printFieldParagraph(@t("<PLAYER> received a SUPER\nROD!", "<PLAYER>得到了厉害钓竿！"), "SFX_GET_ITEM_1")
            printFieldParagraph(@t("Fishing is a way of life!", "钓鱼是一种生活方式！"))
            printFieldParagraph(@t("From the seas to rivers, go\nout and land the big one!", "从大海到河流，去钓上一条大家\n伙吧！"))
            finishFieldText()
          } @else {
            printFieldText(@t("Oh no!", "糟了！"))
            printFieldParagraph(@t("I had a gift for you, but\nyou have no room for it!", "我本来有礼物送你，可你没有地\n方放！"))
            finishFieldText()
          }
        }
        @option(@t("NO", "否")) {
          printFieldText(@t("Oh... That's so\ndisappointing...", "哦……真让人失望……"))
          finishFieldText()
        }
      }
    }
  }
}
