// Route12SuperRodHouse — scripts/Route12SuperRodHouse.asm and its far text.
// The status bit is set before receipt printing; its early timing is intentional.
game_scene Route12SuperRodHouse {
  @storyline("talkFishingGuru") {
    @trigger(map = "Route12SuperRodHouse", npc = 1)
    @if (getFlag("EVENT_GOT_SUPER_ROD")) {
      printFieldTextParts([
        t("Hello there, <PLAYER>!", "你好呀， <PLAYER>！"),
        t("Use the SUPER ROD in any\nwater! You can catch\ndifferent kinds of POKeMON.", "在任何水面用厉害钓竿！能钓到\n不同种类的宝可梦。"),
        t("Try fishing wherever you\ncan!", "试着在任何地方钓鱼吧！")
      ], false)
    } @else {
      // DONE returns directly to YesNoChoice, without a separate outer ACK.
      answer = askFieldYesNo(t("I'm the FISHING GURU's\nbrother!\n\nI simply Looove fishing!\n\nDo you like to fish?", "我是垂钓大师的哥哥！\n\n我超喜欢钓鱼！\n\n你喜欢钓鱼吗？"), t("YES", "是"), t("NO", "否"))
      @if (answer == 0) {
        given = giveItem("SUPER_ROD", 1)
        @if (given) {
          setFlag("EVENT_GOT_SUPER_ROD")
          printItemFieldTextParts([
            t("Grand! I like your style!", "很好！我喜欢你的风格！"),
            t("Take this and fish, young\none!", "拿上这个，去钓鱼吧，少年！"),
            t("<PLAYER> received a SUPER\nROD!", "<PLAYER>得到了厉害钓竿！")
          ], "SFX_GET_ITEM_1", false)
          // FishingWayOfLifeText starts with PARA and ends in DONE.
          continueFieldTextParts([
            t("Fishing is a way of life!", "钓鱼是一种生活方式！"),
            t("From the seas to rivers, go\nout and land the big one!", "从大海到河流，去钓上一条大家\n伙吧！")
          ], false)
        } @else {
          printFieldTextParts([
            t("Oh no!", "糟了！"),
            t("I had a gift for you, but\nyou have no room for it!", "我本来有礼物送你，可你没有地\n方放！")
          ], false)
        }
      } @else {
        printFieldTextParts([t("Oh... That's so\ndisappointing...", "哦……真让人失望……")], false)
      }
    }
    acknowledgeFieldText()
  }
}
