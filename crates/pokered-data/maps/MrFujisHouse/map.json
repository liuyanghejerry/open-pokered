        {
          "line1": "#MON will",
          "line2": "spring awake."
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "It works on all",
          "line2": "sleeping #MON."
        }
      ],
      "5_NoRoom": [
        {
          "line1": "You must make",
          "line2": "room for this!"
        }
      ],
      "5_AfterFlute": [
        {
          "line1": "MR.FUJI: Has my",
          "line2": "FLUTE helped you?"
