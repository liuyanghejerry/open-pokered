  "text": {
    "npc": {
      "1": [
        {
          "line1": "That's odd, MR.FUJI",
          "line2": "isn't here."
        },
        {
          "line1": "Where'd he go?",
          "line2": ""
        }
      ],
      "1_AfterRescue": [
        {
          "line1": "MR.FUJI had been",
          "line2": "praying alone for"
        },
        {
          "line1": "CUBONE's mother.",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "This is really",
          "line2": "MR.FUJI's house."
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "He's really kind!",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "He looks after",
          "line2": "abandoned and"
        },
        {
          "line1": "orphaned #MON!",
          "line2": ""
        }
      ],
      "2_AfterRescue": [
        {
          "line1": "It's so warm!",
          "line2": "#MON are so"
        },
        {
          "line1": "nice to hug!",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "PSYDUCK: Gwappa!",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "NIDORINO: Gaoo!",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "MR.FUJI: <PLAYER>.",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Your #DEX quest",
          "line2": "may fail without"
        },
        {
          "line1": "love for your",
          "line2": "#MON."
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "I think this may",
          "line2": "help your quest."
        }
      ],
      "5_ReceivedFlute": [
        {
          "line1": "[POKE FLUTE received",
          "line2": "script]"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Upon hearing #",
          "line2": "FLUTE, sleeping"
