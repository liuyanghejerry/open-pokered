  "text": {
    "npc": {
      "1": [
        {
          "line1": "I came here with",
          "line2": "some friends!"
        },
        {
          "line1": "They're out for",
          "line2": "POKeMON fights!"
        }
      ],
      "2": [
        {
          "line1": "Hey! You have",
          "line2": "POKeMON! Come on!"
        },
        {
          "line1": "Let's battle'em!",
          "line2": ""
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "Ssh! You'll scare",
          "line2": "the bugs away!"
        }
      ],
      "3": [
        {
          "line1": "Yo! You can't jam",
          "line2": "out if you're a"
        },
        {
          "line1": "POKeMON trainer!",
          "line2": ""
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "Darn! I'm going",
          "line2": "to catch some"
        },
        {
          "line1": "stronger ones!",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "Hey, wait up!",
          "line2": "What's the hurry?"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "Sometimes, you",
          "line2": "can find stuff on"
        },
        {
          "line1": "the ground!",
          "line2": ""
        },
        {
          "line1": "I'm looking for",
          "line2": "the stuff I"
        },
        {
          "line1": "dropped!",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "[Pick up item: Antidote]",
          "line2": ""
        }
      ],
      "6": [
        {
          "line1": "[Pick up item: Potion]",
          "line2": ""
        }
      ],
      "7": [
        {
          "line1": "[Pick up item: POKe BALL]",
          "line2": ""
        }
      ],
      "8": [
        {
          "line1": "I ran out of POKe",
          "line2": "BALLs to catch"
        },
        {
          "line1": "POKeMON with!",
          "line2": ""
        },
        {
          "line1": "You should carry",
          "line2": "extras!"
        }
      ]
    },
    "sign": {
      "1": [
        {
          "line1": "TRAINER TIPS",
          "line2": ""
        },
        {
          "line1": "If you want to",
          "line2": "avoid battles,"
        },
        {
          "line1": "stay away from",
          "line2": "grassy areas!"
        }
      ],
      "2": [
        {
          "line1": "TRAINER TIPS",
          "line2": ""
        },
        {
          "line1": "If a POKeMON is",
          "line2": "poisoned, it loses"
        },
        {
          "line1": "HP even after the",
          "line2": "battle."
        },
        {
          "line1": "Use ANTIDOTE to",
          "line2": "cure it!"
        }
      ],
      "3": [
        {
          "line1": "TRAINER TIPS",
          "line2": ""
        },
        {
          "line1": "Contact with the",
          "line2": "outside world has"
        },
        {
          "line1": "been made through",
          "line2": "the Pc system."
        }
      ],
      "4": [
        {
          "line1": "TRAINER TIPS",
          "line2": ""
        },
        {
          "line1": "POKeMON attacks",
          "line2": "are physical or"
        },
        {
          "line1": "special based on",
          "line2": "their type."
        }
      ],
      "5": [
        {
          "line1": "Now leaving",
          "line2": "VIRIDIAN FOREST"
        }
      ],
