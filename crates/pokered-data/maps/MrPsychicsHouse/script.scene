// MrPsychicsHouse — translated from the original disassembly
// (scripts/MrPsychicsHouse.asm, text/MrPsychicsHouse.asm) to the real Game DSL
// API surface. Single NPC (Mr. Psychic) gives the player TM29 (PSYCHIC) once.

game_scene MrPsychicsHouse {
  // ── Mr. Psychic (npc 1) — gives TM29 (PSYCHIC) ─────────────────────────
  @storyline("talkMrPsychic") {
    @trigger(map = "MrPsychicsHouse", npc = 1)
    @if (getFlag("EVENT_GOT_TM29")) {
      printFieldTextParts([
        @t("TM29 is PSYCHIC!", "TM29是精神强念！"),
        @t("It can lower the target's\nSPECIAL abilities.", "它能降低对手的特殊能力。")
      ], false)
    } @else {
      printFieldTextParts([
        @t("...Wait! Don't say a word!", "……等等！别说话！"),
        @t("You wanted this!", "你想要这个吧！")
      ], "prompt")
      given = giveItem("TM29", 1)
      @if (given) {
        printItemFieldText(@t("<PLAYER> received TM29!", "<PLAYER>得到了 TM29！"), "SFX_GET_ITEM_1")
        setFlag("EVENT_GOT_TM29")
      } @else {
        printFieldTextParts([@t("Where do you plan to put\nthis?", "你打算把它放在哪里？")], false)
      }
    }
    // The sound returns before the event is set and DisplayTextID waits.
    acknowledgeFieldText()
  }
}
