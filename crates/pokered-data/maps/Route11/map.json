  "text": {
    "npc": {
      "1": [
        {
          "line1": "Win, lose or draw!",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "Atcha!",
          "line2": "Didn't go my way!"
        }
      ],
      "1_AfterBattle": [
        {
          "line1": "#MON is life!",
          "line2": "And to live is to"
        },
        {
          "line1": "gamble!",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "Competition! I",
          "line2": "can't get enough!"
        }
      ],
      "2_Defeated": [
        {
          "line1": "I had",
          "line2": "a chance!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "You can't be a",
          "line2": "coward in the"
        },
        {
          "line1": "world of #MON!",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "Let's go, but",
          "line2": "don't cheat!"
        }
      ],
      "3_Defeated": [
        {
          "line1": "Huh?",
          "line2": "That's not right!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "I did my best! I",
          "line2": "have no regrets!"
        }
      ],
      "4": [
        {
          "line1": "Careful!",
          "line2": "I'm laying down"
        },
        {
          "line1": "some cables!",
          "line2": ""
        }
      ],
      "4_Defeated": [
        {
          "line1": "That",
          "line2": "was electric!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "Spread the word",
          "line2": "to save energy!"
        }
      ],
      "5": [
        {
          "line1": "I just became a",
          "line2": "trainer! But, I"
        },
        {
          "line1": "think I can win!",
          "line2": ""
        }
      ],
      "5_Defeated": [
        {
          "line1": "My",
          "line2": "#MON couldn't!"
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "What do you want?",
          "line2": "Leave me alone!"
        }
      ],
      "6": [
        {
          "line1": "Fwahaha! I have",
          "line2": "never lost!"
        }
      ],
      "6_Defeated": [
        {
          "line1": "My",
          "line2": "first loss!"
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "Luck of the draw!",
          "line2": "Just luck!"
        }
      ],
      "7": [
        {
          "line1": "I have never won",
          "line2": "before..."
        }
      ],
      "7_Defeated": [
        {
          "line1": "I saw",
          "line2": "this coming..."
        }
      ],
      "7_AfterBattle": [
        {
          "line1": "It's just luck.",
          "line2": "Luck of the draw."
        }
      ],
      "8": [
        {
          "line1": "I'm the best in",
          "line2": "my class!"
        }
      ],
      "8_Defeated": [
        {
          "line1": "Darn!",
          "line2": "I need to make my"
        },
        {
          "line1": "#MON stronger!",
          "line2": ""
        }
      ],
      "8_AfterBattle": [
        {
          "line1": "There's a fat",
          "line2": "#MON that"
        },
        {
          "line1": "comes down from",
          "line2": ""
        },
        {
          "line1": "the mountains.",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "It's strong if",
          "line2": "you can get it."
        }
      ],
      "9": [
        {
          "line1": "Watch out for",
          "line2": "live wires!"
        }
      ],
      "9_Defeated": [
        {
          "line1": "Whoa!",
          "line2": "You spark plug!"
        }
      ],
      "9_AfterBattle": [
        {
          "line1": "Well, better get",
          "line2": "back to work."
        }
      ],
      "10": [
        {
          "line1": "My #MON should",
          "line2": "be ready by now!"
        }
      ],
      "10_Defeated": [
        {
          "line1": "Too",
          "line2": "much, too young!"
        }
      ],
      "10_AfterBattle": [
        {
          "line1": "I better go find",
          "line2": "stronger ones!"
        }
      ]
    },
