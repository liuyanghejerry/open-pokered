  "text": {
    "npc": {
      "1": [
        {
          "line1": "Who's there?",
          "line2": "Quit listening in"
        },
        {
          "line1": "on us!",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "I",
          "line2": "just can't win!"
        }
      ],
      "1_AfterBattle": [
        {
          "line1": "Whisper...",
          "line2": "whisper..."
        }
      ],
      "2": [
        {
          "line1": "Excuse me! This",
          "line2": "is a private"
        },
        {
          "line1": "conversation!",
          "line2": ""
        }
      ],
      "2_Defeated": [
        {
          "line1": "Ugh!",
          "line2": "I hate losing!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "Whisper...",
          "line2": "whisper..."
        }
      ],
      "3": [
        {
          "line1": "There aren't many",
          "line2": "bugs out here."
        }
      ],
      "3_Defeated": [
        {
          "line1": "No!",
          "line2": "You're kidding!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "I like bugs, so",
          "line2": "I'm going back to"
        },
        {
          "line1": "VIRIDIAN FOREST.",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "Huh? You want",
          "line2": "to talk to me?"
        }
      ],
      "4_Defeated": [
        {
          "line1": "I",
          "line2": "didn't start it!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "I should carry",
          "line2": "more #MON with"
        },
        {
          "line1": "me for safety.",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "Me? Well, OK.",
          "line2": "I'll play!"
        }
      ],
      "5_Defeated": [
        {
          "line1": "Just",
          "line2": "didn't work!"
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "I want to get",
          "line2": "stronger! What's"
        },
        {
          "line1": "your secret?",
          "line2": ""
        }
      ],
      "6": [
        {
          "line1": "I've never seen",
          "line2": "you around!"
        },
        {
          "line1": "Are you good?",
          "line2": ""
        }
      ],
      "6_Defeated": [
        {
          "line1": "You",
          "line2": "are too good!"
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "Are my #MON",
          "line2": "weak? Or, am I"
        },
        {
          "line1": "just bad?",
          "line2": ""
        }
