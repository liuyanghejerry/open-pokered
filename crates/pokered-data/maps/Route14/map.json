  "text": {
    "npc": {
      "1": [
        {
          "line1": "You need to use",
          "line2": "TMs to teach good"
        },
        {
          "line1": "moves to #MON!",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "Not",
          "line2": "good enough!"
        }
      ],
      "1_AfterBattle": [
        {
          "line1": "You have some HMs",
          "line2": "right? #MON"
        },
        {
          "line1": "can't ever forget",
          "line2": ""
        },
        {
          "line1": "those moves.",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "My bird #MON",
          "line2": "should be ready"
        },
        {
          "line1": "for battle.",
          "line2": ""
        }
      ],
      "2_Defeated": [
        {
          "line1": "Not",
          "line2": "ready yet!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "They need to learn",
          "line2": "better moves."
        }
      ],
      "3": [
        {
          "line1": "TMs are on sale",
          "line2": "in CELADON!"
        },
        {
          "line1": "But, only a few",
          "line2": ""
        },
        {
          "line1": "people have HMs!",
          "line2": ""
        }
      ],
      "3_Defeated": [
        {
          "line1": "Aww,",
          "line2": "bummer!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "Teach #MON",
          "line2": "moves of the same"
        },
        {
          "line1": "element type for",
          "line2": ""
        },
        {
          "line1": "more power.",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "Have you taught",
          "line2": "your bird #MON"
        },
        {
          "line1": "how to FLY?",
          "line2": ""
        }
      ],
      "4_Defeated": [
        {
          "line1": "Shot",
          "line2": "down in flames!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "Bird #MON are",
          "line2": "my true love!"
        }
      ],
      "5": [
        {
          "line1": "Have you heard of",
          "line2": "the legendary"
        },
        {
          "line1": "#MON?",
          "line2": ""
        }
      ],
      "5_Defeated": [
        {
          "line1": "Why?",
          "line2": "Why'd I lose?"
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "The 3 legendary",
          "line2": "#MON are all"
        },
        {
          "line1": "birds of prey.",
          "line2": ""
        }
      ],
      "6": [
        {
          "line1": "I'm not into it,",
          "line2": "but OK! Let's go!"
        }
      ],
      "6_Defeated": [
        {
          "line1": "I",
          "line2": "knew it!"
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "Winning, losing,",
          "line2": "it doesn't matter"
        },
        {
          "line1": "in the long run!",
          "line2": ""
        }
      ],
      "7": [
        {
          "line1": "C'mon, c'mon.",
          "line2": "Let's go, let's"
        },
        {
          "line1": "go, let's go!",
          "line2": ""
        }
      ],
      "7_Defeated": [
        {
          "line1": "Arrg!",
          "line2": "Lost! Get lost!"
        }
      ],
      "7_AfterBattle": [
        {
          "line1": "What, what, what?",
          "line2": "What do you want?"
        }
      ],
      "8": [
        {
          "line1": "Perfect! I need to",
          "line2": "burn some time!"
        }
      ],
      "8_Defeated": [
        {
          "line1": "What?",
          "line2": "You!?"
        }
      ],
      "8_AfterBattle": [
        {
          "line1": "Raising #MON",
          "line2": "is a drag, man."
        }
      ],
      "9": [
        {
          "line1": "We ride out here",
          "line2": "because there's"
        },
        {
          "line1": "more room!",
          "line2": ""
        }
      ],
      "9_Defeated": [
        {
          "line1": "Wipe out!",
          "line2": ""
        }
      ],
      "9_AfterBattle": [
        {
          "line1": "It's cool you",
          "line2": "made your #MON"
        },
        {
          "line1": "so strong!",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Might is right!",
          "line2": "And you know it!"
        }
      ],
      "10": [
        {
          "line1": "#MON fight?",
          "line2": "Cool! Rumble!"
        }
      ],
      "10_Defeated": [
        {
          "line1": "Blown",
          "line2": "away!"
        }
      ],
      "10_AfterBattle": [
        {
          "line1": "You know who'd",
          "line2": "win, you and me"
        },
        {
          "line1": "one on one!",
          "line2": ""
        }
      ]
    },
