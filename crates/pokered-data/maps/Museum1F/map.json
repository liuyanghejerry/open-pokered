        {
          "line1": "to resurrect",
          "line2": "ancient #MON"
        },
        {
          "line1": "from AMBER.",
          "line2": ""
        }
      ],
      "1_BehindCounterNo": [
        {
          "line1": "AMBER is fossil-",
          "line2": "ized tree sap."
        }
      ],
      "2": [
        {
          "line1": "That is one",
          "line2": "magnificent"
        },
        {
          "line1": "fossil!",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "Ssh! I think that",
          "line2": "this chunk of"
        },
        {
          "line1": "AMBER contains",
          "line2": "#MON DNA!"
        },
        {
          "line1": "It would be great",
          "line2": "if #MON could"
        },
        {
          "line1": "be resurrected",
          "line2": "from it!"
        },
        {
          "line1": "But, my colleagues",
          "line2": "just ignore me!"
        },
        {
          "line1": "So I have a favor",
          "line2": "to ask!"
        },
        {
          "line1": "Take this to a",
          "line2": "#MON LAB and"
        },
        {
          "line1": "get it examined!",
          "line2": ""
        }
      ],
