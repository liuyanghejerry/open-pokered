          "line1": "You can't sneak",
          "line2": "in the back way!"
        },
        {
          "line1": "Oh, whatever!",
          "line2": "Do you know what"
        },
        {
          "line1": "AMBER is?",
          "line2": ""
        }
      ],
      "1_BehindCounterYes": [
        {
          "line1": "There's a lab",
          "line2": "somewhere trying"
