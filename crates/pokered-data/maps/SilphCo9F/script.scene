// SilphCo9F — translated from the original disassembly (scripts/SilphCo9F.asm,
// text/SilphCo9F.asm) to the real Game DSL API surface. This floor is a sight-
// engaged trainer floor (the two Rockets + Scientist are driven by the runtime,
// so their talk handlers are dialogue only) plus a healing Nurse NPC.
//
// Card-Key door gate (SilphCo9FGateCallbackScript) — NOW WIRED via replaceTileBlock.
// The original gate callback runs on map load. The base map (map.blk) ships all
// four card-key doors OPEN (floor block 14 / $0E); when a door is NOT yet
// unlocked the callback COVERS it with a CLOSED block, and when its flag is set
// the door stays open. Asm (note lb bc, Y, X → replaceTileBlock(X, Y, id);
// hex→dec):
//   door1: CheckEvent EVENT_SILPH_CO_9_UNLOCKED_DOOR1; if !set draw $5f=95 closed,
//          lb bc, 4, 1 → replaceTileBlock(1, 4, 95)   open=14
//   door2: EVENT_SILPH_CO_9_UNLOCKED_DOOR2; if !set draw $54=84 closed,
//          lb bc, 2, 9 → replaceTileBlock(9, 2, 84)   open=14
//   door3: EVENT_SILPH_CO_9_UNLOCKED_DOOR3; if !set draw $54=84 closed,
//          lb bc, 5, 9 → replaceTileBlock(9, 5, 84)   open=14
//   door4: EVENT_SILPH_CO_9_UNLOCKED_DOOR4; if !set draw $5f=95 closed,
//          lb bc, 6, 5 → replaceTileBlock(5, 6, 95)   open=14
// .GateCoordinates (X,Y) (1,4)/(9,2)/(9,5)/(5,6) map 1:1 to doors 1..4.
// NOTE: the original solve is the shared Silph card-key door interaction
// (hUnlockedSilphCoDoors / wCardKeyDoorY matched against this floor's gate coords,
// set when the player uses the CARD_KEY on the door tile). That tile-step CARD_KEY
// check has no DSL primitive, so it is approximated faithfully (as in SilphCo5F/6F):
// a coords trigger on each card-key door's tiles, gated by hasItem("CARD_KEY"),
// sets that door's unlock flag and opens it immediately (block 14) with
// SFX_GO_INSIDE. A Silph door never re-closes once unlocked, so no CLOSED re-apply
// on solve.

game_scene SilphCo9F {
  // ── On-enter gate callback (SilphCo9FGateCallbackScript) ─────────────────
  // Faithful to the asm: cover each door with its CLOSED block while still
  // locked; re-apply OPEN (floor block 14) once unlocked so a solved door stays
  // open on re-entry.
  @load {
    @if (getFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR1")) {
      replaceTileBlock(1, 4, 14)
    } @else {
      replaceTileBlock(1, 4, 95)
    }
    @if (getFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR2")) {
      replaceTileBlock(9, 2, 14)
    } @else {
      replaceTileBlock(9, 2, 84)
    }
    @if (getFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR3")) {
      replaceTileBlock(9, 5, 14)
    } @else {
      replaceTileBlock(9, 5, 84)
    }
    @if (getFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR4")) {
      replaceTileBlock(5, 6, 14)
    } @else {
      replaceTileBlock(5, 6, 95)
    }
  }

  // ── Card-Key door 1 (gate coord (1,4)) ──────────────────────────────────
  // Door block (1,4) → tiles x∈{2,3}, y∈{8,9}.
  @storyline("cardKeyDoor1") {
    @trigger(map = "SilphCo9F", name = "cardKeyDoor11")
    @if (!getFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR1")) {
      @if (hasItem("CARD_KEY")) {
        @speaker("") { @t("Bingo!", "中了！") }
        @speaker("") { @t("The CARD KEY opened the\ndoor!", "磁卡钥匙打开了门！") }
        setFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR1")
        replaceTileBlock(1, 4, 14)
        playSound("SFX_GO_INSIDE")
      } @else {
        @speaker("") { @t("Darn! It needs a CARD KEY!", "可恶！需要磁卡钥匙！") }
      }
    }
  }

  // ── Card-Key door 2 (gate coord (9,2)) ──────────────────────────────────
  // Door block (9,2) → tiles x∈{18,19}, y∈{4,5}.
  @storyline("cardKeyDoor2") {
    @trigger(map = "SilphCo9F", name = "cardKeyDoor21")
    @if (!getFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR2")) {
      @if (hasItem("CARD_KEY")) {
        @speaker("") { @t("Bingo!", "中了！") }
        @speaker("") { @t("The CARD KEY opened the\ndoor!", "磁卡钥匙打开了门！") }
        setFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR2")
        replaceTileBlock(9, 2, 14)
        playSound("SFX_GO_INSIDE")
      } @else {
        @speaker("") { @t("Darn! It needs a CARD KEY!", "可恶！需要磁卡钥匙！") }
      }
    }
  }

  // ── Card-Key door 3 (gate coord (9,5)) ──────────────────────────────────
  // Door block (9,5) → tiles x∈{18,19}, y∈{10,11}.
  @storyline("cardKeyDoor3") {
    @trigger(map = "SilphCo9F", name = "cardKeyDoor31")
    @if (!getFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR3")) {
      @if (hasItem("CARD_KEY")) {
        @speaker("") { @t("Bingo!", "中了！") }
        @speaker("") { @t("The CARD KEY opened the\ndoor!", "磁卡钥匙打开了门！") }
        setFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR3")
        replaceTileBlock(9, 5, 14)
        playSound("SFX_GO_INSIDE")
      } @else {
        @speaker("") { @t("Darn! It needs a CARD KEY!", "可恶！需要磁卡钥匙！") }
      }
    }
  }

  // ── Card-Key door 4 (gate coord (5,6)) ──────────────────────────────────
  // Door block (5,6) → tiles x∈{10,11}, y∈{12,13}.
  @storyline("cardKeyDoor4") {
    @trigger(map = "SilphCo9F", name = "cardKeyDoor41")
    @if (!getFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR4")) {
      @if (hasItem("CARD_KEY")) {
        @speaker("") { @t("Bingo!", "中了！") }
        @speaker("") { @t("The CARD KEY opened the\ndoor!", "磁卡钥匙打开了门！") }
        setFlag("EVENT_SILPH_CO_9_UNLOCKED_DOOR4")
        replaceTileBlock(5, 6, 14)
        playSound("SFX_GO_INSIDE")
      } @else {
        @speaker("") { @t("Darn! It needs a CARD KEY!", "可恶！需要磁卡钥匙！") }
      }
    }
  }

  // ── Nurse (npc 1) — heals the party; isTrainer:false (talk-driven) ───────
  @storyline("talkNurse") {
    @trigger(map = "SilphCo9F", npc = 1)
    @if (getFlag("EVENT_BEAT_SILPH_CO_GIOVANNI")) {
      @speaker("") { @t("Thank you so much!", "非常感谢你！") }
    } @else {
      @speaker("") { @t("You look tired! You should\ntake a quick nap!", "你看起来很累！快去休息一下\n吧！") }
      heal()
      @speaker("") { @t("Don't give up!", "不要放弃！") }
    }
  }

  // ── Rocket (npc 2) — sight-engaged by the runtime; dialogue only ─────────
  @storyline("talkRocket1") {
    @trigger(map = "SilphCo9F", npc = 2, toggle = "SILPH_CO_9F_OBJ_2")
    @if (getFlag("EVENT_BEAT_SILPH_CO_9F_TRAINER_0")) {
      @speaker("") { @t("If I had started as a\ntrainer at your age...", "如果我像你这么大就开始当训练\n家的话……") }
    } @else {
      @speaker("") { @t("Your POKeMON seem to adore\nyou, kid!", "你的宝可梦好像很喜欢你啊，小\n子！") }
    }
  }

  // ── Scientist (npc 3) — sight-engaged by the runtime; dialogue only ──────
  @storyline("talkScientist") {
    @trigger(map = "SilphCo9F", npc = 3, toggle = "SILPH_CO_9F_OBJ_3")
    @if (getFlag("EVENT_BEAT_SILPH_CO_9F_TRAINER_1")) {
      @speaker("") { @t("Exploiting weak spots does\nwork! Think about element\ntypes!", "抓住弱点确实有效！想想属性相\n克吧！") }
    } @else {
      @speaker("") { @t("Your POKeMON have weak\npoints! I can nail them!", "你的宝可梦有弱点！我能准确命\n中！") }
    }
  }

  // ── Rocket (npc 4) — sight-engaged by the runtime; dialogue only ─────────
  @storyline("talkRocket2") {
    @trigger(map = "SilphCo9F", npc = 4, toggle = "SILPH_CO_9F_OBJ_4")
    @if (getFlag("EVENT_BEAT_SILPH_CO_9F_TRAINER_2")) {
      @speaker("") { @t("My brothers will avenge me!", "我的兄弟们会为我报仇！") }
    } @else {
      @speaker("") { @t("I am one of the 4 ROCKET\nBROTHERS!", "我是火箭队四兄弟中的一员！") }
    }
  }
}
