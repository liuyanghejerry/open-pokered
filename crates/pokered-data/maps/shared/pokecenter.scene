// Shared Pokémon Center dialogue — the native-AST port of `shared/pokecenter.js`.
//
// The original shared JS module (`maps/shared/pokecenter.js`) stays for the
// Boa fallback path; this `.scene` is compiled to a serialized AST at build
// time (`generate_scene_scripts` → `SCENE_ASTS`) and registered by the native
// script engine (`pokered-core::overworld::native_script`) so
// `talkNurse` / `talkLinkReceptionist` resolve for any map whose own
// `script.scene` does not define them.
//
// The English side of every `@t(...)` is byte-for-byte the original English
// module (checked by scripts/verify_scene_translations.py). The Chinese side
// is the in-game localization. The dormant `pokecenter.js` Boa fallback is
// English-only and is not updated by the localization.
game_scene pokecenter {
  @storyline("talkNurse") {
    @speaker("") { @t("Welcome to our\n#MON CENTER!\n\nWe heal your\n#MON back to\nperfect health!", "欢迎来到我们的\n宝可梦中心！\n\n我们把您的宝可梦\n恢复得\n健健康康！") }
    @speaker("") { @t("Shall we heal\nyour #MON?", "要为您的宝可梦\n恢复吗？") }
    @choice {
      @option(@t("Yes", "是")) {
        @speaker("") { @t("OK. We'll need\nyour #MON.", "好的。\n请把宝可梦\n交给我们。") }
        faceNpc("1", "right")
        delay(8)
        heal()
        animateHealingMachine()
        faceNpc("1", "down")
        delay(8)
        @speaker("") { @t("Thank you!\nYour #MON are\nfighting fit!", "谢谢！\n您的宝可梦\n已经精神饱满！") }
      }
      @option(@t("No", "否")) {
      }
    }
    @speaker("") { @t("We hope to see\nyou again!", "欢迎再次\n光临！") }
  }

  @storyline("talkLinkReceptionist") {
    @speaker("") { @t("Welcome to the\nCable Club!", "欢迎来到\n连接俱乐部！") }
  }
}
