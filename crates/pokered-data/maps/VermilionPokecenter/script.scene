// Refactored from VermilionPokecenter/script.js to dotzuki-engine-dsl.
// Nurse continuation follows engine/events/pokecenter.asm.

game_scene VermilionPokecenter {
  @storyline("talkNurse") {
    @trigger(map = "VermilionPokecenter", npc = 1)
    // DisplayPokemonCenterDialogue_: inner PROMPT, optional paused DONE, HEAL/CANCEL.
    answer = pokecenterNurseOffer(getPokecenterUsed(), @t("Welcome to our POKeMON\nCENTER!", "欢迎来到宝可梦中心！"), @t("We heal your POKeMON back to\nperfect health!", "我们会让你的宝可梦恢复最佳状\n态！"), @t("Shall we heal your POKeMON?", "要为你治疗宝可梦吗？"), @t("HEAL", "治疗"), @t("CANCEL", "取消"))
    @if (answer == 0) {
      printFieldText(@t("OK. We'll need your\nPOKeMON.", "好的，请把宝可梦交给我。"), true)
      faceNpc("1", "left")
      delay(3)
      heal()
      animateHealingMachine()
      printFieldText(@t("Thank you!\nYour POKeMON are\nfighting fit!", "谢谢你的等待。\n\n你的宝可梦已完全恢复了！"), true, "prompt")
      setNpcFrame("1", 1)
      delay(20)
    }
    pokecenterFarewell(@t("We hope to see you again!", "期待你再次光临！"))
    faceNpc("1", "down")
  }

  @storyline("talkFishingGuru") {
    @trigger(map = "VermilionPokecenter", npc = 2)
    @speaker("") { @t("Even if they are the same\nlevel, POKEMON can have very\ndifferent abilities.\n\nA POKEMON raised by a\ntrainer is stronger than one\nin the wild.", "即使是相同等级，宝可梦的能力\n也可能大不相同。培育方法不\n同。\n\n由训练家培育的宝可梦比野生的\n要更强。") }
  }

  @storyline("talkSailor") {
    @trigger(map = "VermilionPokecenter", npc = 3)
    @speaker("") { @t("My POKEMON was poisoned! It\nfainted while we were\nwalking!", "我的宝可梦中毒了！走着走着就\n晕倒了！") }
  }

  @storyline("talkLinkReceptionist") {
    @trigger(map = "VermilionPokecenter", npc = 4)
    @speaker("") { @t("Welcome to the\nCable Club!", "欢迎来到通信俱乐部！") }
    linkStart()
  }

  // ── Pokémon Center PC (sign 1 at 13,3) ───────────────────────────────
  // engine/menus/pc.asm ActivatePC: BILL's PC / item PC / PROF.OAK's PC.
  @storyline("pcStorage") {
    @trigger(map = "VermilionPokecenter", sign = 1)
    openPC()
  }


  // ── Bench guy (sign 2 at (0,4)) — PrintBenchGuyText ────────────────────
  // data/events/bench_guys.asm + hidden_events.asm: A on the (0,4) bench
  // tile while facing it; BenchGuyTextPointers requires SPRITE_FACING_LEFT,
  // so gate on the player's facing (getPlayerFacing() -> down/up/left/right).
  @storyline("benchGuy") {
    @trigger(map = "VermilionPokecenter", sign = 2)
    @if (getPlayerFacing() == "left") {
      @speaker("") {
        @t("It is true that a
higher level
#MON will be
more powerful...

But, all #MON
will have weak
points against
specific types.

So, there is no
universally
strong #MON.", "等级更高的宝可梦\n确实更强……\n\n但是，所有宝可梦\n都有被特定属性克制\n的弱点。\n\n所以，不存在\n任何场合都强的\n宝可梦。")
      }
    }
  }
}
