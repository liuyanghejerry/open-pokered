// Route11Gate2F — translated from the original disassembly
// (scripts/Route11Gate2F.asm, text/Route11Gate2F.asm,
// engine/events/in_game_trades.asm + data/events/trades.asm,
// engine/events/oaks_aide.asm). Two NPCs (an in-game-trade Youngster and an
// Oak's Aide) plus two binocular signs that only display when the player
// faces up.

game_scene Route11Gate2F {
  // ── Youngster (npc 1) — TRADE_FOR_TERRY: NIDORINO -> NIDORINA (TERRY) ────
  // dialogset CASUAL (set 1).
  //
  // The trade is fully implemented via tradePokemon(): it verifies the player
  // carries NIDORINO, removes it from the party, and adds NIDORINA nicknamed
  // TERRY with the trade animation; the wrong-mon path returns false. See
  // talkYoungster below.
  @storyline("talkYoungster") {
    @trigger(map = "Route11Gate2F", npc = 1)
    @if (getFlag("EVENT_TRADED_FOR_TERRY")) {
      // AfterTrade1Text (dialogset CASUAL)
      @speaker("") {
        @t("Isn't my old NIDORINA great?", "我的这只尼多兰棒吧？")
      }
    } @else {
      // WannaTrade1Text (dialogset CASUAL)
      @speaker("") {
        @t("I'm looking for NIDORINO!\nWanna\n\ntrade one for NIDORINA?", "我在找尼多朗！\n\n想跟我交换尼多兰？")
      }
      @choice {
        @option(@t("YES", "是")) {
          // ConnectCableText -> real in-game trade (removes NIDORINO, adds
          // NIDORINA nicknamed TERRY). tradePokemon returns false if the player
          // doesn't actually carry NIDORINO -> wrong-mon (dialogset CASUAL).
          traded = tradePokemon("NIDORINO", "NIDORINA", "TERRY")
          @if (traded) {
            setFlag("EVENT_TRADED_FOR_TERRY")
            @speaker("") { @t("<PLAYER> traded NIDORINO for\nNIDORINA!", "<PLAYER>用尼多朗交换了尼多\n兰！") }
            @speaker("") { @t("Hey thanks!", "嘿，谢啦！") }
          } @else {
            @if (getFlag("NPC_TRADE_CANCELLED")) {
              @speaker("") { @t("Awww! Oh well...", "哎呀！算了吧……") }
            } @else {
              @speaker("") { @t("What? That's not NIDORINO!\n\nIf you get one, come back\nhere!", "什么？那不是尼多朗！\n\n你要是抓到，再来找我吧！") }
            }
          }
        }
        @option(@t("NO", "否")) {
          // NoTrade1Text
          @speaker("") { @t("Awww! Oh well...", "哎呀！算了吧……") }
        }
      }
    }
  }

  // ── Oak's Aide / Scientist (npc 2) — gives ITEMFINDER at 30 kinds owned ──
  @storyline("talkOaksAide") {
    @trigger(map = "Route11Gate2F", npc = 2)
    @if (getFlag("EVENT_GOT_ITEMFINDER")) {
      // ItemfinderDescriptionText (shown once the player already has it)
      printFieldText(t("There are items on the\nground that can't be seen.", "地上有些看不见的道具。"))
      printFieldParagraph(t("ITEMFINDER will detect an\nitem close to you.", "探宝器能探测到附近的道具。"))
      printFieldParagraph(t("It can't pinpoint it, so you\nhave to look yourself!", "但无法准确定位，你得自己找才\n行！"))
    } @else {
      // OaksAideHiText (requirement = 30 kinds, reward = ITEMFINDER)
      printFieldText(t("Hi! Remember me? I'm\nPROF.OAK's AIDE!", "嗨！还记得我吗？我是大木博士\n的助手！"))
      printFieldParagraph(t("If you caught 30 kinds of\nPOKeMON, I'm supposed to\ngive you an ITEMFINDER!", "如果你抓到了 30种宝可梦，我\n就要给你一个探宝器！"))
      printFieldParagraph(t("So, <PLAYER>! Have you\ncaught at least 30 kinds of\nPOKeMON?", "那么，<PLAYER>！你抓到 30种\n以上的宝可梦了吗？"))
      @choice {
        @option(@t("YES", "是")) {
          @if (getPokedexOwnedCount() >= 30) {
            // OaksAideHereYouGoText -> give item -> OaksAideGotItemText
            printFieldText(t("Great! You have caught ", "太好了！你已经抓到了") + getPokedexOwnedCount() + t(" kinds of POKeMON!\nCongratulations!", "种宝可梦！\n恭喜你！"))
            printFieldParagraph(t("Here you go!", "给你！"))
            waitFieldPrompt()
            given = giveItem("ITEMFINDER", 1)
            @if (given) {
              printItemFieldText(@t("<PLAYER> got the ITEMFINDER!", "<PLAYER>得到了探宝器！"), "SFX_GET_ITEM_1")
              setFlag("EVENT_GOT_ITEMFINDER")
              // ItemfinderDescriptionText follows in the original.
              printFieldText(t("There are items on the\nground that can't be seen.", "地上有些看不见的道具。"))
              printFieldParagraph(t("ITEMFINDER will detect an\nitem close to you.", "探宝器能探测到附近的道具。"))
              printFieldParagraph(t("It can't pinpoint it, so you\nhave to look yourself!", "但无法准确定位，你得自己找才\n行！"))
            } @else {
              printFieldText(t("Oh! I see you don't have any\nroom for the ITEMFINDER.", "哦！看来你没有地方放探宝器。"))
            }
          } @else {
            // OaksAideUhOhText (not enough kinds owned)
            printFieldText(t("Let's see... Uh-oh! You have\ncaught only ", "让我看看……哎呀！你只抓到了") + getPokedexOwnedCount() + t(" kinds of\nPOKeMON!", "种宝可梦！"))
            printFieldParagraph(t("You need 30 kinds if you\nwant the ITEMFINDER.", "要得到ITEMFINDER，需要抓到30种。"))
          }
        }
        @option(@t("NO", "否")) {
          // OaksAideComeBackText
          printFieldText(t("Oh. I see.", "哦，是吗。"))
          printFieldParagraph(t("When you get 30 kinds, come\nback for ITEMFINDER.", "等你抓到30种，再来拿探宝器\n吧。"))
        }
      }
    }
    finishFieldText()
  }

  // ── Left binoculars (sign 1) — only shown when facing up ─────────────────
  @storyline("leftBinoculars") {
    @trigger(map = "Route11Gate2F", sign = 1)
    @if (getPlayerFacing() == "up") {
      @if (getFlag("EVENT_BEAT_ROUTE12_SNORLAX")) {
        // LeftBinocularsNoSnorlaxText (Snorlax already cleared from Route 12)
        @speaker("") {
          @t("Looked into the binoculars.\n\nIt's a beautiful view!", "用望远镜看了看。\n\n真是美丽的景色！")
        }
      } @else {
        // LeftBinocularsSnorlaxText (Snorlax still asleep on Route 12)
        @speaker("") {
          @t("Looked into the binoculars.\n\nA big POKeMON is asleep on a\nroad!", "用望远镜看了看。\n\n有只大宝可梦在路上睡着！")
        }
      }
    }
  }

  // ── Right binoculars (sign 2) — only shown when facing up ────────────────
  @storyline("rightBinoculars") {
    @trigger(map = "Route11Gate2F", sign = 2)
    @if (getPlayerFacing() == "up") {
      @speaker("") {
        @t("Looked into the binoculars.\n\nThe only way to get from\nCERULEAN CITY to LAVENDER is\nby way of the ROCK TUNNEL.", "用望远镜看了看。\n\n从华蓝市到紫苑镇只有经过岩山\n隧道这条路。")
      }
    }
  }
}
