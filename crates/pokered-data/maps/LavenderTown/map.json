  "text": {
    "npc": {
      "1": [
        {
          "line1": "Do you believe in",
          "line2": "GHOSTs?"
        }
      ],
      "1_Yes": [
        {
          "line1": "Really? So there",
          "line2": "are believers..."
        }
      ],
      "1_No": [
        {
          "line1": "Hahaha, I guess",
          "line2": "not."
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "That white hand",
          "line2": "on your shoulder,"
        },
        {
          "line1": "it's not real.",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "This town is known",
          "line2": "as the grave site"
        },
        {
          "line1": "of #MON.",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Memorial services",
          "line2": "are held in"
        },
        {
          "line1": "#MON TOWER.",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "GHOSTs appeared",
          "line2": "in #MON TOWER."
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "I think they're",
          "line2": "the spirits of"
        },
        {
          "line1": "#MON that the",
          "line2": "ROCKETs killed."
        }
      ]
    },
    "sign": {
      "1": [
        {
