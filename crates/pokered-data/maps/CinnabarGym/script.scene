// CinnabarGym — translated from the original disassembly (scripts/CinnabarGym.asm,
// engine/events/hidden_events/cinnabar_gym_quiz.asm, data/text/text_2.asm) to the
// real Game DSL API surface. Gym leader BLAINE is talk-driven (map.json
// isTrainer = false) so the script owns the battle->VOLCANOBADGE->TM38 reward.
//
// QUIZ-GATE PUZZLE (original mechanics, restored per the 2026-09-07 audit):
//  - Six hidden quiz MACHINES (not the trainers) run the quiz. Each is a
//    facing-up hidden interaction at its original coordinate
//    (hidden_events.asm CINNABAR_GYM), bound to OnInteract by overworld setup.
//    Machines and gates use independent flags: answering correctly only opens
//    that machine's gate (EVENT_CINNABAR_GYM_GATE0..5_UNLOCKED); the trainers
//    stay challengeable.
//  - Answering WRONG plays SFX_DENIED and, unless that gate's trainer is
//    already beaten, pits you against the gate-linked trainer
//    (wOpponentAfterWrongAnswer = gate index + 2 upstream; mapped here to
//    trainer npc gate+2). Gate flags and trainer flags are separate.
//  - Gates are closed/open tile swaps re-applied on every load
//    (UpdateCinnabarGymGateTileBlocks_): closed HORIZONTAL $54 / VERTICAL $5f,
//    open $0e — coordinates from CinnabarGymGateCoords.
//  - The seven trainers are talk-driven (original headers are talk-engaged in
//    this port): talking battles them directly; their persistent post-defeat
//    texts survive from the original. Defeated trainers remain visible.
//  - Quiz machine 6's upstream answer bit decodes past GATE5; the six machines
//    are mapped to GATE0..5 in listed order, matching the six-gate audit note.

game_scene CinnabarGym {
  // ── Gate initialization (UpdateCinnabarGymGateTileBlocks_) ──────────────
  @load {
    @if (getFlag("EVENT_CINNABAR_GYM_GATE0_UNLOCKED")) {
      replaceTileBlock(9, 3, 14)
    } @else {
      replaceTileBlock(9, 3, 84)
    }
    @if (getFlag("EVENT_CINNABAR_GYM_GATE1_UNLOCKED")) {
      replaceTileBlock(6, 3, 14)
    } @else {
      replaceTileBlock(6, 3, 84)
    }
    @if (getFlag("EVENT_CINNABAR_GYM_GATE2_UNLOCKED")) {
      replaceTileBlock(6, 6, 14)
    } @else {
      replaceTileBlock(6, 6, 84)
    }
    @if (getFlag("EVENT_CINNABAR_GYM_GATE3_UNLOCKED")) {
      replaceTileBlock(3, 8, 14)
    } @else {
      replaceTileBlock(3, 8, 95)
    }
    @if (getFlag("EVENT_CINNABAR_GYM_GATE4_UNLOCKED")) {
      replaceTileBlock(2, 6, 14)
    } @else {
      replaceTileBlock(2, 6, 84)
    }
    @if (getFlag("EVENT_CINNABAR_GYM_GATE5_UNLOCKED")) {
      replaceTileBlock(2, 3, 14)
    } @else {
      replaceTileBlock(2, 3, 84)
    }
  }

  // ── BLAINE, the Gym Leader (npc 1) ─────────────────────────────────────
  @storyline("talkBlaine") {
    @trigger(map = "CinnabarGym", npc = 1)
    @if (getFlag("EVENT_BEAT_BLAINE")) {
      @if (!getFlag("EVENT_GOT_TM38")) {
        // Beat Blaine previously but had no room for the TM — try again.
        @speaker("") { @t("Make room for my gift!", "腾个地方收下礼物！") }
        giveItem("TM_38", 1)
        setFlag("EVENT_GOT_TM38")
        @speaker("") { @t("<PLAYER> received TM38!", "<PLAYER>得到了 TM38！") }
        @speaker("") {
          @t("TM38 contains FIRE BLAST!\n\nTeach it to fire- type\nPOKeMON!\n\nCHARMELEON or PONYTA would\nbe good bets!", "TM38里有大字爆炎！\n\n教给火系的宝可梦吧！\n\n火恐龙或小火马是不错的选择！")
        }
      } @else {
        @speaker("") {
          @t("FIRE BLAST is the ultimate\nfire technique!\n\nDon't waste it on water\nPOKeMON!", "大字爆炎是最终极的火系招式！\n\n别把它浪费在水系宝可梦上！")
        }
      }
    } @else {
      @speaker("") {
        @t("Hah!\n\nI am BLAINE! I am the LEADER\nof CINNABAR GYM!\n\nMy fiery POKeMON will\nincinerate all challengers!\n\nHah! You better have BURN\nHEAL!", "哈哈！\n\n我就是夏伯！我是红莲道馆的馆\n主！\n\n我的火焰宝可梦会把挑战者全部\n烧成灰！\n\n哈哈！你最好带上灼伤药！")
      }
      result = startBattle("OPP_BLAINE1")
      @if (result == "win") {
        @speaker("") {
          @t("I have burnt out!\n\nYou have earned the\nVOLCANOBADGE!", "我已经烧尽了！\n\n你获得了深红徽章！")
        }
        giveBadge("VOLCANOBADGE")
        setFlag("EVENT_BEAT_BLAINE")
        @speaker("") {
          @t("Hah!\n\nThe VOLCANOBADGE heightens\nthe SPECIAL abilities of\nyour POKeMON!\n\nHere, you can have this too!", "哈哈！\n\n深红徽章能提高你的宝可梦的特\n殊能力！\n\n来，这个也给你！")
        }
        giveItem("TM_38", 1)
        setFlag("EVENT_GOT_TM38")
        @speaker("") { @t("<PLAYER> received TM38!", "<PLAYER>得到了 TM38！") }
        @speaker("") {
          @t("TM38 contains FIRE BLAST!\n\nTeach it to fire- type\nPOKeMON!\n\nCHARMELEON or PONYTA would\nbe good bets!", "TM38里有大字爆炎！\n\n教给火系的宝可梦吧！\n\n火恐龙或小火马是不错的选择！")
        }
        // Deactivate the gym trainers (original SetEventRange TRAINER_0..6).
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_0")
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_1")
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_2")
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_3")
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_4")
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_5")
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_6")
      }
    }
  }

  // ── Quiz machine 1 (tile 15,7 → gate 1 at block 9,3; answer NO) ─────────
  @storyline("quizMachine1") {
    @trigger(map = "CinnabarGym", name = "quizMachine1")
    @if (getPlayerFacing() == "up") {
      @speaker("") { @t("#MON Quiz!\n\nGet it right and the door\nopens to the next room!\n\nGet it wrong and face a\ntrainer!\n\nIf you want to conserve\nyour #MON for the GYM\nLEADER...\n\nThen get it right! Here we\ngo!", "宝可梦问答！\n\n答对了，通往下一个房间的大\n门就会打开！\n\n答错了，就要面对训练家！\n\n如果想为挑战馆主保存宝可梦\n的实力……\n\n那就答对吧！开始！") }
      @speaker("") { @t("CATERPIE evolves into\nBUTTERFREE?", "绿毛虫会进化成巴大蝶？") }
      @choice {
        @option(@t("YES", "是")) {
          playSound("SFX_DENIED")
          @speaker("") { @t("Sorry! Bad call!", "抱歉，答错了！") }
          @if (!getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_1")) {
            result = startBattle("OPP_BURGLAR4")
            @if (result == "win") {
              setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_1")
              @speaker("") { @t("I can't help stealing other\npeople's POKeMON!", "我忍不住想偷别人的宝可梦！") }
            }
          }
        }
        @option(@t("NO", "否")) {
          playSound("SFX_GO_INSIDE")
          @speaker("") { @t("You're absolutely correct!\n\nGo on through!", "完全正确！\n\n请通过吧！") }
          setFlag("EVENT_CINNABAR_GYM_GATE0_UNLOCKED")
          replaceTileBlock(9, 3, 14)
        }
      }
    }
  }

  // ── Quiz machine 2 (tile 10,1 → gate 2 at block 6,3; answer NO) ─────────
  @storyline("quizMachine2") {
    @trigger(map = "CinnabarGym", name = "quizMachine2")
    @if (getPlayerFacing() == "up") {
      @speaker("") { @t("#MON Quiz!\n\nGet it right and the door\nopens to the next room!\n\nGet it wrong and face a\ntrainer!\n\nIf you want to conserve\nyour #MON for the GYM\nLEADER...\n\nThen get it right! Here we\ngo!", "宝可梦问答！\n\n答对了，通往下一个房间的大\n门就会打开！\n\n答错了，就要面对训练家！\n\n如果想为挑战馆主保存宝可梦\n的实力……\n\n那就答对吧！开始！") }
      @speaker("") { @t("There are 9 certified #MON\nLEAGUE BADGEs?", "宝可梦联盟的认证徽章有 9枚？") }
      @choice {
        @option(@t("YES", "是")) {
          playSound("SFX_DENIED")
          @speaker("") { @t("Sorry! Bad call!", "抱歉，答错了！") }
          @if (!getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_2")) {
            result = startBattle("OPP_SUPER_NERD10")
            @if (result == "win") {
              setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_2")
              @speaker("") { @t("My theories are too\ncomplicated for you!", "我的理论太复杂，你听不懂！") }
            }
          }
        }
        @option(@t("NO", "否")) {
          playSound("SFX_GO_INSIDE")
          @speaker("") { @t("You're absolutely correct!\n\nGo on through!", "完全正确！\n\n请通过吧！") }
          setFlag("EVENT_CINNABAR_GYM_GATE1_UNLOCKED")
          replaceTileBlock(6, 3, 14)
        }
      }
    }
  }

  // ── Quiz machine 3 (tile 9,7 → gate 3 at block 6,6; answer NO) ──────────
  @storyline("quizMachine3") {
    @trigger(map = "CinnabarGym", name = "quizMachine3")
    @if (getPlayerFacing() == "up") {
      @speaker("") { @t("#MON Quiz!\n\nGet it right and the door\nopens to the next room!\n\nGet it wrong and face a\ntrainer!\n\nIf you want to conserve\nyour #MON for the GYM\nLEADER...\n\nThen get it right! Here we\ngo!", "宝可梦问答！\n\n答对了，通往下一个房间的大\n门就会打开！\n\n答错了，就要面对训练家！\n\n如果想为挑战馆主保存宝可梦\n的实力……\n\n那就答对吧！开始！") }
      @speaker("") { @t("POLIWAG evolves 3 times?", "蚊香蝌蚪会进化 3次？") }
      @choice {
        @option(@t("YES", "是")) {
          playSound("SFX_DENIED")
          @speaker("") { @t("Sorry! Bad call!", "抱歉，答错了！") }
          @if (!getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_3")) {
            result = startBattle("OPP_BURGLAR5")
            @if (result == "win") {
              setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_3")
              @speaker("") { @t("I wish there was a thief\nPOKeMON! I'd use that!", "真希望有小偷宝可梦！我一定\n用！") }
            }
          }
        }
        @option(@t("NO", "否")) {
          playSound("SFX_GO_INSIDE")
          @speaker("") { @t("You're absolutely correct!\n\nGo on through!", "完全正确！\n\n请通过吧！") }
          setFlag("EVENT_CINNABAR_GYM_GATE2_UNLOCKED")
          replaceTileBlock(6, 6, 14)
        }
      }
    }
  }

  // ── Quiz machine 4 (tile 9,13 → gate 4 at block 3,8; answer NO) ─────────
  @storyline("quizMachine4") {
    @trigger(map = "CinnabarGym", name = "quizMachine4")
    @if (getPlayerFacing() == "up") {
      @speaker("") { @t("#MON Quiz!\n\nGet it right and the door\nopens to the next room!\n\nGet it wrong and face a\ntrainer!\n\nIf you want to conserve\nyour #MON for the GYM\nLEADER...\n\nThen get it right! Here we\ngo!", "宝可梦问答！\n\n答对了，通往下一个房间的大\n门就会打开！\n\n答错了，就要面对训练家！\n\n如果想为挑战馆主保存宝可梦\n的实力……\n\n那就答对吧！开始！") }
      @speaker("") { @t("Are thunder moves effective\nagainst ground element-\ntype #MON?", "电系招式对地面系宝可梦有效\n吗？") }
      @choice {
        @option(@t("YES", "是")) {
          playSound("SFX_DENIED")
          @speaker("") { @t("Sorry! Bad call!", "抱歉，答错了！") }
          @if (!getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_4")) {
            result = startBattle("OPP_SUPER_NERD11")
            @if (result == "win") {
              setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_4")
              @speaker("") { @t("BLAINE was lost in the\nmountains when a fiery bird\nPOKeMON appeared.\n\nIts light enabled BLAINE to\nfind his way down!", "夏伯在山上迷了路，这时一只火\n鸟宝可梦出现了。\n\n它的光芒指引夏伯下了山！") }
            }
          }
        }
        @option(@t("NO", "否")) {
          playSound("SFX_GO_INSIDE")
          @speaker("") { @t("You're absolutely correct!\n\nGo on through!", "完全正确！\n\n请通过吧！") }
          setFlag("EVENT_CINNABAR_GYM_GATE3_UNLOCKED")
          replaceTileBlock(3, 8, 14)
        }
      }
    }
  }

  // ── Quiz machine 5 (tile 1,13 → gate 5 at block 2,6; answer YES) ────────
  @storyline("quizMachine5") {
    @trigger(map = "CinnabarGym", name = "quizMachine5")
    @if (getPlayerFacing() == "up") {
      @speaker("") { @t("#MON Quiz!\n\nGet it right and the door\nopens to the next room!\n\nGet it wrong and face a\ntrainer!\n\nIf you want to conserve\nyour #MON for the GYM\nLEADER...\n\nThen get it right! Here we\ngo!", "宝可梦问答！\n\n答对了，通往下一个房间的大\n门就会打开！\n\n答错了，就要面对训练家！\n\n如果想为挑战馆主保存宝可梦\n的实力……\n\n那就答对吧！开始！") }
      @speaker("") { @t("#MON of the same kind and\nlevel are not identical?", "同种类同等级的宝可梦并不完\n全相同？") }
      @choice {
        @option(@t("YES", "是")) {
          playSound("SFX_GO_INSIDE")
          @speaker("") { @t("You're absolutely correct!\n\nGo on through!", "完全正确！\n\n请通过吧！") }
          setFlag("EVENT_CINNABAR_GYM_GATE4_UNLOCKED")
          replaceTileBlock(2, 6, 14)
        }
        @option(@t("NO", "否")) {
          playSound("SFX_DENIED")
          @speaker("") { @t("Sorry! Bad call!", "抱歉，答错了！") }
          @if (!getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_5")) {
            result = startBattle("OPP_BURGLAR6")
            @if (result == "win") {
              setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_5")
              @speaker("") { @t("Us fire POKeMON fans like\nPONYTA and NINETALES!", "我们火系宝可梦迷喜欢小火马和\n九尾！") }
            }
          }
        }
      }
    }
  }

  // ── Quiz machine 6 (tile 1,7 → gate 6 at block 2,3; answer NO) ──────────
  @storyline("quizMachine6") {
    @trigger(map = "CinnabarGym", name = "quizMachine6")
    @if (getPlayerFacing() == "up") {
      @speaker("") { @t("#MON Quiz!\n\nGet it right and the door\nopens to the next room!\n\nGet it wrong and face a\ntrainer!\n\nIf you want to conserve\nyour #MON for the GYM\nLEADER...\n\nThen get it right! Here we\ngo!", "宝可梦问答！\n\n答对了，通往下一个房间的大\n门就会打开！\n\n答错了，就要面对训练家！\n\n如果想为挑战馆主保存宝可梦\n的实力……\n\n那就答对吧！开始！") }
      @speaker("") { @t("TM28 contains TOMBSTONER?", "TM28里装的是大坟墓？") }
      @choice {
        @option(@t("YES", "是")) {
          playSound("SFX_DENIED")
          @speaker("") { @t("Sorry! Bad call!", "抱歉，答错了！") }
          @if (!getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_6")) {
            result = startBattle("OPP_SUPER_NERD12")
            @if (result == "win") {
              setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_6")
              @speaker("") { @t("Water beats fire! But, fire\nmelts ice POKeMON!", "水能克火！但火能融化冰系宝可\n梦！") }
            }
          }
        }
        @option(@t("NO", "否")) {
          playSound("SFX_GO_INSIDE")
          @speaker("") { @t("You're absolutely correct!\n\nGo on through!", "完全正确！\n\n请通过吧！") }
          setFlag("EVENT_CINNABAR_GYM_GATE5_UNLOCKED")
          replaceTileBlock(2, 3, 14)
        }
      }
    }
  }

  // ── Trainer (npc 2) — Super Nerd, talk-driven battle ────────────────────
  @storyline("talkSuperNerd1") {
    @trigger(map = "CinnabarGym", npc = 2)
    @if (getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_0")) {
      @speaker("") {
        @t("Fire, or to be more precise,\ncombustion...\n\nBlah, blah, blah, blah...", "火，或者说更准确地说，燃\n烧……\n\n啰嗦，啰嗦，啰嗦……")
      }
    } @else {
      @speaker("") {
        @t("Do you know how hot POKeMON\nfire breath can get?", "你知道宝可梦的火焰温度有多高\n吗？")
      }
      result = startBattle("OPP_SUPER_NERD9")
      @if (result == "win") {
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_0")
        @speaker("") {
          @t("Fire, or to be more precise,\ncombustion...\n\nBlah, blah, blah, blah...", "火，或者说更准确地说，燃\n烧……\n\n啰嗦，啰嗦，啰嗦……")
        }
      }
    }
  }

  // ── Trainer (npc 3) — Burglar, talk-driven battle ───────────────────────
  @storyline("talkSuperNerd2") {
    @trigger(map = "CinnabarGym", npc = 3)
    @if (getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_1")) {
      @speaker("") {
        @t("I can't help stealing other\npeople's POKeMON!", "我忍不住想偷别人的宝可梦！")
      }
    } @else {
      @speaker("") {
        @t("I was a thief, but I became\nstraight as a trainer!", "我以前是小偷，但现在改邪归正\n了！")
      }
      result = startBattle("OPP_BURGLAR4")
      @if (result == "win") {
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_1")
        @speaker("") {
          @t("I can't help stealing other\npeople's POKeMON!", "我忍不住想偷别人的宝可梦！")
        }
      }
    }
  }

  // ── Trainer (npc 4) — Super Nerd, talk-driven battle ────────────────────
  @storyline("talkSuperNerd3") {
    @trigger(map = "CinnabarGym", npc = 4)
    @if (getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_2")) {
      @speaker("") {
        @t("My theories are too\ncomplicated for you!", "我的理论太复杂，你听不懂！")
      }
    } @else {
      @speaker("") {
        @t("You can't win! I have\nstudied POKeMON totally!", "你赢不了的！我已经把宝可梦研\n究透了！")
      }
      result = startBattle("OPP_SUPER_NERD10")
      @if (result == "win") {
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_2")
        @speaker("") {
          @t("My theories are too\ncomplicated for you!", "我的理论太复杂，你听不懂！")
        }
      }
    }
  }

  // ── Trainer (npc 5) — Burglar, talk-driven battle ───────────────────────
  @storyline("talkSuperNerd4") {
    @trigger(map = "CinnabarGym", npc = 5)
    @if (getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_3")) {
      @speaker("") {
        @t("I wish there was a thief\nPOKeMON! I'd use that!", "真希望有小偷宝可梦！我一定\n用！")
      }
    } @else {
      @speaker("") {
        @t("I just like using fire\nPOKeMON!", "我就是喜欢用火系宝可梦！")
      }
      result = startBattle("OPP_BURGLAR5")
      @if (result == "win") {
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_3")
        @speaker("") {
          @t("I wish there was a thief\nPOKeMON! I'd use that!", "真希望有小偷宝可梦！我一定\n用！")
        }
      }
    }
  }

  // ── Trainer (npc 6) — Super Nerd, talk-driven battle ────────────────────
  @storyline("talkSuperNerd5") {
    @trigger(map = "CinnabarGym", npc = 6)
    @if (getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_4")) {
      @speaker("") {
        @t("BLAINE was lost in the\nmountains when a fiery bird\nPOKeMON appeared.\n\nIts light enabled BLAINE to\nfind his way down!", "夏伯在山上迷了路，这时一只火\n鸟宝可梦出现了。\n\n它的光芒指引夏伯下了山！")
      }
    } @else {
      @speaker("") {
        @t("I know why BLAINE became a\ntrainer!", "我知道夏伯为何成为训练家！")
      }
      result = startBattle("OPP_SUPER_NERD11")
      @if (result == "win") {
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_4")
        @speaker("") {
          @t("BLAINE was lost in the\nmountains when a fiery bird\nPOKeMON appeared.\n\nIts light enabled BLAINE to\nfind his way down!", "夏伯在山上迷了路，这时一只火\n鸟宝可梦出现了。\n\n它的光芒指引夏伯下了山！")
        }
      }
    }
  }

  // ── Trainer (npc 7) — Burglar, talk-driven battle ───────────────────────
  @storyline("talkSuperNerd6") {
    @trigger(map = "CinnabarGym", npc = 7)
    @if (getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_5")) {
      @speaker("") {
        @t("Us fire POKeMON fans like\nPONYTA and NINETALES!", "我们火系宝可梦迷喜欢小火马和\n九尾！")
      }
    } @else {
      @speaker("") {
        @t("I've been to many GYMs, but\nthis is my favorite!", "我去过很多道馆，这里最棒！")
      }
      result = startBattle("OPP_BURGLAR6")
      @if (result == "win") {
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_5")
        @speaker("") {
          @t("Us fire POKeMON fans like\nPONYTA and NINETALES!", "我们火系宝可梦迷喜欢小火马和\n九尾！")
        }
      }
    }
  }

  // ── Trainer (npc 8) — Super Nerd, talk-driven battle ────────────────────
  @storyline("talkSuperNerd7") {
    @trigger(map = "CinnabarGym", npc = 8)
    @if (getFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_6")) {
      @speaker("") {
        @t("Water beats fire! But, fire\nmelts ice POKeMON!", "水能克火！但火能融化冰系宝可\n梦！")
      }
    } @else {
      @speaker("") {
        @t("Fire is weak against H2O!", "火怕水，就是H2O！")
      }
      result = startBattle("OPP_SUPER_NERD12")
      @if (result == "win") {
        setFlag("EVENT_BEAT_CINNABAR_GYM_TRAINER_6")
        @speaker("") {
          @t("Water beats fire! But, fire\nmelts ice POKeMON!", "水能克火！但火能融化冰系宝可\n梦！")
        }
      }
    }
  }

  // ── Gym guide (npc 9) ───────────────────────────────────────────────────
  @storyline("talkGymGuide") {
    @trigger(map = "CinnabarGym", npc = 9)
    @if (getFlag("EVENT_BEAT_BLAINE")) {
      @speaker("") {
        @t("<PLAYER>! You beat that fire\nbrand!", "<PLAYER>！你打败了那火霸王！")
      }
    } @else {
      @speaker("") {
        @t("Yo! Champ in making!\n\nThe hot-headed BLAINE is a\nfire POKeMON pro!\n\nDouse his spirits with\nwater!\n\nYou better take some BURN\nHEALs!", "哟！未来的冠军！\n\n急性子的夏伯是火系宝可梦专\n家！\n\n用水浇灭他的气焰！\n\n你最好带上些灼伤药！")
      }
    }
  }

  // ── Gym statue (sign 1 at 17,13) — badge-conditional ──
  @storyline("gymStatue1") {
    @trigger(map = "CinnabarGym", sign = 1)
    @if (getFlag("EVENT_BEAT_BLAINE")) {
      @speaker("") { @t("CINNABAR ISLAND\nPOKeMON GYM\nLEADER: BLAINE\n\nWINNING TRAINERS:\n<RIVAL>\n<PLAYER>", "红莲岛宝可梦道馆\n馆主：夏伯\n\n获胜训练家：\n劲敌\n玩家") }
    } @else {
      @speaker("") { @t("CINNABAR ISLAND\nPOKeMON GYM\nLEADER: BLAINE\n\nWINNING TRAINERS:\n<RIVAL>", "红莲岛宝可梦道馆\n馆主：夏伯\n\n获胜训练家：\n劲敌") }
    }
  }
}
