// Refactored from SaffronPokecenter/script.js to dotzuki-engine-dsl.
// Follows the CeladonPokecenter pattern (Pokecenter nurse dialog
// with @choice + @option). See docs/MIGRATION_NOTES.md §A.

game_scene SaffronPokecenter {
  @storyline("talkNurse") {
    @trigger(map = "SaffronPokecenter", npc = 1)
    @speaker("") {
      @t("Welcome to our POKeMON
CENTER!\n\nWe heal your POKeMON back to
perfect health!\n\nShall we heal your POKeMON?", "欢迎来到宝可梦中心！\n\n我们会让你的宝可梦恢复最佳状\n态！\n\n要为你治疗宝可梦吗？")
    }
    @choice {
      @option(@t("Yes", "是")) {
        @speaker("") {
          @t("OK. We'll need your
POKeMON.", "好的，请把宝可梦交给我。")
        }
        faceNpc("1", "left")
        delay(8)
        heal()
        animateHealingMachine()
        faceNpc("1", "down")
        delay(8)
        @speaker("") {
          @t("Thank you!
Your POKeMON are
fighting fit!", "谢谢你的等待。\n\n你的宝可梦已完全恢复了！")
        }
      }
      @option(@t("No", "否")) {
      }
    }
    @speaker("") {
      @t("We hope to see you again!", "期待你再次光临！")
    }
  }

  @storyline("talkBeauty") {
    @trigger(map = "SaffronPokecenter", npc = 2)
    @speaker("") { @t("POKEMON growth rates differ\nfrom specie to specie.", "宝可梦的成长速度因种类而异。") }
  }

  @storyline("talkGentleman") {
    @trigger(map = "SaffronPokecenter", npc = 3)
    @speaker("") { @t("SILPH CO. is very famous.\nThat's why it attracted TEAM\nROCKET!", "西尔佛公司非常有名，所以才会\n被火箭队盯上！") }
  }

  @storyline("talkLinkReceptionist") {
    @trigger(map = "SaffronPokecenter", npc = 4)
    @speaker("") { @t("Welcome to the CABLE CLUB!", "欢迎来到通信俱乐部！") }
  }

  // ── Pokémon Center PC (sign 1 at 13,3) ───────────────────────────────
  // engine/menus/pc.asm ActivatePC: BILL's PC / item PC / PROF.OAK's PC.
  @storyline("pcStorage") {
    @trigger(map = "SaffronPokecenter", sign = 1)
    openPC()
  }


  // ── Bench guy (sign 2 at (0,4)) — PrintBenchGuyText ────────────────────
  // data/events/bench_guys.asm + hidden_events.asm: A on the (0,4) bench
  // tile while facing it; BenchGuyTextPointers requires SPRITE_FACING_LEFT,
  // so gate on the player's facing (getPlayerFacing() -> down/up/left/right).
  @storyline("benchGuy") {
    @trigger(map = "SaffronPokecenter", sign = 2)
    @if (getPlayerFacing() == "left") {
      @if (getFlag("EVENT_BEAT_SILPH_CO_GIOVANNI")) {
        @speaker("") {
          @t("TEAM ROCKET took
off! We can go
out safely again!
That's great!", "火箭队逃走了！我们\n终于可以放心出门了！\n太好了！")
        }
      } @else {
        @speaker("") {
          @t("It would be great
if the ELITE FOUR
came and stomped
TEAM ROCKET!", "要是四天王能来\n把火箭队踩扁，\n那该多好啊！")
        }
      }
    }
  }
}
