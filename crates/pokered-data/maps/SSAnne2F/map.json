  "text": {
    "npc": {
      "1": [
        {
          "line1": "This ship, she is",
          "line2": "a luxury liner"
        },
        {
          "line1": "for trainers!",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "At every port, we",
          "line2": "hold parties with"
        },
        {
          "line1": "invited trainers!",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "[Rival battle",
          "line2": "script]"
        },
        {
          "line1": "<RIVAL>: Bonjour!",
          "line2": "<PLAYER>!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Imagine seeing",
          "line2": "you here!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "<PLAYER>, were you",
          "line2": "really invited?"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "So how's your",
          "line2": "#DEX coming?"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "I already caught",
          "line2": "40 kinds, pal!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Different kinds",
          "line2": "are everywhere!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Crawl around in",
          "line2": "grassy areas!"
        }
      ],
      "2_Defeated": [
        {
          "line1": "Humph!",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "At least you're",
          "line2": "raising your"
        },
        {
          "line1": "#MON!"
        }
      ],
      "2_Won": [
        {
          "line1": "<PLAYER>! What are",
          "line2": "you, seasick?"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "You should shape",
          "line2": "up, pal!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "<RIVAL>: I heard",
          "line2": "there was a CUT"
        },
        {
          "line1": "master on board.",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "But, he was just a",
          "line2": "seasick, old man!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "But, CUT itself is",
          "line2": "really useful!"
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "You should go see",
          "line2": "him! Smell ya!"
        }
      ]
    }
  },
