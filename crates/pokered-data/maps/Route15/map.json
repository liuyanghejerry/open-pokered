  "text": {
    "npc": {
      "1": [
        {
          "line1": "Let me try out the",
          "line2": "#MON I just"
        },
        {
          "line1": "got in a trade!",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "Not",
          "line2": "good enough!"
        }
      ],
      "1_AfterBattle": [
        {
          "line1": "You can't change",
          "line2": "the nickname of"
        },
        {
          "line1": "any #MON you",
          "line2": ""
        },
        {
          "line1": "get in a trade.",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Only the Original",
          "line2": "Trainer can."
        }
      ],
      "2": [
        {
          "line1": "You look gentle,",
          "line2": "so I think I can"
        },
        {
          "line1": "beat you!",
          "line2": ""
        }
      ],
      "2_Defeated": [
        {
          "line1": "No,",
          "line2": "wrong!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "I'm afraid of",
          "line2": "BIKERs, they look"
        },
        {
          "line1": "so ugly and mean!",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "When I whistle, I",
          "line2": "can summon bird"
        },
        {
          "line1": "#MON!",
          "line2": ""
        }
      ],
      "3_Defeated": [
        {
          "line1": "Ow!",
          "line2": "That's tragic!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "Maybe I'm not cut",
          "line2": "out for battles."
        }
      ],
      "4": [
        {
          "line1": "Hmm? My birds are",
          "line2": "shivering! You're"
        },
        {
          "line1": "good, aren't you?",
          "line2": ""
        }
      ],
      "4_Defeated": [
        {
          "line1": "Just",
          "line2": "as I thought!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "Did you know moves",
          "line2": "like EARTHQUAKE"
        },
        {
          "line1": "don't have any",
          "line2": ""
        },
        {
          "line1": "effect on birds?",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "Oh, you're a",
          "line2": "little cutie!"
        }
      ],
      "5_Defeated": [
        {
          "line1": "You looked",
          "line2": "so cute too!"
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "I forgive you!",
          "line2": "I can take it!"
        }
      ],
      "6": [
        {
          "line1": "I raise #MON",
          "line2": "because I live"
        },
        {
          "line1": "alone!",
          "line2": ""
        }
      ],
      "6_Defeated": [
        {
          "line1": "I didn't",
          "line2": "ask for this!"
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "I just like going",
          "line2": "home to be with"
        },
        {
          "line1": "my #MON!",
          "line2": ""
        }
      ],
      "7": [
        {
          "line1": "Hey kid! C'mon!",
          "line2": "I just got these!"
        }
      ],
      "7_Defeated": [
        {
          "line1": "Why",
          "line2": "not?"
        }
      ],
      "7_AfterBattle": [
        {
          "line1": "You only live",
          "line2": "once, so I live"
        },
        {
          "line1": "as an outlaw!",
          "line2": ""
        },
        {
          "line1": "TEAM ROCKET RULES!",
          "line2": ""
        }
      ],
      "8": [
        {
          "line1": "Fork over all your",
          "line2": "cash when you"
        },
        {
          "line1": "lose to me, kid!",
          "line2": ""
        }
      ],
      "8_Defeated": [
        {
          "line1": "That",
          "line2": "can't be true!"
        }
      ],
      "8_AfterBattle": [
        {
          "line1": "I was just joking",
          "line2": "about the money!"
        }
      ],
      "9": [
        {
          "line1": "What's cool?",
          "line2": "Trading #MON!"
        }
      ],
      "9_Defeated": [
        {
          "line1": "I",
          "line2": "said trade!"
        }
      ],
      "9_AfterBattle": [
        {
          "line1": "I trade #MON",
          "line2": "with my friends!"
        }
      ],
      "10": [
        {
          "line1": "Want to play with",
          "line2": "my #MON?"
        }
      ],
      "10_Defeated": [
        {
          "line1": "I was",
          "line2": "too impatient!"
        }
      ],
      "10_AfterBattle": [
        {
          "line1": "I'll go train with",
          "line2": "weaker people."
        }
      ]
    },
    "sign": {
      "1": [
