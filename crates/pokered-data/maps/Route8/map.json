  "text": {
    "npc": {
      "1": [
        {
          "line1": "You look good at",
          "line2": "#MON, but"
        },
        {
          "line1": "how's your chem?",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "Ow!",
          "line2": "Meltdown!"
        }
      ],
      "1_AfterBattle": [
        {
          "line1": "I am better at",
          "line2": "school than this!"
        }
      ],
      "2": [
        {
          "line1": "All right! Let's",
          "line2": "roll the dice!"
        }
      ],
      "2_Defeated": [
        {
          "line1": "Drat!",
          "line2": "Came up short!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "Lady Luck's not",
          "line2": "with me today!"
        }
      ],
      "3": [
        {
          "line1": "You need strategy",
          "line2": "to win at this!"
        }
      ],
      "3_Defeated": [
        {
          "line1": "It's",
          "line2": "not logical!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "Go with GRIMER",
          "line2": "first...and..."
        },
        {
          "line1": "...and...then...",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "I like NIDORAN, so",
          "line2": "I collect them!"
        }
      ],
      "4_Defeated": [
        {
          "line1": "Why? Why??",
          "line2": ""
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "When #MON grow",
          "line2": "up they get ugly!"
        },
        {
          "line1": "They shouldn't",
          "line2": "evolve!"
        }
      ],
      "5": [
        {
          "line1": "School is fun, but",
          "line2": "so are #MON."
        }
      ],
      "5_Defeated": [
        {
          "line1": "I'll",
          "line2": "stay with school."
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "We're stuck here",
          "line2": "because of the"
        },
        {
          "line1": "gates at SAFFRON.",
          "line2": ""
        }
      ],
      "6": [
        {
          "line1": "MEOWTH is so cute,",
          "line2": "meow, meow, meow!"
        }
      ],
      "6_Defeated": [
        {
          "line1": "Meow!",
          "line2": ""
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "I think PIDGEY",
          "line2": "and RATTATA"
        },
        {
          "line1": "are cute too!",
          "line2": ""
        }
      ],
      "7": [
        {
          "line1": "We must look",
          "line2": "silly standing"
        },
        {
          "line1": "here like this!",
          "line2": ""
        }
      ],
      "7_Defeated": [
        {
          "line1": "Look what",
          "line2": "you did!"
        }
      ],
      "7_AfterBattle": [
        {
          "line1": "SAFFRON's gate",
          "line2": "keeper won't let"
        },
        {
          "line1": "us through.",
          "line2": "He's so mean!"
        }
      ],
      "8": [
        {
          "line1": "I'm a rambling,",
          "line2": "gambling dude!"
        }
      ],
      "8_Defeated": [
        {
          "line1": "Missed",
          "line2": "the big score!"
        }
      ],
      "8_AfterBattle": [
        {
          "line1": "Gambling and",
          "line2": "#MON are like"
        },
        {
          "line1": "eating peanuts!",
          "line2": "Just can't stop!"
        }
      ],
      "9": [
        {
          "line1": "What's a cute,",
          "line2": "round and fluffy"
        },
        {
          "line1": "#MON?",
          "line2": ""
        }
      ],
      "9_Defeated": [
        {
          "line1": "Stop!",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "Don't be so mean",
          "line2": "to my CLEFAIRY!"
        }
      ],
      "9_AfterBattle": [
        {
          "line1": "I heard that",
          "line2": "CLEFAIRY evolves"
        },
        {
          "line1": "when it's exposed",
          "line2": "to a MOON STONE."
        }
      ]
    },
