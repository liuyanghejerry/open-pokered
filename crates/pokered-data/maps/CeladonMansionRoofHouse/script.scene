// CeladonMansionRoofHouse — translated from the original disassembly
// (scripts/CeladonMansionRoofHouse.asm, text/CeladonMansionRoofHouse.asm) to the
// real Game DSL API surface. A tiny 4x4 house with two NPCs: a Hiker who gives
// trade/link advice (dialogue only), and a Poké Ball that is the famous gift
// EEVEE (Lv 25). The original calls GivePokemon — success (party has room OR
// the current BOX has room: the mon goes to the BOX when the party is full)
// hides the ball object; only when both are full does it fail and the engine
// prints _BoxIsFullText without hiding anything.

game_scene CeladonMansionRoofHouse {
  // ── Hiker (npc 1) — dialogue only ───────────────────────────────────────
  @storyline("talkHiker") {
    @trigger(map = "CeladonMansionRoofHouse", npc = 1)
    @speaker("") {
      @t("I know everything about the\nworld of POKeMON in your\nGAME BOY!\n\nGet together with your\nfriends and trade POKeMON!", "我什么都懂关于这个宝可梦世界\n的游戏机的事！\n\n和朋友们聚在一起交换宝可梦\n吧！")
    }
  }

  // ── Gift EEVEE Poké Ball (npc 2) ────────────────────────────────────────
  // Original: GivePokemon EEVEE Lv 25 — true (added to party, or to the BOX
  // when the party is full) → HideObject via TOGGLE_CELADON_MANSION_EEVEE_GIFT;
  // false (BOX also full) → the engine prints _BoxIsFullText and the ball
  // stays. Contract: givePokemon returns true when the POKeMON was handed
  // over, false when party AND BOX are both full. (Until the engine lands the
  // return value it resolves undefined=falsy — an expected intermediate state.)
  @storyline("talkPokeBall") {
    @trigger(map = "CeladonMansionRoofHouse", npc = 2, toggle = "CELADON_MANSION_ROOF_HOUSE_OBJ_2")
    @if (!getFlag("EVENT_GOT_EEVEE")) {
      given = givePokemon("EEVEE", 25)
      @if (given) {
        hideObjectByName("CELADON_MANSION_ROOF_HOUSE_OBJ_2")
        setFlag("EVENT_GOT_EEVEE")
      } @else {
        @speaker("") { @t("The BOX is FULL!", "箱子满了！") }
      }
    }
  }
  // ── Blackboard (signs 2/3 at (3,0)/(4,0)) — LinkCableHelp ──────────────
  // engine/events/hidden_events/school_blackboard.asm::LinkCableHelp — the
  // heading menu loops until STOP READING; the DSL has no loop, so after each
  // info text the menu re-opens once (two reads max), then the flow ends.
  @storyline("linkCableHelp") {
    @trigger(map = "CeladonMansionRoofHouse", sign = 2)
    @trigger(map = "CeladonMansionRoofHouse", sign = 3)
    @speaker("") { @t("TRAINER TIPS\n\nUsing a Game Link\nCable", "训练家提示\n\n使用联机线缆") }
    @speaker("") { @t("Which heading do you\nwant to read?", "你想读哪个标题？") }
    @choice {
      @option(@t("HOW TO LINK", "如何联机")) {
        @speaker("") { @t("When you have linked your\nGAME BOY with another GAME\nBOY, talk to the attendant\non the right in any POKeMON\nCENTER.", "当你把 GAME BOY 与另一台 GAME\nBOY 连接后，到任意宝可梦中\n心与右侧的服务员对话。") }
        @speaker("") { @t("Which heading do you\nwant to read?", "你想读哪个标题？") }
        @choice {
          @option(@t("COLOSSEUM", "竞技场")) {
            @speaker("") { @t("COLOSSEUM lets you play\nagainst a friend.", "竞技场可以让你与朋友对战。") }
          }
          @option(@t("TRADE CENTER", "交换中心")) {
            @speaker("") { @t("TRADE CENTER is used for\ntrading POKeMON.", "交换中心用来交换宝可梦。") }
          }
          @option(@t("STOP READING", "停止阅读")) {
          }
        }
      }
      @option(@t("COLOSSEUM", "竞技场")) {
        @speaker("") { @t("COLOSSEUM lets you play\nagainst a friend.", "竞技场可以让你与朋友对战。") }
        @speaker("") { @t("Which heading do you\nwant to read?", "你想读哪个标题？") }
        @choice {
          @option(@t("HOW TO LINK", "如何联机")) {
            @speaker("") { @t("When you have linked your\nGAME BOY with another GAME\nBOY, talk to the attendant\non the right in any POKeMON\nCENTER.", "当你把 GAME BOY 与另一台 GAME\nBOY 连接后，到任意宝可梦中\n心与右侧的服务员对话。") }
          }
          @option(@t("TRADE CENTER", "交换中心")) {
            @speaker("") { @t("TRADE CENTER is used for\ntrading POKeMON.", "交换中心用来交换宝可梦。") }
          }
          @option(@t("STOP READING", "停止阅读")) {
          }
        }
      }
      @option(@t("TRADE CENTER", "交换中心")) {
        @speaker("") { @t("TRADE CENTER is used for\ntrading POKeMON.", "交换中心用来交换宝可梦。") }
        @speaker("") { @t("Which heading do you\nwant to read?", "你想读哪个标题？") }
        @choice {
          @option(@t("HOW TO LINK", "如何联机")) {
            @speaker("") { @t("When you have linked your\nGAME BOY with another GAME\nBOY, talk to the attendant\non the right in any POKeMON\nCENTER.", "当你把 GAME BOY 与另一台 GAME\nBOY 连接后，到任意宝可梦中\n心与右侧的服务员对话。") }
          }
          @option(@t("COLOSSEUM", "竞技场")) {
            @speaker("") { @t("COLOSSEUM lets you play\nagainst a friend.", "竞技场可以让你与朋友对战。") }
          }
          @option(@t("STOP READING", "停止阅读")) {
          }
        }
      }
      @option(@t("STOP READING", "停止阅读")) {
      }
    }
  }

  // ── TM notebook (sign 1 at (3,4)) — school_notebooks.asm::TMNotebook ────
  // Single-page pamphlet (text_waitbutton in the original).
  @storyline("tmNotebook") {
    @trigger(map = "CeladonMansionRoofHouse", sign = 1)
    @speaker("") { @t("It's a pamphlet\non TMs.\n\n...\n\nThere are 50 TMs\nin all.\n\nThere are also 5\nHMs that can be\nused repeatedly.\n\nSILPH CO.", "这是一本招式学习器手册。\n\n……\n\n招式学习器共有50种。\n\n另外还有5种可以反复使用的秘传学习器。\n\n西尔佛公司") }
  }

}
