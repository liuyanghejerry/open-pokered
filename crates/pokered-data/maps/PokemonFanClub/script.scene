// PokemonFanClub — translated from the original disassembly
// (scripts/PokemonFanClub.asm, text/PokemonFanClub.asm) to the real Game DSL
// API surface. NPC talk handlers only: two fans whose boast text toggles via
// EVENT_*_FAN_BOAST flags, two pet POKeMON that play their cry, the Chairman who
// gives the BIKE_VOUCHER after his story, a receptionist, and two signs.

game_scene PokemonFanClub {
  // ── Fisher / PIKACHU fan (npc 1) ────────────────────────────────────────
  // If PIKACHU_FAN_BOAST is set the SEEL fan already bragged, so this fan brags
  // back (BetterText) and clears the flag; otherwise normal text, and the SEEL
  // fan is primed to brag back (SEEL_FAN_BOAST).
  @storyline("talkPikachuFan") {
    @trigger(map = "PokemonFanClub", npc = 1)
    @if (getFlag("EVENT_PIKACHU_FAN_BOAST")) {
      @speaker("") {
        @t("Humph! My PIKACHU is twice\nas cute as that one!", "哼！我的皮卡丘比那只可爱两\n倍！")
      }
      resetFlag("EVENT_PIKACHU_FAN_BOAST")
    } @else {
      @speaker("") {
        @t("Won't you admire my\nPIKACHU's adorable tail?", "你不欣赏一下我的皮卡丘可爱的\n尾巴吗？")
      }
      setFlag("EVENT_SEEL_FAN_BOAST")
    }
  }

  // ── Girl / SEEL fan (npc 2) ─────────────────────────────────────────────
  @storyline("talkSeelFan") {
    @trigger(map = "PokemonFanClub", npc = 2)
    @if (getFlag("EVENT_SEEL_FAN_BOAST")) {
      @speaker("") {
        @t("Oh dear!\n\nMy SEEL is far more\nattractive!", "哎呀！\n\n我的小海狮可爱多了！")
      }
      resetFlag("EVENT_SEEL_FAN_BOAST")
    } @else {
      @speaker("") {
        @t("I just love my SEEL!\n\nIt squeals when I hug it!", "我就是爱我的小海狮！\n\n我一抱它它就吱吱叫！")
      }
      setFlag("EVENT_PIKACHU_FAN_BOAST")
    }
  }

  // ── Pet PIKACHU (npc 3) ─────────────────────────────────────────────────
  @storyline("talkPikachu") {
    @trigger(map = "PokemonFanClub", npc = 3)
    printFieldText(@t("PIKACHU: Chu! Pikachu!", "皮卡丘：啾！皮卡丘！"))
    playCry("PIKACHU")
    finishFieldText()
  }

  // ── Pet SEEL (npc 4) ────────────────────────────────────────────────────
  @storyline("talkSeel") {
    @trigger(map = "PokemonFanClub", npc = 4)
    printFieldText(@t("SEEL: Kyuoo!", "小海狮：啾呜！"))
    playCry("SEEL")
    finishFieldText()
  }

  // ── Chairman / Gentleman (npc 5) ────────────────────────────────────────
  // Original PokemonFanClub_CheckBikeInBag: skip to the "final" greeting if the
  // player already has the voucher, a BICYCLE, or the BIKE_VOUCHER in the bag.
  // Otherwise offer to tell the story; after the story GiveItem the
  // BIKE_VOUCHER — on failure (bag full) the original prints .BagFullText and
  // does NOT set EVENT_GOT_BIKE_VOUCHER.
  @storyline("talkChairman") {
    @trigger(map = "PokemonFanClub", npc = 5)
    @if (getFlag("EVENT_GOT_BIKE_VOUCHER") || hasItem("BICYCLE") || hasItem("BIKE_VOUCHER")) {
      printFieldText(@t("Hello, <PLAYER>!", "你好，<PLAYER>！"))
      printFieldParagraph(@t("Did you come see me about my\nPOKeMON again?", "你又是来看我聊宝可梦的吗？"))
      printFieldParagraph(@t("No? Too bad!", "不是？真遗憾！"))
      finishFieldText()
    } @else {
      // Original inner PrintText returns on DONE before YesNoChoice.
      printFieldText(@t("I chair the POKeMON Fan\nClub!", "我是宝可梦粉丝俱乐部的会长！"))
      printFieldParagraph(@t("I have collected over 100\nPOKeMON!", "我收集了 100多只宝可梦！"))
      printFieldParagraph(@t("I'm very fussy when it comes\nto POKeMON!", "我挑宝可梦非常讲究！"))
      printFieldParagraph(@t("So...", "那么……"))
      printFieldParagraph(@t("Did you come visit to hear\nabout my POKeMON?", "你是来听我讲宝可梦故事的吗？"))
      @choice {
        @option(@t("YES", "是")) {
          printFieldText(@t("Good! Then listen up!", "好！那你听好了！"))
          printFieldParagraph(@t("My favorite RAPIDASH...", "我最喜欢的烈焰马……"))
          printFieldParagraph(@t("It...cute...\nlovely...smart...\nplus...amazing... you think\nso?... oh yes...it...\nstunning... kindly... love\nit!", "它……可爱……伶俐……聪\n明……外加……惊人……你也这\n么觉得吧？……哦对……它……\n迷人……温柔……让人爱不释\n手！"))
          printFieldParagraph(@t("Hug it...when...\nsleeping...warm and\ncuddly... spectacular...\nravishing... ...Oops! Look\nat the time! I kept you too\nlong!", "抱着它……睡觉时……又暖又舒\n服……华丽……惊艳…………哎\n呀！看时间！我耽误你太久了！"))
          printFieldParagraph(@t("Thanks for hearing me out! I\nwant you to have this!", "谢谢你听我说完！我想把这个给\n你！"))
          waitFieldPrompt()
          // Original: GiveItem; on bag-full print BagFullText and keep the
          // voucher obtainable (no EVENT_GOT_BIKE_VOUCHER).
          given = giveItem("BIKE_VOUCHER", 1)
          @if (given) {
            printItemFieldText(@t("<PLAYER> received a BIKE\nVOUCHER!", "<PLAYER>得到了自行车兑换券！"), "SFX_GET_KEY_ITEM")
            printFieldParagraph(@t("Exchange that for a BICYCLE!", "用它去换自行车吧！"))
            printFieldParagraph(@t("Don't worry, my FEAROW will\nFLY me anywhere!", "别担心，我的大嘴雀会带我飞往任何地方！"))
            printFieldParagraph(@t("So, I don't need a BICYCLE!", "所以我不需要自行车！"))
            printFieldParagraph(@t("I hope you like cycling!", "希望你喜欢骑自行车！"))
            setFlag("EVENT_GOT_BIKE_VOUCHER")
            finishFieldText()
          } @else {
            printFieldText(@t("Make room for this!", "请给这个腾点地方！"))
            finishFieldText()
          }
        }
        @option(@t("NO", "否")) {
          printFieldText(@t("Oh. Come back when you want\nto hear my story!", "哦。想听我讲故事的时候再来\n吧！"))
          finishFieldText()
        }
      }
    }
  }

  // ── Receptionist / LinkReceptionist (npc 6) ─────────────────────────────
  @storyline("talkReceptionist") {
    @trigger(map = "PokemonFanClub", npc = 6)
    @speaker("") {
      @t("Our Chairman is very vocal\nabout POKeMON.", "我们的会长聊起宝可梦总是很起\n劲。")
    }
  }

  // ── Signs ───────────────────────────────────────────────────────────────
  @storyline("sign1") {
    @trigger(map = "PokemonFanClub", sign = 1)
    @speaker("") {
      @t("Let's all listen politely to\nother trainers!", "让我们都认真倾听其他训练家的\n话！")
    }
  }

  @storyline("sign2") {
    @trigger(map = "PokemonFanClub", sign = 2)
    @speaker("") {
      @t("If someone brags, brag right\nback!", "如果有人炫耀，就炫耀回去！")
    }
  }
}
