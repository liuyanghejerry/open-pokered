  "text": {
    "npc": {
      "1": [
        {
          "line1": "A sleeping #MON",
          "line2": "blocks the way!"
        }
      ],
      "1_WokeUp": [
        {
          "line1": "SNORLAX woke up!",
          "line2": ""
        },
        {
          "line1": "",
          "line2": ""
        },
        {
          "line1": "It attacked in a",
          "line2": "grumpy rage!"
        }
      ],
      "1_CalmedDown": [
        {
          "line1": "SNORLAX calmed",
          "line2": "down! With a big"
        },
        {
          "line1": "yawn, it returned",
          "line2": ""
        },
        {
          "line1": "to the mountains!",
          "line2": ""
        }
      ],
      "2": [
        {
          "line1": "Yeah! I got a",
          "line2": "bite, here!"
        }
      ],
      "2_Defeated": [
        {
          "line1": "Tch!",
          "line2": "Just a small fry!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "Hang on! My line's",
          "line2": "snagged!"
        }
      ],
      "3": [
        {
          "line1": "Be patient!",
          "line2": "Fishing is a"
        },
        {
          "line1": "waiting game!",
          "line2": ""
        }
      ],
      "3_Defeated": [
        {
          "line1": "That",
          "line2": "one got away!"
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "With a better ROD,",
          "line2": "I could catch"
        },
        {
          "line1": "better #MON!",
          "line2": ""
        }
      ],
      "4": [
        {
          "line1": "Have you found a",
          "line2": "MOON STONE?"
        }
      ],
      "4_Defeated": [
        {
          "line1": "Oww!",
          "line2": ""
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "I could have made",
          "line2": "my #MON evolve"
        },
        {
          "line1": "with MOON STONE!",
          "line2": ""
        }
      ],
      "5": [
        {
          "line1": "Electricity is my",
          "line2": "specialty!"
        }
      ],
      "5_Defeated": [
        {
          "line1": "Unplugged!",
          "line2": ""
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "Water conducts",
          "line2": "electricity, so"
        },
        {
          "line1": "you should zap",
          "line2": ""
        },
        {
          "line1": "sea #MON!",
          "line2": ""
        }
      ],
      "6": [
        {
          "line1": "The FISHING FOOL",
          "line2": "vs. #MON KID!"
        }
      ],
      "6_Defeated": [
        {
          "line1": "Too",
          "line2": "much!"
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "You beat me at",
          "line2": "#MON, but I'm"
        },
        {
          "line1": "good at fishing!",
          "line2": ""
        }
      ],
      "7": [
        {
          "line1": "I'd rather be",
          "line2": "working!"
        }
      ],
      "7_Defeated": [
        {
          "line1": "It's",
          "line2": "not easy..."
        }
      ],
      "7_AfterBattle": [
        {
          "line1": "It's all right.",
          "line2": "Losing doesn't"
        },
        {
          "line1": "bug me any more.",
          "line2": ""
        }
      ],
      "8": [
        {
          "line1": "You never know",
          "line2": "what you could"
        },
        {
          "line1": "catch!",
          "line2": ""
        }
      ],
      "8_Defeated": [
        {
          "line1": "Lost",
          "line2": "it!"
        }
      ],
      "8_AfterBattle": [
        {
          "line1": "I catch MAGIKARP",
          "line2": "all the time, but"
        },
        {
          "line1": "they're so weak!",
          "line2": ""
        }
      ]
    },
