  "text": {
    "npc": {
      "1": [
        {
          "line1": "Local trainers",
          "line2": "come here to"
        },
        {
          "line1": "practice!",
          "line2": ""
        }
      ],
      "1_Defeated": [
        {
          "line1": "You're",
          "line2": "decent."
        }
      ],
      "1_AfterBattle": [
        {
          "line1": "All #MON have",
          "line2": "weaknesses. It's"
        },
        {
          "line1": "best to raise",
          "line2": "different kinds."
        }
      ],
      "2": [
        {
          "line1": "Dad took me to a",
          "line2": "great party on"
        },
        {
          "line1": "S.S.ANNE at",
          "line2": "VERMILION CITY!"
        }
      ],
      "2_Defeated": [
        {
          "line1": "I'm",
          "line2": "not mad!"
        }
      ],
      "2_AfterBattle": [
        {
          "line1": "On S.S.ANNE, I",
          "line2": "saw trainers from"
        },
        {
          "line1": "around the world.",
          "line2": ""
        }
      ],
      "3": [
        {
          "line1": "I'm a cool guy.",
          "line2": "I've got a girl"
        },
        {
          "line1": "friend!",
          "line2": ""
        }
      ],
      "3_Defeated": [
        {
          "line1": "Aww,",
          "line2": "darn..."
        }
      ],
      "3_AfterBattle": [
        {
          "line1": "Oh well. My girl",
          "line2": "will cheer me up."
        }
      ],
      "4": [
        {
          "line1": "Hi! My boy",
          "line2": "friend is cool!"
        }
      ],
      "4_Defeated": [
        {
          "line1": "I was in",
          "line2": "bad condition!"
        }
      ],
      "4_AfterBattle": [
        {
          "line1": "I wish my guy was",
          "line2": "as good as you!"
        }
      ],
      "5": [
        {
          "line1": "I knew I had to",
          "line2": "fight you!"
        }
      ],
      "5_Defeated": [
        {
          "line1": "I knew",
          "line2": "I'd lose too!"
        }
      ],
      "5_AfterBattle": [
        {
          "line1": "If your #MON",
          "line2": "gets confused or"
        },
        {
          "line1": "falls asleep,",
          "line2": "switch it!"
        }
      ],
      "6": [
        {
          "line1": "My friend has a",
          "line2": "cute #MON."
        },
        {
          "line1": "I'm so jealous!",
          "line2": ""
        }
      ],
      "6_Defeated": [
        {
          "line1": "I'm",
          "line2": "not so jealous!"
        }
      ],
      "6_AfterBattle": [
        {
          "line1": "You came from MT.",
          "line2": "MOON? May I have"
        },
        {
          "line1": "a CLEFAIRY?",
          "line2": ""
        }
      ],
      "7": [
        {
          "line1": "I just got down",
          "line2": "from MT.MOON,"
        },
        {
          "line1": "but I'm ready!",
          "line2": ""
        }
      ],
      "7_Defeated": [
        {
          "line1": "You",
          "line2": "worked hard!"
        }
      ],
      "7_AfterBattle": [
        {
          "line1": "Drat!",
          "line2": "A ZUBAT bit me"
        },
        {
          "line1": "back in there.",
          "line2": ""
        }
      ],
      "8": [
        {
          "line1": "I'm off to see a",
          "line2": "#MON collector"
        },
        {
          "line1": "at the cape!",
          "line2": ""
        }
      ],
      "8_Defeated": [
        {
          "line1": "You",
          "line2": "got me."
        }
      ],
      "8_AfterBattle": [
        {
          "line1": "The collector has",
          "line2": "many rare kinds"
        },
        {
          "line1": "of #MON.",
          "line2": ""
        }
      ],
      "9": [
        {
          "line1": "You're going to",
          "line2": "see BILL? First,"
        },
        {
          "line1": "let's fight!",
          "line2": ""
        }
      ],
      "9_Defeated": [
        {
          "line1": "You're",
          "line2": "something."
        }
      ],
      "9_AfterBattle": [
        {
          "line1": "The trail below",
          "line2": "is a shortcut to"
        },
        {
          "line1": "CERULEAN CITY.",
          "line2": ""
        }
      ]
    },
    "sign": {
      "1": [
        {
          "line1": "SEA COTTAGE",
          "line2": "BILL lives here!"
        }
      ]
    }
