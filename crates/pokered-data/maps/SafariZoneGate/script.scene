// SafariZoneGate — translated from the original disassembly
// (scripts/SafariZoneGate.asm, text/SafariZoneGate.asm) to the real Game DSL.
//
// Safari ZONE timing and ball handling are built into the engine: warping into
// a safari map auto-arms the 500-step / 30-ball hunt, each throw decrements the
// ball count, and at 0 steps / 0 balls the engine PA-calls the player and
// bounces them back to the gate. The scene only reproduces the gate dialogue
// (join fee, leaving-early return) with real primitives; the remaining gap is a
// script-side query/control API for the hunt state (tracked in the completion
// plan).

game_scene SafariZoneGate {
  // ── Gate worker (npc 1): collects the fee, hands out SAFARI BALLs ────────
  @storyline("talkSafariZoneWorker1") {
    @trigger(map = "SafariZoneGate", npc = 1)
    @if (getFlag("EVENT_IN_SAFARI_ZONE")) {
      // Player is already inside the Safari Zone and walked back to the gate.
      @speaker("") { @t("Leaving early?", "要提前离开吗？") }
      @choice {
        @option(@t("YES", "是")) {
          @speaker("") {
            @t("Please return any SAFARI\nBALLs you have left.", "请把剩下的狩猎球还给我。")
          }
          // Approximation: hand back the remaining SAFARI BALLs and end the hunt.
          // The engine-side safari_balls counter decrements per throw and is not
          // refunded on early exit (matches the original).
          takeItem("SAFARI_BALL", 30)
          resetFlag("EVENT_SAFARI_GAME_OVER")
          resetFlag("EVENT_IN_SAFARI_ZONE")
        }
        @option(@t("NO", "否")) {
          @speaker("") { @t("Good Luck!", "祝你好运！") }
          // Keep hunting — send the player back into the zone.
          warpTo("SafariZoneCenter", 14, 25)
        }
      }
    } @else {
      // At the entrance — pitch the hunt.
      @speaker("") {
        @t("For just ¥500, you can catch\nall the POKeMON you want in\nthe park!\n\nWould you like to join the\nhunt?", "只需500日元，你就能在公园里\n抓到所有想要的宝可梦！\n\n要加入狩猎吗？")
      }
      @choice {
        @option(@t("YES", "是")) {
          @if (hasMoney(500)) {
            takeMoney(500)
            @speaker("") {
              @t("That'll be ¥500 please!\n\nWe only use a special POKe\nBALL here.\n\n<PLAYER> received 30 SAFARI\nBALLs!", "请交 500日元！\n\n我们这里只使用特制的精灵球。\n\n<PLAYER>获得了 30个狩猎球！")
            }
            // The engine auto-sets the 500-step / 30-ball Safari timer on warp
            // into the zone; the 30 bag SAFARI BALLs are what this scene grants.
            giveItem("SAFARI_BALL", 30)
            @speaker("") {
              @t("We'll call you on the PA\nwhen you run out of time or\nSAFARI BALLs!", "当你时间用完或狩猎球用完时，\n我们会用广播呼叫你！")
            }
            setFlag("EVENT_IN_SAFARI_ZONE")
            resetFlag("EVENT_SAFARI_GAME_OVER")
            // The original auto-walks the player up through the gate; warp in.
            warpTo("SafariZoneCenter", 14, 25)
          } @else {
            @speaker("") {
              @t("Oops! Not enough money!", "哎呀！钱不够！")
            }
          }
        }
        @option(@t("NO", "否")) {
          @speaker("") {
            @t("OK! Please come again!", "OK！欢迎再次光临！")
          }
        }
      }
    }
  }

  // ── Info worker (npc 2): explains the Safari Zone ────────────────────────
  @storyline("talkSafariZoneWorker2") {
    @trigger(map = "SafariZoneGate", npc = 2)
    @speaker("") {
      @t("Hi! Is it your first time\nhere?", "嗨！你是第一次来吗？")
    }
    @choice {
      @option("YES") {
        @speaker("") {
          @t("SAFARI ZONE has 4 zones in\nit.\n\nEach zone has different\nkinds of POKeMON. Use SAFARI\nBALLs to catch them!\n\nWhen you run out of time or\nSAFARI BALLs, it's game over\nfor you!\n\nBefore you go, open an\nunused POKeMON BOX so\nthere's room for new\nPOKeMON!", "狩猎地带里有 4个区域。\n\n每个区域有不同种类的宝可梦。\n使用狩猎球来捕捉它们！\n\n当你用完时间或狩猎球时，游戏\n就结束了！\n\n出发之前，打开一个空闲的宝可\n梦箱腾出空间给新的宝可梦！")
        }
      }
      @option("NO") {
        @speaker("") {
          @t("Sorry, you're a regular\nhere!", "抱歉，你是这里的常客了！")
        }
      }
    }
  }
}
