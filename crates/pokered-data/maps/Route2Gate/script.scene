// Route2Gate — translated from the original disassembly
// (scripts/Route2Gate.asm, text/Route2Gate.asm + Route2Gate_2.asm,
// engine/events/oaks_aide.asm). An Oak's Aide (Scientist) gives HM05 FLASH
// once the player has caught 10 kinds of POKeMON, then prints the Flash
// explanation; a Youngster gives a ROCK TUNNEL hint.

game_scene Route2Gate {
  // ── Oak's Aide / Scientist (npc 1) — gives HM05 FLASH at 10 kinds owned ───
  // requirement = 10, reward = HM_FLASH (HM05), completion flag = EVENT_GOT_HM05.
  // Report the actual owned count, as hOaksAideNumMonsOwned does.
  // In the original, the FlashExplanationText prints after the OaksAideScript
  // runs, whether the item was just given or already held.
  @storyline("talkOaksAide") {
    @trigger(map = "Route2Gate", npc = 1)
    @if (getFlag("EVENT_GOT_HM05")) {
      // Already received it: the aide just prints the FLASH explanation.
      printFieldText(t("The HM FLASH lights even the\ndarkest dungeons.", "秘传招式闪光能照亮最黑暗的洞\n窟。"))
    } @else {
      // OaksAideHiText (requirement = 10 kinds, reward = HM05 FLASH)
      printFieldText(t("Hi! Remember me? I'm\nPROF.OAK's AIDE!", "嗨！还记得我吗？我是大木博士\n的助手！"))
      printFieldParagraph(t("If you caught 10 kinds of\nPOKeMON, I'm supposed to\ngive you an HM05!", "如果你抓到了 10种宝可梦，我\n就可以把HM05给你！"))
      printFieldParagraph(t("So, <PLAYER>! Have you\ncaught at least 10 kinds of\nPOKeMON?", "那么，<PLAYER>！你抓到至少\n10种宝可梦了吗？"))
      @choice {
        @option(@t("YES", "是")) {
          @if (getPokedexOwnedCount() >= 10) {
            // OaksAideHereYouGoText -> give item -> OaksAideGotItemText
            printFieldText(t("Great! You have caught ", "太好了！你已经抓到了") + getPokedexOwnedCount() + t(" kinds of POKeMON!\nCongratulations!", "种宝可梦！\n恭喜你！"))
            printFieldParagraph(t("Here you go!", "给你！"))
            waitFieldPrompt()
            given = giveItem("HM05", 1)
            @if (given) {
              printItemFieldText(@t("<PLAYER> got HM05!", "<PLAYER>得到了HM05！"), "SFX_GET_ITEM_1")
              setFlag("EVENT_GOT_HM05")
              // FlashExplanationText follows once the item is received.
              printFieldText(t("The HM FLASH lights even the\ndarkest dungeons.", "秘传招式闪光能照亮最黑暗的洞\n窟。"))
            } @else {
              printFieldText(t("Oh! I see you don't have any\nroom for the HM05.", "哎呀！你身上已经没有放HM05的\n空位了。"))
            }
          } @else {
            // OaksAideUhOhText (not enough kinds owned)
            printFieldText(t("Let's see... Uh-oh! You have\ncaught only ", "让我看看……哎呀！你只抓到了") + getPokedexOwnedCount() + t(" kinds of\nPOKeMON!", "种宝可梦！"))
            printFieldParagraph(t("You need 10 kinds if you\nwant the HM05.", "要得到HM05，需要抓到10种。"))
          }
        }
        @option(@t("NO", "否")) {
          // OaksAideComeBackText
          printFieldText(t("Oh. I see.", "哦，是这样。"))
          printFieldParagraph(t("When you get 10 kinds, come\nback for the HM05.", "等你抓到 10种宝可梦，再来拿\nHM05吧。"))
        }
      }
    }
    finishFieldText()
  }

  // ── Youngster (npc 2) — ROCK TUNNEL hint ─────────────────────────────────
  @storyline("talkYoungster") {
    @trigger(map = "Route2Gate", npc = 2)
    @speaker("") {
      @t("Once a POKeMON learns FLASH,\nyou can get through ROCK\nTUNNEL.", "宝可梦学会闪光后，就能穿过岩\n山隧道了。")
    }
  }
}
