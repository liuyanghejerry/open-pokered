screen Options {
  panel {
    rect = {tx: 0, ty: 0, tw: 20, th: 5}
    style = "default"
  }
  text(@t("TEXT SPEED", "文字速度")) {
    rect = {tx: 1, ty: 1, tw: 16, th: 1}
  }
  text(" FAST  MEDIUM SLOW") {
    rect = {tx: 1, ty: 3, tw: 18, th: 1}
    visible = "{is_en}"
  }
  text("快") {
    rect = {tx: 2, ty: 3, tw: 4, th: 1}
    visible = "{is_zh}"
  }
  text("中") {
    rect = {tx: 5, ty: 3, tw: 4, th: 1}
    visible = "{is_zh}"
  }
  text("慢") {
    rect = {tx: 8, ty: 3, tw: 4, th: 1}
    visible = "{is_zh}"
  }
  panel {
    rect = {tx: 0, ty: 5, tw: 20, th: 5}
    style = "default"
  }
  text(@t("BATTLE ANIMATION", "战斗动画")) {
    rect = {tx: 1, ty: 6, tw: 16, th: 1}
  }
  text(" ON       OFF") {
    rect = {tx: 1, ty: 8, tw: 18, th: 1}
    visible = "{is_en}"
  }
  text("开") {
    rect = {tx: 2, ty: 8, tw: 4, th: 1}
    visible = "{is_zh}"
  }
  text("关") {
    rect = {tx: 10, ty: 8, tw: 4, th: 1}
    visible = "{is_zh}"
  }
  panel {
    rect = {tx: 0, ty: 10, tw: 20, th: 5}
    style = "default"
  }
  text(@t("BATTLE STYLE", "战斗模式")) {
    rect = {tx: 1, ty: 11, tw: 16, th: 1}
  }
  text(" SHIFT    SET") {
    rect = {tx: 1, ty: 13, tw: 18, th: 1}
    visible = "{is_en}"
  }
  text("替换") {
    rect = {tx: 2, ty: 13, tw: 4, th: 1}
    visible = "{is_zh}"
  }
  text("固定") {
    rect = {tx: 8, ty: 13, tw: 4, th: 1}
    visible = "{is_zh}"
  }
  text(@t("CANCEL", "取消")) {
    rect = {tx: 2, ty: 16, tw: 8, th: 1}
  }
  // The authored layout owns both label and cursor geometry. The adapter only
  // selects a semantic state; build-time lowering removes inactive branches.
  cursor { rect = {tx: 1, ty: 3, tw: 1, th: 1} glyph = "▶" visible = "{text_fast_en}" }
  cursor { rect = {tx: 7, ty: 3, tw: 1, th: 1} glyph = "▶" visible = "{text_medium_en}" }
  cursor { rect = {tx: 14, ty: 3, tw: 1, th: 1} glyph = "▶" visible = "{text_slow_en}" }
  cursor { rect = {tx: 1, ty: 3, tw: 1, th: 1} glyph = "▶" visible = "{text_fast_zh}" }
  cursor { rect = {tx: 4, ty: 3, tw: 1, th: 1} glyph = "▶" visible = "{text_medium_zh}" }
  cursor { rect = {tx: 7, ty: 3, tw: 1, th: 1} glyph = "▶" visible = "{text_slow_zh}" }
  cursor { rect = {tx: 1, ty: 8, tw: 1, th: 1} glyph = "▶" visible = "{animation_on_en}" }
  cursor { rect = {tx: 10, ty: 8, tw: 1, th: 1} glyph = "▶" visible = "{animation_off_en}" }
  cursor { rect = {tx: 1, ty: 8, tw: 1, th: 1} glyph = "▶" visible = "{animation_on_zh}" }
  cursor { rect = {tx: 9, ty: 8, tw: 1, th: 1} glyph = "▶" visible = "{animation_off_zh}" }
  cursor { rect = {tx: 1, ty: 13, tw: 1, th: 1} glyph = "▶" visible = "{style_shift_en}" }
  cursor { rect = {tx: 10, ty: 13, tw: 1, th: 1} glyph = "▶" visible = "{style_set_en}" }
  cursor { rect = {tx: 1, ty: 13, tw: 1, th: 1} glyph = "▶" visible = "{style_shift_zh}" }
  cursor { rect = {tx: 7, ty: 13, tw: 1, th: 1} glyph = "▶" visible = "{style_set_zh}" }
  cursor { rect = {tx: 1, ty: 16, tw: 1, th: 1} glyph = "▶" visible = "{cancel_active}" }
}
