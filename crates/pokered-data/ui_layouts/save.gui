screen Save {
  panel {
    rect = {tx: 1, ty: 0, tw: 12, th: 10}
    style = "default"
  }
  text(@t("PLAYER", "玩家")) {
    rect = {tx: 2, ty: 2, tw: 7, th: 1}
  }
  text("{player_name}") {
    rect = {tx: 6, ty: 2, tw: 5, th: 1}
  }
  text(@t("BADGES", "徽章")) {
    rect = {tx: 2, ty: 4, tw: 7, th: 1}
  }
  text("{badges}") {
    rect = {tx: 10, ty: 4, tw: 2, th: 1}
    align = "right"
  }
  text(@t("№DEX", "图鉴")) {
    rect = {tx: 2, ty: 6, tw: 5, th: 1}
  }
  text("{seen_count}") {
    rect = {tx: 9, ty: 6, tw: 3, th: 1}
    align = "right"
  }
  text(@t("TIME", "时间")) {
    rect = {tx: 2, ty: 8, tw: 5, th: 1}
  }
  text("{play_time}") {
    rect = {tx: 5, ty: 8, tw: 5, th: 1}
  }
  panel {
    rect = {tx: 0, ty: 11, tw: 20, th: 6}
    style = "default"
  }
  text(@t("Would you like to", "是否要")) {
    rect = {tx: 1, ty: 12, tw: 18, th: 1}
  }
  text(@t("SAVE the game?", "保存游戏？")) {
    rect = {tx: 1, ty: 14, tw: 18, th: 1}
  }
  // YES/NO sits right of the info panel (columns 1..=12) without overlap;
  // the prompt box below starts on row 11.
  panel {
    rect = {tx: 13, ty: 7, tw: 6, th: 4}
    style = "default"
  }
  text(@t("YES", "是")) {
    rect = {tx: 15, ty: 8, tw: 3, th: 1}
  }
  text(@t("NO", "否")) {
    rect = {tx: 15, ty: 9, tw: 3, th: 1}
  }
  tile(223) {
    rect = {tx: 14, ty: 8, tw: 1, th: 1}
  }
}
