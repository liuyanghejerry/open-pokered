screen Save {
  // A shared information card and confirmation area for every save phase.
  panel {
    rect = {tx: 0, ty: 0, tw: 20, th: 11}
    style = "default"
  }
  text(@t("PLAYER", "玩家")) {
    rect = {tx: 2, ty: 2, tw: 7, th: 2}
  }
  text("{player_name}") {
    rect = {tx: 10, ty: 2, tw: 8, th: 2}
    align = "right"
  }
  text(@t("BADGES", "徽章")) {
    rect = {tx: 2, ty: 4, tw: 7, th: 2}
  }
  text("{badges}") {
    rect = {tx: 10, ty: 4, tw: 8, th: 2}
    align = "right"
  }
  text(@t("#DEX", "图鉴")) {
    rect = {tx: 2, ty: 6, tw: 7, th: 2}
  }
  text("{owned_count}") {
    rect = {tx: 10, ty: 6, tw: 8, th: 2}
    align = "right"
  }
  text(@t("TIME", "时间")) {
    rect = {tx: 2, ty: 8, tw: 7, th: 2}
  }
  text("{play_time}") {
    rect = {tx: 10, ty: 8, tw: 8, th: 2}
    align = "right"
  }
  panel {
    rect = {tx: 0, ty: 12, tw: 20, th: 6}
    style = "default"
  }
  text("{message_line_1}") {
    rect = {tx: 2, ty: 13, tw: 12, th: 2}
    visible = "{asking}"
  }
  text("{message_line_2}") {
    rect = {tx: 2, ty: 15, tw: 12, th: 2}
    visible = "{asking}"
  }
  text("{message_line_1}") {
    rect = {tx: 2, ty: 13, tw: 16, th: 2}
    visible = "{show_status}"
  }
  text("{message_line_2}") {
    rect = {tx: 2, ty: 15, tw: 16, th: 2}
    visible = "{show_status}"
  }
  text(@t("YES", "是")) {
    rect = {tx: 16, ty: 13, tw: 3, th: 2}
    visible = "{asking}"
  }
  text(@t("NO", "否")) {
    rect = {tx: 16, ty: 15, tw: 3, th: 2}
    visible = "{asking}"
  }
  cursor {
    rect = {tx: 14, ty: "{cursor_ty}", tw: 1, th: 1}
    glyph = "▶"
    visible = "{asking}"
  }
}
