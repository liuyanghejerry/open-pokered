screen MartBuy {
  // Interlocked with the money strip like the original: LIST_MENU_BOX
  // starts where MONEY_BOX (top-right) ends.
  panel {
    rect = {tx: 0, ty: 2, tw: 18, th: 12}
    style = "default"
  }
  flex_list("{shop_items}") {
    rect = {tx: 1, ty: 3, tw: 16, th: 10}
    item_layout = [{field: "name", width: 13, align: "left"}, {field: "price", width: 3, align: "right", prefix: "$"}]
    padding = {top: 0, left: 1}
    gap = 1
    cursor = {tile: 223, position: "left"}
  }
  panel {
    rect = {tx: 10, ty: 0, tw: 10, th: 3}
    style = "default"
  }
  text(@t("MONEY ${balance}", "金钱 ${balance}")) {
    rect = {tx: 11, ty: 1, tw: 8, th: 1}
  }
}
