screen Naming {
  text("{prompt_text}") {
    rect = {tx: 1, ty: 1, tw: 12, th: 1}
  }
  text("{entered_name}") {
    rect = {tx: 9, ty: 3, tw: 10, th: 1}
  }
  panel {
    rect = {tx: 0, ty: 5, tw: 20, th: 13}
    style = "default"
  }
  text("A B C D E F G H I") {
    rect = {tx: 2, ty: 7, tw: 17, th: 1}
  }
  text("J K L M N O P Q R") {
    rect = {tx: 2, ty: 9, tw: 17, th: 1}
  }
  text("S T U V W X Y Z") {
    rect = {tx: 2, ty: 11, tw: 17, th: 1}
  }
  text("* ( ) : ; [ ] - ?") {
    rect = {tx: 2, ty: 13, tw: 17, th: 1}
  }
  text(@t("lower case", "小写")) {
    rect = {tx: 2, ty: 15, tw: 12, th: 1}
  }
  text(@t("END", "结束")) {
    rect = {tx: 14, ty: 15, tw: 4, th: 1}
  }
  tile(223) {
    rect = {tx: 1, ty: 7, tw: 1, th: 1}
  }
}
