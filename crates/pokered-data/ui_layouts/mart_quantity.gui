screen MartQuantity {
  panel {
    rect = {tx: 0, ty: 3, tw: 20, th: 6}
    style = "default"
  }
  text("{item_name}") {
    rect = {tx: 2, ty: 5, tw: 16, th: 1}
  }
  text("×{quantity}") {
    rect = {tx: 2, ty: 7, tw: 6, th: 1}
  }
  text("${total_cost}") {
    rect = {tx: 11, ty: 7, tw: 7, th: 1}
  }
  panel {
    rect = {tx: 6, ty: 0, tw: 14, th: 3}
    style = "default"
  }
  text(@t("MONEY ${balance}", "金钱 ${balance}")) {
    rect = {tx: 7, ty: 1, tw: 12, th: 1}
  }
}
